root = true

# Spaces everywhere; tabs only where a tool requires them.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{sh,awk}]
indent_size = 4

# Two trailing spaces are a hard line break in Markdown.
[*.md]
trim_trailing_whitespace = false

# make requires a literal tab before every recipe line.
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab
