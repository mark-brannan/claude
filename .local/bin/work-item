#!/bin/sh
# work-item -- the work-item store: one file per item, a brief plus a log,
# the id its filename (dotfiles#510).
#
#   work-item create [--id <id>] [--owner <o>] [--repo <r>] [--parent <id>]
#                    [--model <m>] [--effort <e>] [--points <n>]
#                    [--brief <text>|-] <title>    print the new item's id
#   work-item brief <id> [--points <n>] <text>|-   replace the brief, log `briefed`
#   work-item log <id> <word>...                   append one log line
#   work-item claim <id>                           take it: `status=claimed`
#   work-item release <id>                         hand it back: `status=ready`
#   work-item show <id>                            print the file
#   work-item fold <id>                            print its folded state
#
# The format, ruled in pen (one-entry-point curia, 2026-10-01/02):
#
#   # <title>
#
#   ## Brief
#   points: 3
#   <the brief>
#
#   ## Log
#   2026-10-01T23:20:15Z 86eba7f7 status=open owner=agent repo=- parent=- model=sonnet effort=medium
#   2026-10-02T08:30:11Z 9a1b2c3d cost tokens=812340 usd=1.42 by=grind
#
# The id is epoch seconds then the session's eight hex, opaque; the file is
# the lookup. An item is created in `open`, always. Six statuses: open, ready,
# claimed, blocked, done, closed; the transitions are `allowed` below. A claim
# is valid when the folded status is ready or closed and no other session
# holds it. A GitHub-homed item carries `home=`, with no link back.
#
# Pencil (dotfiles#510's defaults): a flat folder; a holder that wrote nothing
# on the item for WORK_ITEM_STALE_SECS (2h) has let go; and this is a GATE --
# a write that cannot land, or is refused, exits non-zero (1 refused, 2 usage).
# Writes are plain files in the state repo; the Stop hook commits and pushes.
set -u

self=$0
case $self in */*) ;; *) self=$(command -v "$self" 2>/dev/null || printf '%s' "$self") ;; esac
self_dir=$(cd "$(dirname "$self")" 2>/dev/null && pwd)
lib=""
for c in "$self_dir/../../.claude/hooks/lib-state.sh" "$HOME/.claude/hooks/lib-state.sh"; do
  [ -f "$c" ] && { lib=$c; break; }
done
[ -n "$lib" ] || { printf 'work-item: lib-state.sh not found\n' >&2; exit 2; }
# shellcheck disable=SC1090
. "$lib"

ITEMS=${WORK_ITEM_DIR:-$(state_dir)/items}
STALE=${WORK_ITEM_STALE_SECS:-7200}
nl='
'

die()    { printf 'work-item: %s\n' "$*" >&2; exit 2; }
refuse() { printf 'work-item: %s\n' "$*" >&2; exit 1; }

now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }
iso_of()  { date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ; }

me() {
  hex=$(printf '%s' "${CLAUDE_CODE_SESSION_ID:-}" | tr -d '-' | cut -c1-8 | tr 'A-F' 'a-f')
  case $hex in ????????) ;; *) die "no session id (run inside a session)" ;; esac
  case $hex in *[!0-9a-f]*) die "session id ${CLAUDE_CODE_SESSION_ID} does not start with eight hex" ;; esac
  printf '%s' "$hex"
}

# A log value is one word: the line is split on spaces.
word() {
  case $2 in ''|*' '*|*'	'*) die "$1 must be one word, got [$2]" ;; esac
  case $2 in *"$nl"*) die "$1 must be one line" ;; esac
}
points_ok() { case $1 in 1|2|3|5|8|13) ;; *) die "points is one of 1 2 3 5 8 13, got [$1]" ;; esac; }
statuses=" open ready claimed blocked done closed "
allowed() {  # <from> <to>: the pen transitions; every self-transition is allowed
  [ "$1" = "$2" ] && return 0
  case "$1>$2" in
    'open>ready'|'ready>claimed'|'claimed>blocked'|'claimed>ready'|'claimed>done'|\
    'blocked>claimed'|'blocked>ready'|'done>claimed'|'done>ready'|'done>closed'|\
    'closed>claimed') return 0 ;;
  esac
  return 1
}

file_of() {
  is_card_id "${1:-}" || die "not an item id: ${1:-<id>}"
  f="$ITEMS/$1.md"
}
need() { file_of "$1"; [ -f "$f" ] || refuse "no item $1 in $ITEMS"; }

lock() {
  state_lock_wait "${TMPDIR:-/tmp}/work-item.$1.lock.d" 10 || refuse "item $1 is locked by another writer"
  trap 'state_unlock' EXIT
  trap 'state_unlock; exit 1' HUP INT TERM
}

fold_item() { work_item_fold "$f" "$(iso_of "$(( $(date -u +%s) - STALE ))")"; }
fact() { printf '%s\n' "$folded" | sed -n "s/^$1=//p"; }

append() {  # <words>: one line from this session, or fail loudly
  printf '%s %s %s\n' "$(now_iso)" "$sid" "$1" >> "$f" || refuse "could not write $f"
}

# Check a status move against the transitions and the holder, under the lock.
move() {
  to=$1
  case $statuses in *" $to "*) ;; *) die "unknown status $to (one of$statuses)" ;; esac
  folded=$(fold_item) || refuse "could not read $f"
  from=$(fact status); holder=$(fact holder)
  live=""; [ -n "$holder" ] && [ "$(fact holder_stale)" = no ] && live=$holder
  if [ -n "$live" ] && [ "$live" != "$sid" ]; then
    refuse "$id is held by $live since $(fact held_since) (last wrote $(fact holder_last))"
  fi
  if [ "$to" = claimed ] && [ -n "$holder" ] && [ -z "$live" ]; then
    return 0  # a stale holder has let go: the item reads as handed back
  fi
  allowed "$from" "$to" || refuse "$id: $from -> $to is not a transition"
}

write_brief() {  # rewrite the Brief section of $f from $brief and $points
  tmp="$f.tmp.$$"
  { awk '/^## Brief[ \t]*$/ { exit } { print }' "$f"
    printf '## Brief\n'
    [ -n "$points" ] && printf 'points: %s\n' "$points"
    [ -n "$brief" ] && printf '%s\n' "$brief"
    printf '\n'
    awk 'p { print } /^## Log[ \t]*$/ { p = 1; print }' "$f"
  } > "$tmp" && [ -s "$tmp" ] && mv "$tmp" "$f" || { rm -f "$tmp"; refuse "could not write $f"; }
}

read_brief() {  # sets $brief; a `## ` line would end the brief early on the next read
  if [ "$1" = - ]; then brief=$(cat); else brief=$1; fi
  if printf '%s\n' "$brief" | grep -q '^## '; then die "a brief line may not start with '## '"; fi
}

cmd=${1:-}; [ $# -gt 0 ] && shift
case $cmd in
  create)
    id="" owner=agent repo=- parent=- model=- effort=- points="" brief="" has_brief=""
    while [ $# -gt 0 ]; do
      case $1 in
        --id) id=${2:-}; shift 2 ;;
        --owner) owner=${2:-}; shift 2 ;;
        --repo) repo=${2:-}; shift 2 ;;
        --parent) parent=${2:-}; shift 2 ;;
        --model) model=${2:-}; shift 2 ;;
        --effort) effort=${2:-}; shift 2 ;;
        --points) points=${2:-}; shift 2 ;;
        --brief) read_brief "${2:-}"; has_brief=1; shift 2 ;;
        --) shift; break ;;
        -*) die "unknown option $1" ;;
        *) break ;;
      esac
    done
    [ $# -eq 1 ] || die "create takes one title (quote it)"
    title=$1
    case $title in ''|*"$nl"*) die "the title is one non-empty line" ;; esac
    case $owner in agent|human-ruling|human-click) ;; *) die "owner is agent, human-ruling or human-click, got [$owner]" ;; esac
    for v in "repo:$repo" "parent:$parent" "model:$model" "effort:$effort"; do word "${v%%:*}" "${v#*:}"; done
    [ "$parent" = - ] || is_card_id "$parent" || die "parent is an item id, got [$parent]"
    [ -z "$points" ] || points_ok "$points"
    sid=$(me) || exit $?
    [ -n "$id" ] || id=$(printf '%s%s' "$(date -u +%s)" "$sid")
    file_of "$id"
    mkdir -p "$ITEMS" || refuse "could not create $ITEMS"
    lock "$id"
    # set -C: a second create of one id is refused, never an overwrite.
    if ! (set -C; printf '# %s\n\n## Brief\n\n## Log\n' "$title" > "$f") 2>/dev/null; then
      refuse "item $id already exists: $f"
    fi
    append "status=open owner=$owner repo=$repo parent=$parent model=$model effort=$effort"
    if [ -n "$has_brief$points" ]; then write_brief; append briefed; fi
    printf '%s\n' "$id" ;;
  brief)
    need "${1:-}"; id=$1; shift; points=""
    [ "${1:-}" = --points ] && { points=${2:-}; points_ok "$points"; shift 2; }
    [ $# -eq 1 ] || die "brief takes the text, or - for stdin"
    read_brief "$1"; sid=$(me) || exit $?
    lock "$id"
    [ -n "$points" ] || points=$(work_item_fold "$f" | sed -n 's/^points=//p')
    write_brief; append briefed ;;
  log)
    need "${1:-}"; id=$1; shift
    [ $# -gt 0 ] || die "log takes one or more words"
    line="$*"
    case $line in *"$nl"*) die "a log line is one line" ;; esac
    sid=$(me) || exit $?; to=""
    for w in "$@"; do
      case $w in
        status=*) to=${w#status=} ;;
        owner=*) case ${w#owner=} in agent|human-ruling|human-click) ;; *) die "owner is agent, human-ruling or human-click" ;; esac ;;
      esac
    done
    lock "$id"
    [ -z "$to" ] || move "$to"
    append "$line" ;;
  claim)
    need "${1:-}"; id=$1; sid=$(me) || exit $?
    lock "$id"
    move claimed
    append status=claimed ;;
  release)
    need "${1:-}"; id=$1; sid=$(me) || exit $?
    lock "$id"
    folded=$(fold_item) || refuse "could not read $f"
    [ "$(fact holder)" = "$sid" ] || refuse "$id is not held by this session ($sid)"
    move ready
    append status=ready ;;
  show)
    need "${1:-}"; cat "$f" ;;
  fold)
    need "${1:-}"; fold_item ;;
  *) sed -n '5,13p' "$0" | sed 's/^#   //' >&2; exit 2 ;;
esac
