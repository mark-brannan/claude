#!/bin/sh
# grind -- a zero-token orchestrator that works the Ready queue one
# `claude -p` session at a time.
#
# Why: no skill executes work. `ruling` routes decisions, `worklist`
# reports, `sweep` and `reconcile` prune the record. This is the one that
# does the work, and because it is a script rather than a model, measuring
# and capping spend is free. Ruled 2026-09-09 (Solace).
#
# Per Ready item, top (lowest issue number) first:
#   1. A fresh worktree on a new branch, named after the item.
#   2. One `claude -p --output-format stream-json --verbose --max-budget-usd
#      <item cap> --model <m> --effort <e>` with the issue body (plus a short
#      contract appended below) as the prompt, read line by line. Each
#      `assistant` event's `message.usage` is accumulated into a small state
#      file so the heartbeat can show a running token/cost estimate; the
#      worker's `result` event still carries the exact `total_cost_usd` and
#      result text. That session does the work and opens the PR. Merging
#      stays the human's.
#   3. Parse the final result event for cost and tokens; print one line:
#      item, model, cost, tokens, running total, percent of session budget.
#      Crossing 25/50/75% prints a louder line, once each, per session.
#   4. The worker ends its final message with one of three status lines:
#      "GRIND_STATUS: done" (the PR is open), "GRIND_STATUS: carded" (a
#      ruling only the repo owner can make; the worker filed the card
#      itself, per this repo's card-write convention), or
#      "GRIND_STATUS: blocked" (the item cannot be worked at all). None of
#      the first two is taken on trust: `done` is checked against a PR whose
#      head is the item's branch, `carded` against the board file's mtime or
#      a comment added to the issue while the worker ran. A claim that does
#      not check out becomes status "unverified" -- loud on stderr, cost
#      kept, worktree kept for inspection, retried on --resume. Run
#      grind-20260912T210131Z spent $4.39 on three items that all reported
#      success and left no PR, no card and no commit behind; that is the
#      failure these checks exist to catch.
#   5. Pause -- print a tally and the exact resume command, then exit 0 --
#      when: the session budget is reached, one item costs more than twice
#      the running median, or every N items. Nothing here waits on a
#      terminal.
#
# Defaults, overridable by flag: Sonnet, medium effort, $5/item, $20/session,
# pause every 3. `--dry-run` prints the plan -- one line per Ready item, the
# exact command that item would run -- and spends nothing.
#
# State (resume bookkeeping only, never committed): a JSON file per grind
# session under $XDG_STATE_HOME/grind holding the options and which item
# refs are already done or carded. `--resume <session>` re-reads it, skips
# what is already accounted for, and keeps appending to the same file.
#
# One grind per repo at a time: an mkdir-based lock at
# $XDG_STATE_HOME/grind/locks/<repo>.lock, held for the run and released on
# any exit. A second invocation fails fast rather than fighting the first
# over shared worktree paths and branch names.
#
#   grind [--dry-run] [--prs] [--repo owner/name] [--model <m>] [--effort <e>]
#         [--item-budget <usd>] [--session-budget <usd>] [--pause-every <n>]
#         [--resume <session-id>] [--heartbeat <seconds>] [--permission-mode <mode>]
#
# --prs works open pull requests instead of the Ready queue: the ones
# pr-label-audit puts in "Gated, unlabelled" or "Labelled but no longer green",
# which is to say the ones a session left unfinished. Everything below still
# holds -- the caps, the lock, the claim-checking -- with three differences.
# The orchestrator does the checkout, onto the PR's own head branch rather
# than a fresh one, because a fixup that makes a new branch has not fixed the
# PR. The prompt is the two briefs (`pr-label-audit --pr` and `branch_brief`)
# plus the fixup contract read out of the pickup skill: one text, two runners,
# so a session and a headless worker cannot be working to different rules.
# `done` is checked against Mergify's label, not a PR existing; a PR whose
# checks are all `cancelled` gets `gh run rerun --failed` instead of a worker.
#
# Output: one INFO line per unit of work started and finished, a heartbeat
# every --heartbeat seconds (default 60, 0 disables) while a worker runs, WARN
# for a skipped item, ERR when the run ends with skips (exit 1). The worker
# gets --permission-mode (default bypassPermissions) so it never waits on a
# terminal. acceptEdits was the default until it turned out to deny every
# Bash call -- git add, git commit and gh among them -- which makes finishing
# an item impossible: the worker edits files and can then do nothing with
# them. A worker runs unattended in a throwaway worktree it is meant to
# commit and push, so that is the mode it needs; --permission-mode narrows it
# again for a caller who wants that. A
# heartbeat line carries a live, `~`-marked token/cost estimate once the
# worker has emitted at least one assistant event, e.g.:
#   still working on owner/repo#97 (3m elapsed, ~48k tokens, ~$0.90 so far)
# `--output-format json` was dropped rather than kept behind a flag: the
# worker is always read as a stream now, and the two paths would otherwise
# duplicate all of the cost/status parsing below for no user-visible gain.
set -eu

usage() {
  printf 'usage: grind [--dry-run] [--prs] [--repo owner/name] [--model <m>] [--effort <e>]\n'
  printf '             [--item-budget <usd>] [--session-budget <usd>] [--pause-every <n>]\n'
  printf '             [--resume <session-id>] [--heartbeat <seconds>] [--permission-mode <mode>]\n'
}

# Logging. INFO goes to stdout at a low rate: one line per unit of work
# started or finished, plus a heartbeat while a worker runs. WARN and ERR go
# to stderr. All three are always on; there is no quiet mode.
pct() { awk -v a="$1" -v b="$2" 'BEGIN { if (b == 0) { print 0 } else { printf "%.0f", (a / b) * 100 } }'; }
fmt_usd() { awk -v v="$1" 'BEGIN { printf "$%.2f", v }'; }
fmt_tokens() { awk -v t="$1" 'BEGIN { if (t + 0 >= 1000) { printf "%dk", (t / 1000) + 0.5 } else { printf "%d", t } }'; }
ts()   { date -u +%H:%M:%SZ; }
info() { printf '%s INFO  %s\n' "$(ts)" "$*"; }
warn() { printf '%s WARN  %s\n' "$(ts)" "$*" >&2; }
err()  { printf '%s ERR   %s\n' "$(ts)" "$*" >&2; }

model=sonnet
effort=medium
item_budget=5
session_budget=20
pause_every=3
dry_run=0
prs=0
item_budget_set=0
session_budget_set=0
repo=""
resume_id=""
heartbeat=60
permission_mode=bypassPermissions
# Where a `carded` worker is expected to have written: the global board.
# Overridable for tests and for a machine that keeps the state repo elsewhere.
board_file=${GRIND_BOARD:-$HOME/claude_prompts_scratch/state/global/kanban.md}

while [ $# -gt 0 ]; do
  case $1 in
    --dry-run) dry_run=1 ;;
    --prs) prs=1 ;;
    --repo) shift; repo=${1:-} ;;
    --model) shift; model=${1:-} ;;
    --effort) shift; effort=${1:-} ;;
    --item-budget) shift; item_budget=${1:-}; item_budget_set=1 ;;
    --session-budget) shift; session_budget=${1:-}; session_budget_set=1 ;;
    --pause-every) shift; pause_every=${1:-} ;;
    --resume) shift; resume_id=${1:-} ;;
    --heartbeat) shift; heartbeat=${1:-} ;;
    --permission-mode) shift; permission_mode=${1:-} ;;
    -h|--help) usage; exit 0 ;;
    -*) printf 'grind: unknown option %s\n' "$1" >&2; usage >&2; exit 2 ;;
    *) printf 'grind: unexpected argument %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

command -v jq >/dev/null 2>&1 || { echo "grind: needs jq" >&2; exit 1; }
command -v gh >/dev/null 2>&1 || { echo "grind: needs gh" >&2; exit 1; }

# --- --prs: budgets, the signing key, and the one contract text ---------------
# The audit, the brief and the contract all live at fixed paths in the dotfiles
# tree, which is $HOME on a real machine and two levels up from this script in
# a worktree. GRIND_ROOT overrides both, for tests and for a machine that keeps
# the tree elsewhere.
self_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd || printf '.')
find_beside() {  # find_beside <path relative to the dotfiles tree>
  for c in "${GRIND_ROOT:-$self_dir/../..}/$1" "$HOME/$1"; do
    [ -f "$c" ] && { printf '%s' "$c"; return 0; }
  done
  return 1
}
audit_bin=$(find_beside .local/bin/pr-label-audit) || audit_bin=""
lib_state=$(find_beside .claude/hooks/lib-state.sh) || lib_state=""
contract_file=$(find_beside .claude/skills/pickup/SKILL.md) || contract_file=""

# The contract is the pickup skill's section 6, read rather than copied
# (dotfiles#267). Extracting it is what keeps the two runners on one text; a
# copy in this file would drift the first time either side is edited.
fixup_contract() {
  [ -n "$contract_file" ] || return 1
  awk '/^## 6\. The fixup contract/ { f = 1 } f && /^## Writing a block/ { exit } f' "$contract_file"
}

if [ "$prs" -eq 1 ]; then
  # Proposed, not ruled (dotfiles#269): a fixup is meant to be cheap and to
  # give up loudly, so the per-item cap is the ~$1 the contract's own stop
  # rule names, and five of those is a session.
  [ "$item_budget_set" -eq 0 ] && item_budget=1
  [ "$session_budget_set" -eq 0 ] && session_budget=5
fi

# A logged-out claude fails every item the same way -- a $0, 0-token result
# whose only content is "OAuth session expired" -- and until 2026-09-16 that
# text was dropped, so three runs in a row reported "worker reported an
# error" with nothing to act on. Check once, before any worktree is cut.
# Older CLIs without `auth status` print nothing parseable: skip the check
# rather than block, and let the worker's own result text (now surfaced on
# FAILED lines) say what went wrong.
if [ "$dry_run" -eq 0 ]; then
  auth_json=$(claude auth status </dev/null 2>/dev/null || true)
  if printf '%s' "$auth_json" | jq -e . >/dev/null 2>&1 \
     && [ "$(printf '%s' "$auth_json" | jq -r '.loggedIn == false')" = true ]; then
    printf 'grind: claude is not logged in (claude auth status: loggedIn=false); run `claude auth login` first\n' >&2
    exit 1
  fi
fi

state_root=${XDG_STATE_HOME:-$HOME/.local/state}/grind
mkdir -p "$state_root" 2>/dev/null || true

# --- repo scope --------------------------------------------------------------
cwd_repo() {
  u=$(git remote get-url origin 2>/dev/null) || return 1
  r=$(printf '%s' "$u" | sed -e 's#^https://github\.com/##' -e 's#^ssh://git@github\.com/##' \
        -e 's#^git@github\.com:##' -e 's#/$##' -e 's#\.git$##')
  [ "$r" = "$u" ] && return 1
  printf '%s' "$r"
}

# --- state file ---------------------------------------------------------------
# {session, repo, model, effort, item_budget, session_budget, pause_every,
#  items: [{ref, status, cost}]}
new_session_id() { date -u +%Y%m%dT%H%M%SZ; }

if [ -n "$resume_id" ]; then
  state_file="$state_root/$resume_id.json"
  [ -f "$state_file" ] || { printf 'grind: no session %s at %s\n' "$resume_id" "$state_file" >&2; exit 1; }
  session_id=$resume_id
  repo=$(jq -r '.repo' "$state_file")
  model=$(jq -r '.model' "$state_file")
  effort=$(jq -r '.effort' "$state_file")
  item_budget=$(jq -r '.item_budget' "$state_file")
  session_budget=$(jq -r '.session_budget' "$state_file")
  pause_every=$(jq -r '.pause_every' "$state_file")
  # The mode is the session's, not the flag's: a --prs session's UNVERIFIED
  # line promises a retry on --resume, and that retry has to read the same
  # queue. A missing field is an older session file, which was always issues.
  state_prs=$(jq -r '.prs // 0' "$state_file")
  if [ "$prs" -eq 1 ] && [ "$state_prs" -ne 1 ]; then
    printf 'grind: session %s worked the Ready queue, not PRs; drop --prs to resume it\n' "$resume_id" >&2; exit 1
  fi
  prs=$state_prs
else
  session_id=grind-$(new_session_id)
  state_file="$state_root/$session_id.json"
  [ -n "$repo" ] || repo=$(cwd_repo) || { printf 'grind: not in a GitHub repo; pass --repo owner/name\n' >&2; exit 1; }
  if [ "$dry_run" -eq 0 ]; then
    jq -n --arg repo "$repo" --arg model "$model" --arg effort "$effort" \
          --argjson ib "$item_budget" --argjson sb "$session_budget" --argjson pe "$pause_every" --argjson prs "$prs" \
      '{repo:$repo, model:$model, effort:$effort, item_budget:$ib, session_budget:$sb, pause_every:$pe, prs:$prs, items:[]}' \
      > "$state_file"
  fi
fi

resume_cmd="grind --resume $session_id"

# --prs preconditions, checked once the mode is settled -- a --resume takes it
# from the session file, so this cannot run before that is read.
if [ "$prs" -eq 1 ]; then
  # Every commit a fixup makes has to sign, and the contract forbids the
  # worker from working around that. A machine without a key cannot finish a
  # single item, so refuse the run rather than spend the budget rediscovering
  # it once per PR.
  if [ -z "$(git config --get user.signingkey 2>/dev/null)" ]; then
    echo "grind: --prs needs a signing key on this machine (git config user.signingkey is empty)" >&2
    exit 1
  fi
  [ -n "$audit_bin" ] || { echo "grind: --prs needs pr-label-audit; not found beside grind or under \$HOME" >&2; exit 1; }
  [ -n "$lib_state" ] || { echo "grind: --prs needs .claude/hooks/lib-state.sh for branch_brief" >&2; exit 1; }
  # No contract means the worker would be handed a PR and no rules at all.
  if [ -z "$(fixup_contract || true)" ]; then
    echo "grind: --prs needs the fixup contract in .claude/skills/pickup/SKILL.md" >&2; exit 1
  fi
fi

# Worktrees are cut from the current directory's repository, so it must be
# a checkout of $repo -- otherwise the worker is handed the wrong codebase.
if [ "$dry_run" -eq 0 ]; then
  here=$(cwd_repo) || here=""
  [ "$here" = "$repo" ] \
    || { printf 'grind: current directory is not a checkout of %s (found: %s); cd there first\n' \
           "$repo" "${here:-no GitHub remote}" >&2; exit 1; }
fi

# --- single-flight lock, one grind per repo -----------------------------------
# Two grinds against the same repo would fight over the same worktree paths
# and branch names (grind-<n>): the second's `git branch -D` can delete a
# worktree the first still has checked out. mkdir is the mutex (atomic, no
# flock dependency); meta.json tells a live lock from a stale one, and also
# carries per-run diagnostics (ppid, user, tty, cwd, rev, session, current
# item) mirrored into the session state file's "lock" key -- a human staring
# at a stuck lock or a stale state file needs exactly this.
hostname_now=$(uname -n 2>/dev/null || echo unknown)
whoami_now=$(id -un 2>/dev/null || whoami 2>/dev/null || echo unknown)
tty_now=$(tty 2>/dev/null || echo none)
grind_rev=$(git -C "$(dirname "$0")" rev-parse --short HEAD 2>/dev/null || echo unknown)
claude_session=${CLAUDE_SESSION_ID:-${CLAUDE_CODE_SESSION_ID:-none}}
lock_root="$state_root/locks"
mkdir -p "$lock_root" 2>/dev/null || true
lock_dir="$lock_root/$(printf '%s' "$repo" | tr '/' '_').lock"
lock_meta="$lock_dir/meta.json"

write_lock() {
  # $1 = current item ref (or empty), $2 = its start unix ts (or empty)
  lock_item=${1:-}; lock_item_started=${2:-}
  jq -n --argjson pid "$$" --argjson ppid "${PPID:-0}" --arg host "$hostname_now" \
        --arg user "$whoami_now" --arg tty "$tty_now" --arg cwd "$invoked_cwd" \
        --arg rev "$grind_rev" --arg claude_session "$claude_session" \
        --arg acquired "$lock_acquired_at" --arg hb "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        --arg item "$lock_item" --arg item_started "$lock_item_started" \
    '{pid:$pid, ppid:$ppid, hostname:$host, user:$user, tty:$tty, invoked_cwd:$cwd,
      grind_rev:$rev, claude_session_id:$claude_session, lock_acquired_at:$acquired,
      last_heartbeat_at:$hb, current_item: (if $item == "" then null else $item end),
      current_item_started_at: (if $item_started == "" then null else ($item_started|tonumber) end)}' \
    > "$lock_meta" 2>/dev/null || true
  [ -f "$state_file" ] && jq --slurpfile lk "$lock_meta" '.lock = $lk[0]' "$state_file" \
    > "$state_file.tmp" 2>/dev/null && mv "$state_file.tmp" "$state_file" || true
}

if [ "$dry_run" -eq 0 ]; then
  invoked_cwd=$(pwd)
  if ! mkdir "$lock_dir" 2>/dev/null; then
    set -- $(jq -r '(.pid // 0), (.hostname // "")' "$lock_meta" 2>/dev/null)
    other_pid=${1:-0}; other_host=${2:-}
    if [ "$other_host" = "$hostname_now" ] && ! kill -0 "$other_pid" 2>/dev/null; then
      warn "reclaiming stale lock on $repo at $lock_dir (pid $other_pid not running)"
      stale_dir="$lock_dir.stale.$$"  # rename first: atomic, a racer's mkdir below loses cleanly
      mv "$lock_dir" "$stale_dir" 2>/dev/null && rm -rf "$stale_dir" && mkdir "$lock_dir" \
        || { err "lock changed while reclaiming it"; exit 1; }
    else
      printf 'grind: another grind is already running against %s\n' "$repo" >&2
      cat "$lock_meta" >&2; exit 1
    fi
  fi
  # An EXIT trap alone is not enough: dash (this script's shell, /bin/sh on
  # Debian/Ubuntu) does not run it when the process dies to an unhandled
  # signal -- only on a normal exit or the `exit` builtin. Killing a stuck
  # grind with TERM left this lock behind and blocked every later run until
  # someone noticed and removed it by hand (2026-09-13). TERM and INT get
  # their own trap that also calls exit, so the signal itself is what
  # cleans up.
  trap 'rm -rf "$lock_dir"' EXIT
  trap 'rm -rf "$lock_dir"; exit 143' TERM
  trap 'rm -rf "$lock_dir"; exit 130' INT
  lock_acquired_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  write_lock
fi

# refs (owner/repo#N) already accounted for from a prior run of this session,
# delimited so a ref that is a prefix of another (e.g. #5 vs #50) can't
# falsely match on a raw substring test.
# Items recorded as failed or unverified keep their cost but are retried, so
# they are excluded here. A blocked item is accounted for: a later grind run
# picks it up once whatever blocks it is gone.
done_refs="|"
[ -f "$state_file" ] && done_refs="|$(jq -r '.items[] | select(.status != "failed" and .status != "unverified") | .ref' "$state_file" | tr '\n' '|')"

is_done_ref() {
  case "$done_refs" in *"|$1|"*) return 0 ;; esac
  return 1
}

# --- the queue, top (lowest number) first -------------------------------------
if [ "$prs" -eq 1 ]; then
  # pr-label-audit audits the whole account; grind is repo-scoped by its lock,
  # its worktree source and its --repo check, so the audit is filtered to this
  # repo rather than grind being widened to the fleet. The trailing
  # repos_missing_fixup_hard object carries no .repo and drops out here.
  audit_json=$("$audit_bin" --json 2>&1) \
    || { printf 'grind: pr-label-audit failed: %s\n' "$audit_json" >&2; exit 1; }
  # main itself is red on this repo (pr-label-audit's repos_base_red) -- no
  # PR here is a fixup's fault, so the whole --prs pass pauses, not just the
  # items that happen to be queued (dotfiles#359).
  if printf '%s' "$audit_json" | jq -e -s --arg name "${repo##*/}" \
       'any(.[]; (.repos_base_red // []) | index($name))' >/dev/null; then
    echo "grind: $repo's base branch is red; skipping the --prs pass until it's green"
    exit 0
  fi
  items=$(printf '%s' "$audit_json" | jq -s -c --arg name "${repo##*/}" '
    [ .[] | select(.repo? == $name)
          | select(.section == "unfinished" or .section == "stale-label") ]
    | sort_by(.number)') \
    || { echo "grind: could not read pr-label-audit --json" >&2; exit 1; }
else
  ready_json=$(gh issue list --repo "$repo" --label ready --state open --limit 100 \
    --json number,title,body,url,labels 2>&1) \
    || { printf 'grind: could not list issues on %s: %s\n' "$repo" "$ready_json" >&2; exit 1; }

  items=$(printf '%s' "$ready_json" | jq -c '
    map(select((.labels | map(.name) | index("blocked")) == null))
    | sort_by(.number)')
fi

count=$(printf '%s' "$items" | jq 'length')
if [ "$count" -eq 0 ]; then
  if [ "$prs" -eq 1 ]; then echo "grind: no unfinished PRs on $repo"; else echo "grind: no Ready items on $repo"; fi
  exit 0
fi

if [ "$dry_run" -eq 0 ]; then
  info "session $session_id on $repo: $count $( [ "$prs" -eq 1 ] && printf 'unfinished PR' || printf 'Ready item')(s), $model/$effort, cap $(fmt_usd "$item_budget")/item $(fmt_usd "$session_budget")/session, pause every $pause_every"
  info "state: $state_file"
fi
skipped=0
rerun_used=0

# Every way out of the loop goes through here so a skipped item fails the
# run whether it ended by pause or by exhausting the queue.
finish() {
  if [ "$skipped" -gt 0 ]; then
    err "$skipped item(s) skipped (worktree could not be created); see WARN lines above"
    exit 1
  fi
  exit 0
}

# --- one worktree per item -----------------------------------------------------
worktree_root=${TMPDIR:-/tmp}/grind-worktrees

# pr_skip <item json> <head branch> -- the reason this PR is not workable, or
# empty. Each is a skip rather than an attempt because attempting it spends
# the budget and changes nothing: a `fixup-hard` PR already had its cheap
# pass, `blocked` is not a session's to reopen, a bot regenerates its own
# branch wholesale so any fix is thrown away, a branch a local worktree holds
# belongs to a live session, and a head this new is probably still being
# pushed to. `head_committed_at` is a commit date, not a push time -- the
# closest thing the audit carries -- and it is Mergify's merge commit as
# often as a session's, so a fresh one is re-aged by the last human commit.
pr_skip() {
  for l in $(printf '%s' "$1" | jq -r '.labels[]?'); do
    case $l in fixup-hard|blocked) printf 'labelled %s' "$l"; return ;; esac
  done
  case "$(printf '%s' "$1" | jq -r '.author // ""')" in
    dependabot*|*release-please*) printf 'opened by a bot that regenerates its own branch'; return ;;
  esac
  # grind's own leftovers under $worktree_root are not a live claim -- an
  # unverified item deliberately keeps its worktree for inspection, and
  # counting that as someone else's claim would lock the PR out of the
  # --resume retry the UNVERIFIED line promises. The loop clears its own
  # path before every attempt anyway.
  if [ -n "$2" ] && git worktree list --porcelain 2>/dev/null | awk -v root="$worktree_root/" \
       -v b="branch refs/heads/$2" '
         /^worktree / { p = substr($0, 10) }
         $0 == b && index(p, root) != 1 { found = 1 }
         END { exit !found }'; then
    printf 'a local worktree holds %s' "$2"; return
  fi
  if [ "$(printf '%s' "$1" | jq -r '
        (.head_committed_at // "1970-01-01T00:00:00Z")
        | if (now - fromdateiso8601) < 14400 then "y" else "n" end')" = y ]; then
    # A fresh head is usually not a session's. Mergify's update rule merges
    # main into every labelled PR each time main moves -- five merge commits
    # in 100 minutes on one PR the night this was written -- so on a busy
    # evening every PR in the repo is "less than 4h old" and --prs works
    # nothing. Age the PR by its newest commit that Mergify did not write.
    # If that cannot be read, keep the skip: wrong in the safe direction.
    last_human=$(gh pr view "$(printf '%s' "$1" | jq -r '.number')" --repo "$repo" --json commits --jq '
        [.commits[] | select(all(.authors[]?; (.login // "") != "mergify[bot]")) | .committedDate]
        | max // "1970-01-01T00:00:00Z"' 2>/dev/null) || last_human=""
    if [ -z "$last_human" ] || [ "$(printf '%s' "$last_human" | jq -R -r '
          if (now - fromdateiso8601) < 14400 then "y" else "n" end')" = y ]; then
      printf 'head is less than 4h old'
    fi
  fi
}

# pr_cancelled_rerun <item json> -- nothing failed, so rerun the cancelled
# run(s) rather than spend a worker on it. Skips a 2nd-attempt run, and
# reruns at most one PR per pass ($rerun_used, set by the caller).
pr_cancelled_rerun() {
  [ "$rerun_used" -eq 0 ] || { printf 'this pass already reran a PR'; return; }
  run_ids=$(printf '%s' "$1" | jq -r '.failing_checks[]?.url // empty' | sed -n 's#.*/runs/\([0-9]*\)/.*#\1#p' | sort -u)
  [ -n "$run_ids" ] || { printf 'no run id could be read from the failing checks'; return; }
  reran=""
  for rid in $run_ids; do
    attempt=$(gh api "repos/$repo/actions/runs/$rid" --jq .run_attempt 2>/dev/null) || attempt=1
    [ "${attempt:-1}" -ge 2 ] && continue
    gh run rerun "$rid" --repo "$repo" --failed >/dev/null 2>&1 && reran="$reran $rid"
  done
  [ -n "$reran" ] && printf 'all checks were cancelled -- reran run(s)%s' "$reran" \
    || printf 'all checks were cancelled, but nothing was eligible to rerun'
}

# build_pr_prompt <ref> <branch> <worktree> -- the two briefs, then the one
# contract. The briefs are run here rather than described, so the worker reads
# the same base recommendation a session would and makes no branch decision of
# its own.
build_pr_prompt() {
  printf 'Fix up pull request %s.\n\nTwo briefs. Read both before you touch anything.\n\n' "$1"
  printf -- '=== pr-label-audit --pr %s ===\n' "$1"
  "$audit_bin" --pr "$1" 2>&1 || printf '(the audit failed -- read the PR with gh before deciding anything)\n'
  printf -- '\n=== branch_brief %s %s ===\n' "$3" "$2"
  # shellcheck disable=SC1090
  ( . "$lib_state" && branch_brief "$3" "$2" ) 2>&1 \
    || printf '(the brief failed -- do not guess the base; stop and say so)\n'
  printf -- '\n---\n\n'
  fixup_contract
  printf '\nYou are alone in a fresh worktree at %s, on %s -- the PR\047s own head\n' "$3" "$2"
  printf 'branch. Make no other branch. The worktree is deleted when you exit, so\n'
  printf 'anything not committed and pushed is lost.\n\n'
  printf 'End your final message with exactly one of these lines, nothing after it:\n\n'
  printf '  GRIND_STATUS: done     you finished. grind checks the PR for the\n'
  printf '                         awaiting-human label Mergify computes, or for a\n'
  printf '                         head that moved with every commit signed, and\n'
  printf '                         records the item unverified if it finds neither.\n'
  printf '  GRIND_STATUS: blocked  you hit the contract\047s stop rule. Its terms are\n'
  printf '                         not optional: the fixup-hard label and one\n'
  printf '                         comment saying what was tried, why it is hard and\n'
  printf '                         what it cost. grind checks the label is there.\n'
}

# build_prompt <issue body> <ref> <branch>
build_prompt() {
  body=$1; p_ref=$2; p_branch=$3
  printf '%s\n\n---\n' "$body"
  printf 'Grind orchestration contract for %s.\n\n' "$p_ref"
  printf 'You are alone in a fresh worktree on branch %s. Work the item to a\n' "$p_branch"
  printf 'mergeable PR: commit, push the branch, and open the PR yourself with gh.\n'
  printf 'Do not merge it. The worktree is deleted when you exit, so anything you\n'
  printf 'have not committed and pushed is lost.\n\n'
  printf 'End your final message with exactly one of these lines, nothing after it:\n\n'
  printf '  GRIND_STATUS: done     the PR is open. grind checks that a PR exists\n'
  printf '                         with head branch %s and records the item\n' "$p_branch"
  printf '                         unverified if none does.\n'
  printf '  GRIND_STATUS: carded   finishing needs a ruling only the repo owner can\n'
  printf '                         make. File the card first, per this repo'"'"'s\n'
  printf '                         card-write convention. grind checks that the\n'
  printf '                         board changed or the issue gained a comment, and\n'
  printf '                         records the item unverified if neither did.\n'
  printf '  GRIND_STATUS: blocked  the item cannot be worked at all -- a missing\n'
  printf '                         dependency, an unmet precondition, work that\n'
  printf '                         belongs to another item. Comment on the issue\n'
  printf '                         saying why, so the reason outlives this session.\n'
}

# --- verifying the worker's claim ---------------------------------------------
# A worker reporting success costs the same as one that did the work, so the
# claim is checked against GitHub rather than believed. Both checks fail
# closed: a gh call that errors leaves the item unverified.

# verify_pr <branch> <worker start, ISO 8601>
# A PR whose head is this item's branch, and which this run is responsible
# for: opened since the worker started, or already open and pushed to since.
# Branch names are deterministic (grind-<number>), so without the time bound
# a PR left behind by an earlier attempt would validate a fresh empty claim.
verify_pr() {
  n=$(gh pr list --repo "$repo" --head "$1" --state all --json createdAt,updatedAt,state \
        --jq "[.[] | select(.createdAt >= \"$2\" or (.state == \"OPEN\" and .updatedAt >= \"$2\"))] | length" 2>/dev/null) || return 1
  case "$n" in ''|*[!0-9]*) return 1 ;; esac
  [ "$n" -gt 0 ]
}

# pr_labels <pr number> -- one label per line; fails closed on a gh error, so
# a lookup that did not complete never reads as "the label is absent".
pr_labels() { gh pr view "$1" --repo "$repo" --json labels --jq '.labels[].name' 2>/dev/null; }

# verify_pr_fixup <pr number> <branch> <worktree> <worker start, ISO 8601>
# Two ways to be finished, and neither is the worker's word for it: Mergify
# put `awaiting-human` on the PR, or the head moved while the worker ran and
# every commit between the base and the head verifies. A signature grind
# cannot read is not a signature -- %G? is checked against G and U only, so an
# unsigned commit (N) or a bad one (B/E) fails this, which is the whole
# reason the contract forbids working around the signing hook.
verify_pr_fixup() {
  pr_labels "$1" | grep -qx awaiting-human && return 0
  base=$(gh pr view "$1" --repo "$repo" --json baseRefName --jq .baseRefName 2>/dev/null) || return 1
  [ -n "$base" ] || return 1
  moved=$(gh pr view "$1" --repo "$repo" --json commits \
            --jq "[.commits[] | select(.committedDate >= \"$4\")] | length" 2>/dev/null) || return 1
  case "$moved" in ''|*[!0-9]*) return 1 ;; esac
  [ "$moved" -gt 0 ] || return 1
  git -C "$3" fetch -q origin "$base" 2>/dev/null || return 1
  # A range git cannot read, or an empty one, verifies nothing: the previous
  # form counted zero unreadable lines as zero bad signatures.
  sigs=$(git -C "$3" log --format='%G?' "origin/$base..$2" 2>/dev/null) || return 1
  [ -n "$sigs" ] || return 1
  ! printf '%s\n' "$sigs" | grep -qvx '[GU]'
}

# verify_carded <issue number> <marker file> <worker start, ISO 8601>
# Either the board file was written after the marker, or the issue gained a
# comment at/after the worker started.
verify_carded() {
  # find -newer, not test -nt: -nt is not in POSIX sh (shellcheck SC3013).
  if [ -f "$board_file" ] && [ -n "$(find "$board_file" -newer "$2" 2>/dev/null)" ]; then return 0; fi
  c=$(gh issue view "$1" --repo "$repo" --json comments \
        --jq "[.comments[] | select(.createdAt >= \"$3\")] | length" 2>/dev/null) || return 1
  case "$c" in ''|*[!0-9]*) return 1 ;; esac
  [ "$c" -gt 0 ]
}

# --- live cost estimate (heartbeat only; the final line uses the exact
# total_cost_usd from the result event) --------------------------------------
# List price in USD per 1M tokens, by model alias/name substring. Cache
# write/read aren't looked up per model here -- they use Anthropic's
# standard ratios off the base input price (1.25x for a cache write, 0.1x
# for a cache read). Unrecognized names fall back to Sonnet pricing.
model_price_in() {
  case "$1" in
    *opus*) printf '5.00' ;;
    *fable*|*mythos*) printf '10.00' ;;
    *haiku*) printf '1.00' ;;
    *) printf '2.00' ;;
  esac
}
model_price_out() {
  case "$1" in
    *opus*) printf '25.00' ;;
    *fable*|*mythos*) printf '50.00' ;;
    *haiku*) printf '5.00' ;;
    *) printf '10.00' ;;
  esac
}
# estimate_cost <model> <input> <output> <cache_read> <cache_creation>
estimate_cost() {
  ip=$(model_price_in "$1"); op=$(model_price_out "$1")
  awk -v ip="$ip" -v op="$op" -v i="$2" -v o="$3" -v cr="$4" -v cc="$5" \
    'BEGIN { printf "%.4f", (i*ip + o*op + cr*(ip*0.1) + cc*(ip*1.25)) / 1000000 }'
}

# median <space-separated numbers> -> prints 0 when the list is empty
median() {
  if [ -z "$1" ]; then printf '0\n'; return; fi
  printf '%s\n' "$1" | tr ' ' '\n' | awk 'NF' | sort -n | awk '
    { a[NR]=$1 } END { if (NR==0) { print 0; exit }
      if (NR % 2) print a[(NR+1)/2]; else print (a[NR/2]+a[NR/2+1])/2 }'
}


# Seed running_total and costs from prior-run item costs already in
# $state_file so a --resume honors the original --session-budget as a
# cap on the whole session, not just on this invocation.
running_total=0
costs=""
if [ -f "$state_file" ]; then
  running_total=$(jq -r '[.items[].cost] | add // 0' "$state_file")
  costs=$(jq -r '.items[].cost' "$state_file" | tr '\n' ' ')
fi

start_percent=$(pct "$running_total" "$session_budget")
loud_25=0; loud_50=0; loud_75=0
[ "$start_percent" -ge 25 ] && loud_25=1
[ "$start_percent" -ge 50 ] && loud_50=1
[ "$start_percent" -ge 75 ] && loud_75=1
processed_this_run=0

i=0
while [ "$i" -lt "$count" ]; do
  item=$(printf '%s' "$items" | jq -c ".[$i]")
  i=$((i + 1))
  number=$(printf '%s' "$item" | jq -r '.number')
  title=$(printf '%s' "$item" | jq -r '.title')
  ref="$repo#$number"

  is_done_ref "$ref" && continue

  if [ "$dry_run" -eq 0 ]; then
    already_reached=$(awk -v a="$running_total" -v b="$session_budget" 'BEGIN { print (a >= b) ? 1 : 0 }')
    if [ "$already_reached" -eq 1 ]; then
      printf 'pause: session budget reached (%s / %s). %d item(s) processed this run.\n' \
        "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")" "$processed_this_run"
      printf 'resume: %s\n' "$resume_cmd"
      finish
    fi
  fi

  if [ "$prs" -eq 1 ]; then
    branch=$(gh pr view "$number" --repo "$repo" --json headRefName --jq .headRefName 2>/dev/null) || branch=""
    wt_path="$worktree_root/pr-$number"
    verdict=$(printf '%s' "$item" | jq -r '.verdict')
    reason=$(pr_skip "$item" "$branch")
    [ -n "$branch" ] || reason="could not read its head branch"
    if [ -z "$reason" ] && [ "$verdict" = "not-green" ] \
       && [ "$(printf '%s' "$item" | jq -r '.cancelled_only // false')" = true ]; then
      if [ "$dry_run" -eq 1 ]; then
        reason="all checks are cancelled -- would rerun rather than work it"
      else
        reason=$(pr_cancelled_rerun "$item")
        case "$reason" in *"reran run"*) rerun_used=1 ;; esac
      fi
    fi
    if [ -n "$reason" ]; then
      if [ "$dry_run" -eq 1 ]; then
        printf '[%d/%d] %s -- SKIP: %s\n' "$i" "$count" "$ref" "$reason"
      else
        warn "skipping $ref -- $reason"
      fi
      continue
    fi
  else
    branch="grind-$number"
    wt_path="$worktree_root/$number"
    verdict=""
  fi

  cmd_display="claude -p <issue $ref body> --output-format stream-json --verbose --max-budget-usd $item_budget --model $model --effort $effort"
  [ "$prs" -eq 1 ] && cmd_display="claude -p <$ref briefs + fixup contract> --output-format stream-json --verbose --max-budget-usd $item_budget --model $model --effort $effort"

  if [ "$dry_run" -eq 1 ]; then
    printf '[%d/%d] %s -- %s%s\n' "$((i))" "$count" "$ref" "${verdict:+[$verdict] }" "$title"
    if [ "$prs" -eq 1 ]; then
      printf '  worktree: git worktree add -B %s %s origin/%s\n' "$branch" "$wt_path" "$branch"
    else
      printf '  worktree: git worktree add -b %s %s\n' "$branch" "$wt_path"
    fi
    printf '  command:  %s\n' "$cmd_display"
    continue
  fi

  info "[$i/$count] starting $ref -- $title"
  mkdir -p "$worktree_root"
  # Remove the directory first, then prune: a worktree kept from a previous
  # unverified attempt is still registered, and git refuses to delete a
  # branch a registered worktree holds.
  rm -rf "$wt_path"
  git worktree prune >/dev/null 2>&1 || true
  # Only in issue mode: `$branch` is the synthetic `grind-<number>` there, so
  # deleting it is safe. In `--prs` mode it is the PR's real head branch name,
  # which a human may also hold locally with unpushed commits -- and `-B`
  # below resets it from the remote anyway, so the delete would be pure risk.
  [ "$prs" -eq 1 ] || git branch -D "$branch" >/dev/null 2>&1 || true
  if [ "$prs" -eq 1 ]; then
    # The PR's own head branch, reset to the remote: the worker fixes this
    # pull request or it has not fixed anything. `-B` resets any local copy,
    # and a branch a worktree still holds was skipped.
    wt_err=$(git fetch -q origin "+refs/heads/$branch:refs/remotes/origin/$branch" 2>&1) \
      && wt_err=$(git worktree add -q -B "$branch" "$wt_path" "origin/$branch" 2>&1 >/dev/null) \
      || { warn "skipping $ref -- could not check out $branch: $wt_err"; skipped=$((skipped + 1)); continue; }
  elif ! wt_err=$(git worktree add -q -b "$branch" "$wt_path" 2>&1 >/dev/null); then
    warn "skipping $ref -- could not create worktree $wt_path on branch $branch: $wt_err"
    skipped=$((skipped + 1))
    continue
  fi
  info "worktree $wt_path on branch $branch"

  if [ "$prs" -eq 1 ]; then
    prompt=$(build_pr_prompt "$ref" "$branch" "$wt_path")
  else
    prompt=$(build_prompt "$(printf '%s' "$item" | jq -r '.body')" "$ref" "$branch")
  fi
  started=$(date +%s)
  # Reference points for the carded check: a marker the board file must be
  # newer than, and the wall-clock instant a new issue comment must follow.
  started_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  marker="$state_root/${session_id}.marker"
  : > "$marker"
  write_lock "$ref" "$started"
  info "worker running: claude -p --model $model --effort $effort --max-budget-usd $item_budget --permission-mode $permission_mode (heartbeat every ${heartbeat}s)"

  # live_file holds "input output cache_read cache_creation" running totals,
  # rewritten by the reader loop below on every assistant event; the
  # heartbeat subshell only reads it. One file per grind session -- items
  # run sequentially, so it's reset (truncated) at the start of each item.
  live_file="$state_root/${session_id}.live"
  result_file="$state_root/${session_id}.result"
  rc_file="$state_root/${session_id}.rc"
  printf '0 0 0 0\n' > "$live_file"
  : > "$result_file"
  : > "$rc_file"

  hb_pid=""
  if [ "$heartbeat" -gt 0 ]; then
    # The sleep child would otherwise outlive the kill and hold stdout open.
    ( trap 'kill "$sp" 2>/dev/null || true; exit 0' TERM
      while :; do
        sleep "$heartbeat" & sp=$!; wait "$sp" || exit 0
        write_lock "$ref" "$started"
        elapsed_m=$(( ($(date +%s) - started) / 60 ))
        live=$(cat "$live_file" 2>/dev/null || printf '0 0 0 0')
        set -- $live
        li=${1:-0}; lo=${2:-0}; lcr=${3:-0}; lcc=${4:-0}
        ltotal=$((li + lo + lcr + lcc))
        if [ "$ltotal" -gt 0 ]; then
          lcost=$(estimate_cost "$model" "$li" "$lo" "$lcr" "$lcc")
          info "still working on $ref (${elapsed_m}m elapsed, ~$(fmt_tokens "$ltotal") tokens, ~$(fmt_usd "$lcost") so far)"
        else
          info "still working on $ref (${elapsed_m}m elapsed)"
        fi
      done ) &
    hb_pid=$!
  fi

  # Read the worker's stream-json output line by line, accumulating each
  # assistant event's usage into live_file for the heartbeat above, and
  # keeping the final result event for the cost/status parsing below.
  # claude's own exit code can't come from $? after the pipeline (that
  # would be the while loop's), so it's relayed through rc_file instead.
  #
  # claude is backgrounded (rather than run in the `cd && printf | claude`
  # foreground pipe this replaced) so its own pid is in hand: a worker can
  # leave a child running past its own exit -- an MCP server it started and
  # never reaped is the observed case -- and that child inherits this
  # pipe's write end. `while read` then blocks on EOF forever even though
  # claude is long gone, which hangs this item and leaves the heartbeat
  # above printing "still working" indefinitely with nothing left to kill
  # it. Best-effort TERM claude's direct children by its own pid once it
  # exits, closing their end of the pipe too. Found 2026-09-13: a grind run
  # sat like this for 490+ elapsed minutes on one item.
  ( cd "$wt_path" || exit 1
    printf '%s' "$prompt" | claude -p --output-format stream-json --verbose \
         --max-budget-usd "$item_budget" --model "$model" --effort "$effort" \
         --permission-mode "$permission_mode" &
    cpid=$!
    # `wait` and the `command -v` test both report non-zero in the ordinary
    # course of things -- a worker that failed, a host without pkill -- and
    # under `set -e` either one kills this subshell before it can write
    # rc_file. An empty rc_file reads back as an empty claude_rc, which is
    # neither 0 nor a number: the caller's `[ "$claude_rc" -ne 0 ]` dies with
    # "Illegal number" and the item's real exit status is lost. Keep nothing
    # on this path in a position for `set -e` to trip on.
    crc=0; wait "$cpid" || crc=$?
    if command -v pkill >/dev/null 2>&1; then
      pkill -TERM -P "$cpid" 2>/dev/null || true
    fi
    echo "$crc" > "$rc_file"
  ) | while IFS= read -r line; do
      etype=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null) || continue
      case "$etype" in
        assistant)
          usage=$(printf '%s' "$line" | jq -c '.message.usage // empty' 2>/dev/null)
          [ -n "$usage" ] && [ "$usage" != "null" ] || continue
          cur=$(cat "$live_file" 2>/dev/null || printf '0 0 0 0')
          set -- $cur
          ci=${1:-0}; co=${2:-0}; ccr=${3:-0}; ccc=${4:-0}
          di=$(printf '%s' "$usage" | jq -r '.input_tokens // 0')
          do_=$(printf '%s' "$usage" | jq -r '.output_tokens // 0')
          dcr=$(printf '%s' "$usage" | jq -r '.cache_read_input_tokens // 0')
          dcc=$(printf '%s' "$usage" | jq -r '.cache_creation_input_tokens // 0')
          printf '%s %s %s %s\n' "$((ci + di))" "$((co + do_))" "$((ccr + dcr))" "$((ccc + dcc))" > "$live_file"
          ;;
        result)
          printf '%s\n' "$line" > "$result_file"
          ;;
      esac
    done
  # An unwritten or non-numeric rc means the worker's exit status never made
  # it out of the subshell: treat the unknown as a failure rather than
  # letting `[ -ne ]` abort on it, so --resume retries the item.
  claude_rc=$(cat "$rc_file" 2>/dev/null || echo 1)
  case "$claude_rc" in "" | *[!0-9]*) claude_rc=1 ;; esac
  result_json=$(cat "$result_file" 2>/dev/null || echo "")
  rm -f "$live_file" "$result_file" "$rc_file"

  # `kill` here is bare under `set -e`: if the heartbeat already exited on
  # its own -- it does, whenever its `wait` was interrupted -- the failed
  # kill takes the whole grind run down between items, not just this one.
  if [ -n "$hb_pid" ]; then
    kill "$hb_pid" 2>/dev/null || true
    wait "$hb_pid" 2>/dev/null || true
  fi
  info "worker exited $claude_rc after $(( $(date +%s) - started ))s"
  write_lock

  # Unparseable/empty JSON means the worker never produced a result, so its
  # spend is unknown: don't record it, and let --resume retry it.
  if ! printf '%s' "$result_json" | jq -e . >/dev/null 2>&1; then
    git worktree remove -f "$wt_path" >/dev/null 2>&1 || true
    rm -f "$marker"
    printf 'FAILED: %s -- %s -- claude invocation did not complete; not recorded, will retry on --resume\n' \
      "$ref" "$title" >&2
    continue
  fi

  cost=$(printf '%s' "$result_json" | jq -r '.total_cost_usd // 0' 2>/dev/null); cost=${cost:-0}
  tokens=$(printf '%s' "$result_json" | jq -r '
    ((.usage.input_tokens // 0) + (.usage.output_tokens // 0)
     + (.usage.cache_creation_input_tokens // 0) + (.usage.cache_read_input_tokens // 0))' 2>/dev/null)
  tokens=${tokens:-0}
  text=$(printf '%s' "$result_json" | jq -r '.result // ""' 2>/dev/null)
  is_error=$(printf '%s' "$result_json" | jq -r '.is_error // false' 2>/dev/null)

  # A non-zero exit or an is_error result (e.g. the item cap was hit) still
  # spent money: record the cost so the session budget stays honest, but mark
  # it failed so --resume retries it instead of skipping it forever.
  status=done
  case "$text" in
    *"GRIND_STATUS: carded"*)  status=carded ;;
    *"GRIND_STATUS: blocked"*) status=blocked ;;
  esac
  if [ "$claude_rc" -ne 0 ] || [ "$is_error" = true ]; then status=failed; fi

  # Check the claim. `blocked` asserts nothing about the world, so there is
  # nothing to check; `failed` is already a failure.
  unverified_why=""
  case "$status" in
    done)
      if [ "$prs" -eq 1 ]; then
        if ! verify_pr_fixup "$number" "$branch" "$wt_path" "$started_iso"; then
          unverified_why="no awaiting-human label, and no signed commit pushed to $branch"
          status=unverified
        fi
      elif ! verify_pr "$branch" "$started_iso"; then
        unverified_why="no PR opened or pushed to on head branch $branch"
        status=unverified
      fi
      ;;
    blocked)
      # Ordinarily `blocked` asserts nothing about the world. Under --prs it
      # does: the contract's stop rule says what giving up leaves behind, and
      # a PR given up on silently is indistinguishable from one nobody
      # touched -- which is exactly the state this mode exists to clear.
      if [ "$prs" -eq 1 ] && ! pr_labels "$number" | grep -qx fixup-hard; then
        unverified_why="gave up without labelling the PR fixup-hard"
        status=unverified
      fi
      ;;
    carded)
      if ! verify_carded "$number" "$marker" "$started_iso"; then
        unverified_why="board file unchanged and no new comment on the issue"
        status=unverified
      fi
      ;;
  esac
  rm -f "$marker"

  # An unverified item keeps its worktree: it is the only remaining record of
  # what the worker did, and the next attempt at this item clears it anyway.
  if [ "$status" = unverified ]; then
    warn "keeping worktree $wt_path on branch $branch for inspection"
  else
    git worktree remove -f "$wt_path" >/dev/null 2>&1 || true
  fi

  running_total=$(awk -v a="$running_total" -v b="$cost" 'BEGIN { printf "%.4f", a + b }')
  processed_this_run=$((processed_this_run + 1))
  jq --arg ref "$ref" --arg status "$status" --argjson cost "$cost" \
     '.items += [{ref:$ref, status:$status, cost:$cost}]' "$state_file" > "$state_file.tmp" \
     && mv "$state_file.tmp" "$state_file"

  percent=$(pct "$running_total" "$session_budget")
  if [ "$status" = failed ]; then
    # The result text is the only diagnosis there is (an auth failure, a
    # budget cap, an API error): first line, trimmed, so the FAILED line
    # says why and not just that.
    why=$(printf '%s' "$text" | sed -n '1p' | cut -c1-200)
    printf 'FAILED: %s -- %s -- worker reported an error: %s (%s, %s tokens, running %s / %s -- %s%%); will retry on --resume\n' \
      "$ref" "$title" "${why:-no result text}" "$(fmt_usd "$cost")" "$tokens" "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")" "$percent" >&2
  elif [ "$status" = unverified ]; then
    printf 'UNVERIFIED: %s -- %s -- worker claimed success but %s (%s, %s tokens, running %s / %s -- %s%%); will retry on --resume\n' \
      "$ref" "$title" "$unverified_why" "$(fmt_usd "$cost")" "$tokens" "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")" "$percent" >&2
  elif [ "$status" = carded ]; then
    printf 'carded: %s -- %s (%s, %s tokens, running %s / %s -- %s%%)\n' \
      "$ref" "$title" "$(fmt_usd "$cost")" "$tokens" "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")" "$percent"
  elif [ "$status" = blocked ]; then
    printf 'blocked: %s -- %s (%s, %s tokens, running %s / %s -- %s%%)\n' \
      "$ref" "$title" "$(fmt_usd "$cost")" "$tokens" "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")" "$percent"
  else
    printf '%s: %s -- %s, %s, %s tokens -- running %s / %s -- %s%%\n' \
      "$ref" "$title" "$model" "$(fmt_usd "$cost")" "$tokens" "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")" "$percent"
  fi

  # Independent checks so one item that crosses two lines announces both.
  if [ "$percent" -ge 25 ] && [ "$loud_25" -eq 0 ]; then
    loud_25=1; printf '*** 25%% of session budget spent (%s / %s) ***\n' "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")"
  fi
  if [ "$percent" -ge 50 ] && [ "$loud_50" -eq 0 ]; then
    loud_50=1; printf '*** 50%% of session budget spent (%s / %s) ***\n' "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")"
  fi
  if [ "$percent" -ge 75 ] && [ "$loud_75" -eq 0 ]; then
    loud_75=1; printf '*** 75%% of session budget spent (%s / %s) ***\n' "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")"
  fi

  # pause conditions, checked in this order: budget, outlier cost, cadence.
  reached_budget=$(awk -v a="$running_total" -v b="$session_budget" 'BEGIN { print (a >= b) ? 1 : 0 }')
  prior_median=$(median "$costs")
  outlier=$(awk -v c="$cost" -v m="$prior_median" 'BEGIN { print (m > 0 && c > 2 * m) ? 1 : 0 }')
  costs="$costs $cost"

  if [ "$reached_budget" -eq 1 ]; then
    printf 'pause: session budget reached (%s / %s). %d item(s) processed this run.\n' \
      "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")" "$processed_this_run"
    printf 'resume: %s\n' "$resume_cmd"
    finish
  fi
  if [ "$outlier" -eq 1 ]; then
    printf 'pause: %s cost %s, more than twice the running median (%s). %d item(s) processed this run.\n' \
      "$ref" "$(fmt_usd "$cost")" "$(fmt_usd "$prior_median")" "$processed_this_run"
    printf 'resume: %s\n' "$resume_cmd"
    finish
  fi
  if [ "$processed_this_run" -ge "$pause_every" ]; then
    printf 'pause: %d items processed this run (pause every %d). Running total %s / %s.\n' \
      "$processed_this_run" "$pause_every" "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")"
    printf 'resume: %s\n' "$resume_cmd"
    finish
  fi
done

if [ "$dry_run" -eq 1 ]; then
  exit 0
fi

printf 'done: %s exhausted. Running total %s / %s. %d skipped.\n' "$( [ "$prs" -eq 1 ] && printf 'PR queue' || printf 'Ready queue')" "$(fmt_usd "$running_total")" "$(fmt_usd "$session_budget")" "$skipped"
finish
