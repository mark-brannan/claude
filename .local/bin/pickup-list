#!/bin/sh
# pickup-list -- the pickup items across every session and the cards on the
# board's `## Claude's`, newest first, plus the agora docket count.
#
# Why: a hand-off that lives in a chat, a prose prompt or a block a model
# had to remember to write is lost the moment the session ends any other
# way. The Stop hook (stop-continuity.sh) writes one pickup item per
# session under state/global/pickup/, every Stop, from the transcript and
# git alone; the body is the hand-off a model may write over the hook's
# default, and an edited body survives every rewrite. This is the view
# over those items. Questions for Solace live on the board's `## Needs
# ruling` (the agora's docket) and are only counted here; Human's words
# live on the curia threads and are not listed at all.
#
#   pickup-list                 open items, newest first, top five
#   pickup-list --all           every open item
#   pickup-list --oldest        oldest first
#   pickup-list --closed        include taken and done items
#   pickup-list find <word>     items whose text or fields match (any status)
#   pickup-list show <id>       the item file
#   pickup-list take <id>       mark an item taken (a session picked it up)
#   pickup-list done|open <id>  set an item's status
#   pickup-list take|open <card> [<sid>]  claim or release a card by its id or link
#   pickup-list show <card id>  the card, any section, and its claims
#
# One file per item, written by each session's own Stop hook, so parallel
# sessions never conflict on push. Nothing here drops an item because it
# could not be checked: liveness is what the writer recorded, and a reader
# who wants the live state follows `where:` or `pr:`.
#
# CONVENIENCE: exit 0 on every read. A write that cannot land says so and
# exits 1, because a taken item still listed as open hands one session's
# work to two.
set -u

usage() { sed -n '15,24p' "$0" | sed 's/^#   \{0,1\}//'; }

self=$0
case $self in */*) ;; *) self=$(command -v "$self" 2>/dev/null || printf '%s' "$self") ;; esac
self_dir=$(cd "$(dirname "$self")" 2>/dev/null && pwd)
lib=""
for c in "$self_dir/../../.claude/hooks/lib-state.sh" "$HOME/.claude/hooks/lib-state.sh"; do
  [ -f "$c" ] && { lib=$c; break; }
done
[ -n "$lib" ] || { printf 'pickup-list: lib-state.sh not found\n' >&2; exit 1; }
# shellcheck disable=SC1090
. "$lib"
HOOK_DIR=$(dirname "$lib")

PICKUP="$(state_dir)/pickup"
BOARD="$(state_dir)/kanban.md"
now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
now_s=$(date -u +%s)

item_path() {  # item_path <id> -- the file, or fail; id chars only, no paths
  case "${1:-}" in
    ''|*[!A-Za-z0-9T-]*) printf 'pickup-list: no item %s\n' "${1:-<id>}" >&2; return 1 ;;
  esac
  [ -f "$PICKUP/$1.md" ] && { printf '%s' "$PICKUP/$1.md"; return 0; }
  printf 'pickup-list: no item %s\n' "$1" >&2; return 1
}

# set_field <file> <name> <value> -- rewrite one header line and bump updated.
set_field() {
  tmp="$1.$$"
  awk -v k="$2" -v v="$3" -v u="$now" '
    !d && index($0, k ":") == 1 { print k ": " v; next }
    !d && k != "updated" && index($0, "updated:") == 1 { print "updated: " u; next }
    /^---$/ { d = 1 } { print }
  ' "$1" > "$tmp" && mv -f "$tmp" "$1" || { rm -f "$tmp"; return 1; }
}

# card_text <id|link> -- the folded card on `## Claude's` whose id or link it
# is, or fail: only the agent's section holds pickup candidates.
card_text() {
  claude_cards "$BOARD" | cut -f2- | while IFS= read -r c; do
    r=$(work_record "$c")
    [ "$(printf '%s' "$r" | cut -d "$(printf '\037')" -f8)" = "$1" ] \
      || [ "$(printf '%s' "$r" | cut -d "$(printf '\037')" -f9)" = "$1" ] && { printf '%s\n' "$c"; break; }
  done | grep .
}

# --- writes ------------------------------------------------------------------
# A card is named by its `id:` (or, minted before ids, its link). Taking one
# is a claim on the card through claim-stamp.sh, keyed by its link, so a
# second session -- here or on another machine -- reads it taken; `open`
# releases every claim on it. A card is never `done` here: done work leaves
# the board when its line is deleted.
cmd=${1:-}
handle=${2:-}
card=0
is_card_id "$handle" && card=1
case "$handle" in http*|log/*|../*) card=1 ;; esac
if [ "$card" = 1 ]; then
  case "$cmd" in take|open|done|show)
    # shellcheck disable=SC2034 # read by work_record; a lookup needs no claims
    WORK_CLAIMS=""
    if [ "$cmd" = show ] && is_card_id "$handle"; then
      # any section: a ruling or click-work card is shown, never taken
      c=$(board_card "$BOARD" "$handle" | cut -f3-) || { printf 'pickup-list: no card %s on the board\n' "$handle" >&2; exit 1; }
    else
      c=$(card_text "$handle") || { printf 'pickup-list: no card on ## Claude'"'"'s with id or link %s\n' "$handle" >&2; exit 1; }
    fi
    link=$(work_record "$c" | cut -d "$(printf '\037')" -f8)
    case "$cmd" in
      take) sid=${3:-${CLAUDE_CODE_SESSION_ID:-}}
            [ -n "$sid" ] || { printf 'pickup-list take: no session id (pass one, or run inside a session)\n' >&2; exit 1; }
            sh "$HOOK_DIR/claim-stamp.sh" card-claim "$link" "$sid" || exit 1
            printf 'taken %s\n' "$handle" ;;
      open) sh "$HOOK_DIR/claim-stamp.sh" card-release "$link" || exit 1
            printf 'open %s\n' "$handle" ;;
      done) printf 'pickup-list done: a card is done when its line leaves the board\n' >&2; exit 1 ;;
      show) printf '%s\n' "$c"; [ -z "$link" ] || sh "$HOOK_DIR/claim-stamp.sh" card-claims "$link" ;;
    esac
    exit 0 ;;
  esac
fi
case "$cmd" in
  take|done|open)
    f=$(item_path "${2:-}") || exit 1
    case "$cmd" in take) st=taken ;; *) st=$cmd ;; esac
    set_field "$f" status "$st" || { printf 'pickup-list %s: write failed\n' "$cmd" >&2; exit 1; }
    printf '%s %s\n' "$st" "$(basename "$f" .md)"
    exit 0 ;;
  show)
    f=$(item_path "${2:-}") || exit 1
    cat "$f"; exit 0 ;;
  -h|--help|help) usage; exit 0 ;;
esac

# --- reads ---------------------------------------------------------------------
all=0; oldest=0; closed=0; brief=0; refresh=0; find_word=""
while [ $# -gt 0 ]; do
  case $1 in
    --all) all=1 ;;
    --oldest) oldest=1 ;;
    --closed) closed=1; all=1 ;;
    --brief) brief=1 ;;
    --_refresh) refresh=1 ;;
    find) find_word=${2:-}; [ -n "$find_word" ] || { printf 'pickup-list find: no word\n' >&2; exit 1; }
          closed=1; all=1; shift ;;
    *) printf 'pickup-list: unknown option %s\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

# --- PRs a fixer gave up on, first and always ---------------------------------
# A `fixup-hard` PR has had its cheap attempt spent and a human is otherwise
# its next reader, which outranks any item. One search, in pr-label-audit's
# shape and under its owner setting so the two cannot drift; review bots post
# after the fixer's handover comment, so the last human comment is shown.
# Cached an hour. --brief is the SessionStart path and its five seconds are
# already spent: it renders the cache and a detached --_refresh, which does
# only the search, refills it for the next brief. Printing nothing is always
# allowed -- the listing is the job.
run_t() { if command -v timeout >/dev/null 2>&1; then timeout 5 "$@"; else "$@"; fi; }
hard_cache=${XDG_CACHE_HOME:-$HOME/.cache}/pickup-list/fixup-hard; mkdir -p "${hard_cache%/*}" 2>/dev/null
fetch_hard() { run_t gh api graphql \
    -f q="is:pr is:open archived:false user:${PR_LABEL_AUDIT_OWNER:-mark-brannan} label:fixup-hard" \
    -f query='query($q:String!){search(query:$q,type:ISSUE,first:20){nodes{... on PullRequest{
      number url title repository{nameWithOwner} comments(last:10){nodes{author{__typename} body}}}}}}' \
    --jq '.data.search.nodes[] | "  - \(.repository.nameWithOwner)#\(.number) [hard] \(.title)\n    \(.url)\n    \(([.comments.nodes[] | select(.author.__typename != "Bot")] | last | .body // "no comment from the fixer") | split("\n")[0])"' \
    > "$hard_cache.tmp.$$" 2>/dev/null && mv -f "$hard_cache.tmp.$$" "$hard_cache" || rm -f "$hard_cache.tmp.$$"; }
[ "$refresh" = 1 ] && { fetch_hard; exit 0; }
if [ -z "$(find "$hard_cache" -mmin -60 2>/dev/null)" ] && command -v gh >/dev/null 2>&1; then
  if [ "$brief" = 0 ]; then fetch_hard
  elif command -v setsid >/dev/null 2>&1; then setsid nohup sh "$self" --_refresh >/dev/null 2>&1 </dev/null &
  else nohup sh "$self" --_refresh >/dev/null 2>&1 </dev/null & fi
fi
hard=$(cat "$hard_cache" 2>/dev/null) || hard=""
[ -n "$hard" ] && printf 'Hard -- a fixer gave up on these; take one before any item\n\n%s\n\n' "$hard"

# The agora docket is the board's `## Needs ruling`; one count, one drill path.
docket() {
  n=$(awk '/^## Needs ruling[[:space:]]*$/ { f = 1; next }
           f && /^## / { exit }
           f && /^- \[ \]/ { n++ }
           END { print n + 0 }' "$(state_dir)/kanban.md" 2>/dev/null)
  [ "${n:-0}" -gt 0 ] || return 0
  printf '\nDocket: %s awaiting an agora -- kanban.md `## Needs ruling`\n' "$n"
}

# One record per unit of work, from work_record (lib-state.sh): pickup items
# and the cards on `## Claude's` alike, so both render in one line shape.
sep=$(printf '\037')
work_claims_load
set -- "$PICKUP"/*.md; [ -f "$1" ] || set --
if [ -n "$find_word" ]; then
  for f; do shift; grep -qiF -- "$find_word" "$f" 2>/dev/null && set -- "$@" "$f"; done
fi
recs=$(claude_cards "$BOARD" | { if [ -n "$find_word" ]; then grep -iF -- "$find_word"; else cat; fi; } \
  | work_records --cards "$@" | awk -F "$sep" -v closed="$closed" 'closed || $3 == "open"')
[ -n "$recs" ] || { printf 'Pickup: none\n'; docket; exit 0; }

limit=5; [ "$all" = 1 ] && limit=100000
total=$(printf '%s\n' "$recs" | grep -c '^')

printf 'Pickup, newest first\n'
printf '%s\n' "$recs" | sort -t "$sep" -k10,10"$( [ "$oldest" = 1 ] || printf r )" \
  | awk -F "$sep" -v limit="$limit" -v total="$total" -v now="$now_s" '
  function padto(str, w) { while (length(str) < w) str = str " "; return str }
  function cut(str, w) { return length(str) > w ? substr(str, 1, w - 1) "\342\200\246" : str }
  function dash(str) { return str == "" ? "-" : str }
  # Age as one short token (4m, 3h, 6d) from an ISO time; days_from_civil, no date(1) per row.
  function age(t,   y, m, d, e, s) {
    if (t !~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]/) return "?"
    y = substr(t, 1, 4) + 0; m = substr(t, 6, 2) + 0; d = substr(t, 9, 2) + 0
    if (m <= 2) y--
    e = int(y / 400); s = y - e * 400
    s = s * 365 + int(s / 4) - int(s / 100) + int((153 * (m > 2 ? m - 3 : m + 9) + 2) / 5) + d - 1
    s = (e * 146097 + s - 719468) * 86400 + substr(t, 12, 2) * 3600 + substr(t, 15, 2) * 60 + substr(t, 18, 2)
    s = now - s; if (s < 0) s = 0
    if (s < 3600) return int(s / 60) "m"
    if (s < 172800) return int(s / 3600) "h"
    return int(s / 86400) "d"
  }
  # A link as a reader places it: owner/repo#n for an issue or PR, else its last path part.
  function short(u,   n, p) {
    if (u == "") return "-"
    if (match(u, /github\.com\/[^\/]+\/[^\/]+\/(pull|issues)\/[0-9]+/)) {
      n = split(substr(u, RSTART, RLENGTH), p, "/"); return p[3] "#" p[5]
    }
    sub(/[?#].*$/, "", u); sub(/\/$/, "", u); n = split(u, p, "/"); return cut(p[n], 24)
  }
  shown < limit {
    shown++
    title = $2; if (title == "") title = "(no text)"
    tail = short($8)
    if ($3 != "open") tail = tail " \302\267 " $3 ($5 != "" ? " by " $5 : "")
    printf "  %s %s  %s  %s  %s  %s  %s\n", ($1 == "card" ? "\342\227\206" : "\342\227\217"),
      padto(cut(title, 56), 56), padto($10 == "" ? "-" : age($10), 4), padto(dash($6), 6), padto(dash($7), 6),
      padto(cut(dash($4), 12), 12), tail
    printf "    %s\n", $9
  }
  END {
    if (total > shown) printf "  \342\200\246 %d more \302\267 pickup-list --all \302\267 pickup-list --oldest \302\267 pickup-list find <word>\n", total - shown
  }
'
docket
exit 0
