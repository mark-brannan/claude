{
  "state_repo": {
    "github": "mark-brannan/claude_prompts_scratch",
    "search": ["/home/user", "/workspace", "~", "~/src", "~/Projects", "~/code"]
  },
  "clone_sync": {
    "clones": {"~/workshop": "upstream", "~/home-automation": "keep", "~/symphony": "keep"}
  },
  "live_clone": {
    "wedged_after_minutes": 5,
    "warn_behind_minutes": 10,
    "repair_behind_minutes": 30,
    "repair_behind_commits": 20,
    "repair_every_minutes": 30,
    "repos": {
      "mark-brannan/claude": {"git": ["-C", "~/.claude"]},
      "mark-brannan/dotfiles": {"git": ["--git-dir", "~/.local/share/yadm/repo.git"]},
      "mark-brannan/languette": {"git": ["-C", "~/languette"], "plugin": "languette@languette"}
    }
  },
  "plan": {
    "week_usd": 2000,
    "fable_week_usd": 510,
    "resets": "Tuesday 14:00 UTC",
    "source": "estimated: /usage on 2026-11-05 showed $947 priced at 47% of the all-models week and Fable's $253 at 50% of its own"
  }
}
