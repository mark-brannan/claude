{
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false",
    "showThinkingSummaries": true,
    "FORCE_AUTOUPDATE_PLUGINS": "1",
    "CLAUDE_CODE_REPORT_FINDINGS": "1",
    "PROSE_BUDGET": "/home/solace/.claude/bin/prose-budget"
  },
  "permissions": {
    "allow": [
      "Bash(systemctl --user list-timers *)",
      "Bash(systemctl --user show *)",
      "Bash(git rev-list *)",
      "Bash(git config core.hooksPath)",
      "Bash(git add :*)",
      "Bash(git branch -D claude/*)",
      "Bash(git branch -d claude/*)",
      "Bash(git commit :*)",
      "Bash(git fetch *)",
      "Bash(git merge-base *)",
      "Bash(gh-resolve-thread:*)",
      "Bash(npm run generate:check)",
      "Bash(npm run typecheck)",
      "Bash(npm test)",
      "Bash(worklist *)",
      "Bash(gh search *)",
      "Bash(shellcheck *)",
      "Bash(yadm log *)",
      "Bash(~/.claude/bin/agent-decision *)",
      "Bash(~/.claude/bin/card-id *)",
      "Bash(~/.claude/bin/pickup-list find *)",
      "Bash(~/.claude/bin/scoping-lock check *)",
      "Bash(~/.claude/bin/pickup-list)",
      "Bash(~/.claude/bin/pickup-list *)",
      "Bash(~/.claude/bin/pickup-list --all)",
      "Bash(~/.claude/bin/pickup-list --oldest)",
      "Bash(~/.claude/bin/pickup-list --closed)",
      "Bash(~/.claude/bin/pickup-list show *)",
      "Bash(~/.claude/bin/pr-blockers *)",
      "Bash(~/.claude/bin/prose-budget *)",
      "Bash(~/.claude/bin/worklist)",
      "Bash(~/.claude/bin/worklist *)",
      "Bash(~/.claude/bin/work-item *)",
      "Bash(/home/solace/.claude/bin/work-item *)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Skill(mergify:mergify-stack)"
    ],
    "additionalDirectories": [
      "~/claude_prompts_scratch"
    ]
  },
  "claudeMdExcludes": [
    "/home/*/CLAUDE.md",
    "/Users/*/CLAUDE.md",
    "/root/CLAUDE.md",
    "**/claude/CLAUDE.md",
    "**/claude/.claude/worktrees/*/CLAUDE.md",
    "**/grind-worktrees/claude/*/CLAUDE.md"
  ],
  "disableClaudeAiConnectors": true,
  "deniedMcpServers": [
    {
      "serverName": "Intuit_QuickBooks"
    },
    {
      "serverName": "Intuit_TurboTax"
    },
    {
      "serverName": "CourtListener"
    },
    {
      "serverName": "Courtroom5"
    },
    {
      "serverName": "Legal_Data_Hunter"
    },
    {
      "serverName": "LegalZoom"
    },
    {
      "serverName": "Gmail"
    },
    {
      "serverName": "Google_Drive"
    },
    {
      "serverName": "Google_Calendar"
    },
    {
      "serverName": "Evernote_MCP"
    },
    {
      "serverName": "Audible"
    },
    {
      "serverName": "Autodesk_Product_Help"
    },
    {
      "serverName": "DocuSeal"
    },
    {
      "serverName": "Docusign"
    },
    {
      "serverName": "Dropbox"
    },
    {
      "serverName": "Harvey"
    },
    {
      "serverName": "IFTTT"
    },
    {
      "serverName": "Lucid"
    },
    {
      "serverName": "Postman"
    },
    {
      "serverName": "PubMed"
    },
    {
      "serverName": "Scholar_Gateway"
    },
    {
      "serverName": "SignNow"
    },
    {
      "serverName": "Spotify"
    },
    {
      "serverName": "Superhuman_Docs"
    },
    {
      "serverName": "Taskrabbit_Booking_Assistance"
    },
    {
      "serverName": "Todoist"
    },
    {
      "serverName": "Trello"
    },
    {
      "serverName": "Zapier"
    }
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "in=$(cat); [ -n \"${SPEND_GATE_USD:-}${SPEND_GATE_TOKENS:-}\" ] || exit 0; h=\"$HOME/.claude/hooks/spend-gate.py\"; { [ -f \"$h\" ] && printf '%s' \"$in\" | python3 \"$h\"; } && exit 0; o=\"${SPEND_GATE_HANDOFF:-HANDOFF.md}\"; f=$(printf '%s' \"$in\" | tr -d '\\n' | sed -n 's/.*\"file_path\" *: *\"\\([^\"]*\\)\".*/\\1/p'); c=$(printf '%s' \"$in\" | tr -d '\\n' | sed -n 's/.*\"cwd\" *: *\"\\([^\"]*\\)\".*/\\1/p'); case \"$in\" in *'\"tool_name\":\"Write\"'*|*'\"tool_name\": \"Write\"'*|*'\"tool_name\":\"Read\"'*|*'\"tool_name\": \"Read\"'*) case \"$f\" in *'/../'*) ;; \"${c:-/nonexistent}\"/*) [ \"${f##*/}\" = \"$o\" ] && exit 0 ;; esac ;; esac; printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"spend-gate.py is missing from $HOME/.claude/hooks or crashed while a spend or context line is set, so the line could not be checked. Every tool is denied except a Read or Write of %s. Write the hand-off (what is done, what is next, how to resume) there and end the turn; the hook comes back with dotsync (or cloud-session-setup.sh).\"}}\\n' \"$o\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/no-unsigned-push.py\"; { [ -f \"$h\" ] && python3 \"$h\"; } || printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"no-unsigned-push.py is missing from $HOME/.claude/hooks or crashed, so unsigned commits could not be checked. This is a gate and fails closed: run dotsync (or cloud-session-setup.sh) and retry.\"}}'",
            "statusMessage": "Checking for unsigned commits"
          }
        ]
      },
      {
        "matcher": "mcp__claude-code-remote__add_repo",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/guard-add-repo.py\"; [ -f \"$h\" ] && python3 \"$h\"; true"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(send_later|create_trigger)",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/no-persistent-polling.py\"; [ -f \"$h\" ] && python3 \"$h\" || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/npm-publish-auth.py\"; [ -f \"$h\" ] && python3 \"$h\" || true",
            "timeout": 5,
            "statusMessage": "Checking that npm publish goes through npm-publish-bg"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*__update_pull_request_branch",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/no-update-branch.py\"; [ -f \"$h\" ] && python3 \"$h\" || true"
          }
        ]
      },
      {
        "matcher": "mcp__.*__subscribe_pr_activity",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/no-late-pr-subscribe.py\"; [ -f \"$h\" ] && python3 \"$h\" || true"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*github.*__.*",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/pr-ownership-context.py\"; [ -f \"$h\" ] && python3 \"$h\" || true",
            "statusMessage": "Loading the PR ownership rules"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); [ \"$(printf '%s' \"$p\" | jq -r '.stop_hook_active // false' 2>/dev/null)\" = true ] && exit 0; h=\"$HOME/.claude/hooks/pr-threads-gate.py\"; { [ -f \"$h\" ] && printf '%s' \"$p\" | python3 \"$h\"; } || printf '%s\\n' '{\"decision\":\"block\",\"reason\":\"pr-threads-gate.py is missing from $HOME/.claude/hooks or crashed, so review threads on the PR this session worked could not be re-checked. This is a gate and fails closed: if you touched a PR this session, state per thread id which are resolved and which are open, then end the turn again.\"}'",
            "timeout": 60,
            "statusMessage": "Re-checking review threads on PRs this session touched"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); h=\"$HOME/.claude/hooks/branch-home-gate.py\"; { [ -f \"$h\" ] && printf '%s' \"$p\" | python3 \"$h\"; } || { if command -v jq >/dev/null 2>&1; then active=$(printf '%s' \"$p\" | jq -r '.stop_hook_active // false' 2>/dev/null); else active=false; printf '%s' \"$p\" | grep -q '\"stop_hook_active\"[[:space:]]*:[[:space:]]*true' && active=true; fi; [ \"$active\" = true ] || printf '%s\\n' '{\"decision\":\"block\",\"reason\":\"branch-home-gate.py is missing from $HOME/.claude/hooks, python3 is missing, or the hook crashed, so the branch this session worked could not be checked for a PR or a pointer card. This is a gate and fails closed: run dotsync (or cloud-session-setup.sh) and retry; if the branch is ahead of the default branch, open the PR or file a pointer card naming the branch and what it holds, then end the turn again.\"}'; }",
            "timeout": 60,
            "statusMessage": "Checking this branch has a PR or a pointer card"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/stop-sequence.py\"; [ -f \"$h\" ] && python3 \"$h\" 2>/dev/null || true",
            "timeout": 330,
            "statusMessage": "Saving the session, then checking it against the nag thresholds"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/no-prose-gate.py\"; [ -f \"$h\" ] && python3 \"$h\"; true",
            "timeout": 30,
            "statusMessage": "Checking the turn does not end asking permission"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/metrics-live.py\"; [ -f \"$h\" ] && python3 \"$h\" posttooluse 0 show || true"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/curia-roll.py\"; [ -f \"$h\" ] && python3 \"$h\" 2>/dev/null; true"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/prose-budget-edit.py\"; [ -f \"$h\" ] && python3 \"$h\" || true"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/scratch-mirror.py\"; [ -f \"$h\" ] && python3 \"$h\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*__(create_pull_request|merge_pull_request|update_pull_request|update_pull_request_branch|push_files|create_or_update_file|delete_file|create_branch|create_repository|fork_repository)",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/measure-git-events.py\"; [ -f \"$h\" ] && python3 \"$h\"; true"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/log-commit.py\"; [ -f \"$h\" ] && python3 \"$h\"; true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/log-gh-writes.py\"; [ -f \"$h\" ] && python3 \"$h\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/permission-request-log.py\"; [ -f \"$h\" ] && python3 \"$h\" 2>/dev/null || true"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/metrics-live.py\"; [ -f \"$h\" ] && python3 \"$h\" subagentstop 0 show || true"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/release-subagent-branch.py\"; [ -f \"$h\" ] && python3 \"$h\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/session-start-seed-refresh.py\"; [ -f \"$h\" ] && python3 \"$h\" || true",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/claim-stamp.py\"; [ -f \"$h\" ] && python3 \"$h\" session-start || true",
            "timeout": 30,
            "statusMessage": "Claiming this branch on its card"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/session-start-continuity.py\"; [ -f \"$h\" ] && python3 \"$h\" || true"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/connector-budget.py\"; [ -f \"$h\" ] && python3 \"$h\" || true"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/session-start-sync-status.py\"; [ -f \"$h\" ] && python3 \"$h\" || true",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/session-start-hook-errors.py\"; [ -f \"$h\" ] && python3 \"$h\" || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/metrics-live.py\"; [ -f \"$h\" ] && python3 \"$h\" prompt 0 show || true"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/curia-roll.py\"; [ -f \"$h\" ] && python3 \"$h\" 2>/dev/null; true"
          },
          {
            "type": "command",
            "timeout": 30,
            "command": "h=\"$HOME/.claude/hooks/pr-blockers-prompt.py\"; [ -f \"$h\" ] && python3 \"$h\"; true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 \"$HOME/.claude/hooks/statusline-metrics.py\""
  },
  "enabledPlugins": {
    "discord@claude-plugins-official": false,
    "signalk-registry@sailingnaturali": false,
    "github@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "mergify@claude-plugins-official": true,
    "languette@languette": true
  },
  "extraKnownMarketplaces": {
    "sailingnaturali": {
      "source": {
        "source": "github",
        "repo": "sailingnaturali/claude-skills"
      }
    },
    "languette": {
      "source": {
        "source": "github",
        "repo": "mark-brannan/languette"
      },
      "autoUpdate": true
    }
  },
  "autoMode": {
    "allow": [
      "$defaults",
      "Creating, editing or commenting on a GitHub issue in a mark-brannan repo (gh issue create/edit/comment, or the GitHub MCP issue tools) is allowed when the user, at any earlier point in this session, asked for an issue, agreed an issue was the right home for the work, or approved a drafted one, or when the issue is the one the session was started to work on. The go-ahead need not be the latest user turn and need not repeat \"file it\". Block it when nothing the user said in this session indicated an issue was wanted.",
      "Replying to review threads on a pull request in a mark-brannan repo (gh api POST to that PR's pulls/comments/<id>/replies, or the GitHub MCP review-thread reply tools) is allowed when the session is working that PR: it opened the PR, was started to work it, or the user asked it to address its review. Block it on a PR the session is not working. Resolving a thread goes through gh-resolve-thread; block a raw gh api graphql call that resolves one."
    ]
  },
  "theme": "dark",
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "pluginConfigs": {
    "languette@languette": {
      "options": {
        "redacted_terms_file": "~/claude_prompts_scratch/state/global/redacted-terms.tsv",
        "blocked_terms_file": "~/claude_prompts_scratch/state/global/blocked-terms.tsv",
        "private_repos": "mark-brannan/claude_prompts_scratch",
        "guard_worktrees": true,
        "guard_worktrees_foreign": false,
        "record_decisions": true
      }
    }
  }
}
