# Push state-repo commits the Stop hook's debounce left behind (see the
# timer). Offline and silent when the clone is level with origin.

[Unit]
Description=Push unpushed state-repo commits

[Service]
Type=oneshot
Environment=PATH=%h/.claude/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.claude/bin/state-push
StateDirectory=state-push
StandardOutput=append:%S/state-push/timer.log
StandardError=append:%S/state-push/timer.log
# Measured 4.5s pushing one commit on NucBoxK12, 2026-11-10; the rest is the
# up-to-90s wait for the push lock while a Stop holds it.
TimeoutStartSec=2m
