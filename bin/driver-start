#!/usr/bin/env python3
# driver-start -- start a batch's driver on its own: one background session on
# this box that runs `/pickup <parent-id>`, with Remote Control on so the user
# can open it from the Claude Desktop app, claude.ai/code or a phone, and
# nothing to paste. Scoping's §6 runs it on the yes.
#
#   driver-start [--cwd <dir>] [--wait <seconds>] [--relay] <parent-id>
#
# Refused (exit 1) when the parent cannot be read, or its log already carries
# `driver_session=`: one driver per yes. Otherwise it runs
#
#   claude --bg --remote-control "Driver <parent-id>" -n "Driver <parent-id>"
#          [--model <m>] [--effort <e>] "/pickup <parent-id>"
#
# in --cwd (default: here), with the model and effort the parent's create
# line names, when it names them; the permission mode is settings.json's. It
# logs `driver_session=<session uuid>` on the parent, then waits up to --wait
# seconds (default 45) for the session's claude.ai/code link, and prints how
# to attach. A link that never shows is said, never a failure: the session
# is running and listed by name. Exit 2 on bad arguments; a `claude --bg`
# that fails passes its code through; a driver_session that cannot be logged
# exits 1 after the attach lines, since the session is already running.
#
# --relay is the one way past that refusal: a driver at about 100k context
# hands the batch to a successor. It is allowed only from the session that
# holds the parent (`work-item fold` holder, CLAUDE_CODE_SESSION_ID), so
# there is still one live driver, however the driver was started. It
# releases the parent (the successor's /pickup claims it), starts the
# successor as above, under the same name plus " relay N", and logs its
# `driver_session=`; the newest line wins. If the successor cannot start,
# the parent is claimed again, or, when that is refused, the claim command is
# said on stderr. The old driver ends after it, with no hand-off to write.
# confer-start reuses start() for the agora's confer sessions.
#
# The name, <name>, is "Driver <parent-id>: <slug> <date>", so the session list
# says what the batch is about: <slug> is --about (what scoping planned, in
# a few words) or else the parent's title, made a short slug; <date> is the
# day the parent was filed.
import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time

sys.dont_write_bytecode = True

HERE = os.path.dirname(os.path.realpath(__file__))
WORK_ITEM = os.path.join(HERE, "work-item")
ANSI = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]|\x1b[78]")
LINK = re.compile(r"https://claude\.ai/code/session_[A-Za-z0-9]+")


def die(msg, code=1):
    sys.stderr.write("%s: %s\n" % (os.path.basename(sys.argv[0]), msg))
    sys.exit(code)


def parent_facts(parent):
    """The parent's item text, and the model and effort its create line names."""
    r = subprocess.run([WORK_ITEM, "show", parent], text=True, capture_output=True)
    if r.returncode:
        die("cannot read work item %s: %s" % (parent, r.stderr.strip() or "work-item failed"))
    facts = {}
    m = re.search(r"^\S+ \S+ status=open .*$", r.stdout, re.M)
    for key in ("model", "effort"):
        v = re.search(r"\b%s=(\S+)" % key, m.group(0)) if m else None
        if v and v.group(1) != "-":
            facts[key] = v.group(1)
    return r.stdout, facts


DATE = re.compile(r"\b\d{4}-\d{2}-\d{2}\b")
SLUG_MAX = 40


def slug(words):
    """<words> lower-cased and hyphenated, cut at a word to SLUG_MAX."""
    s = re.sub(r"[^a-z0-9]+", "-", words.lower()).strip("-")
    if len(s) > SLUG_MAX:
        s = s[:SLUG_MAX + 1].rsplit("-", 1)[0] if "-" in s[:SLUG_MAX + 1] else s[:SLUG_MAX]
    return s


def about_of(text, about):
    """What the batch is about: --about, else the parent's title."""
    if not about:
        title = re.search(r"^# (.+)$", text, re.M)
        about = DATE.sub(" ", title.group(1)) if title else ""
        about = re.sub(r"^\s*drive( the)?\b", "", about, flags=re.I)
    return about


def session_name(parent, text, about):
    """Driver <parent>: <slug> <date>, each part left out when it is empty."""
    about = about_of(text, about)
    filed = re.search(r"^(\d{4}-\d{2}-\d{2})T\S+ \S+ status=open\b", text, re.M)
    tail = " ".join(x for x in (slug(about), filed.group(1) if filed else "") if x)
    return "Driver %s: %s" % (parent, tail) if tail else "Driver %s" % parent


def session_uuid(short):
    """The full session id `claude agents --json` lists for <short>, or ""."""
    r = subprocess.run(["claude", "agents", "--json"], text=True, capture_output=True)
    try:
        rows = json.loads(r.stdout) if r.returncode == 0 else []
    except ValueError:
        rows = []
    for row in rows if isinstance(rows, list) else []:
        if isinstance(row, dict) and row.get("id") == short:
            return row.get("sessionId") or ""
    return ""


def remote_link(short, wait):
    """The session's claude.ai/code link from its terminal output, or ""."""
    end = time.monotonic() + wait
    while True:
        r = subprocess.run(["claude", "logs", short], text=True, capture_output=True)
        m = LINK.search(ANSI.sub("", r.stdout or ""))
        if m:
            return m.group(0)
        left = end - time.monotonic()
        if left <= 0:
            return ""
        time.sleep(min(2.0, left))


def held_by(text, key):
    """The newest `<key>=` value in <text>'s log, or ""."""
    found = re.findall(r"\b%s=(\S+)" % re.escape(key), text)
    return found[-1] if found else ""


def reclaim(item, relay):
    """A relay whose successor never started: the old driver takes the parent back."""
    if relay:
        r = subprocess.run([WORK_ITEM, "claim", item], text=True, capture_output=True)
        if r.returncode:
            sys.stderr.write("%s: could not claim %s back: %s; run work-item claim %s\n"
                             % (os.path.basename(sys.argv[0]), item, r.stderr.strip(), item))


def check_relay(item):
    """Die unless the caller holds <item>: the claim, as the session hook
    reads it, decides who is the driver."""
    r = subprocess.run([WORK_ITEM, "fold", item], text=True, capture_output=True)
    holder = re.search(r"^holder=(\S*)", r.stdout, re.M)
    me = os.environ.get("CLAUDE_CODE_SESSION_ID", "").replace("-", "")[:8].lower()
    if not me or not holder or holder.group(1) != me:
        die("only the session holding %s may relay, not %s" % (item, me or "no session"))


def start(item, text, name, prompt, key, facts, cwd, wait, relay=False, extra=""):
    """Start one background session named <name> running <prompt> in <cwd>,
    log `<key>=<session uuid>` on <item>, and print how to attach. Refused
    when <text> already carries <key>=, unless <relay> and the caller is the
    session it names. Returns the exit code."""
    held = held_by(text, key)
    if held and not relay:
        die("%s already has one, session %s: one session per yes" % (item, held))

    cmd = ["claude", "--bg", "--remote-control", name, "-n", name]
    for k in ("model", "effort"):
        if facts.get(k):
            cmd += ["--" + k, facts[k]]
    cmd.append(prompt)
    print("$ " + shlex.join(cmd), flush=True)
    r = subprocess.run(cmd, text=True, capture_output=True, cwd=cwd)
    if r.returncode:
        sys.stderr.write(r.stdout + r.stderr)
        reclaim(item, relay)
        die("claude --bg failed", r.returncode)
    m = re.search(r"backgrounded\W+([0-9a-f]{8})", ANSI.sub("", r.stdout))
    if not m:
        sys.stderr.write(r.stdout)
        reclaim(item, relay)
        die("claude --bg printed no session id; `claude agents` lists what runs")
    short = m.group(1)

    sid = session_uuid(short) or short
    w = subprocess.run([WORK_ITEM, "log", item, "%s=%s" % (key, sid)] + extra.split(),
                       text=True, capture_output=True)
    if w.returncode:
        sys.stderr.write("%s: %s not logged on %s: %s\n"
                         % (os.path.basename(sys.argv[0]), key, item, w.stderr.strip()))

    link = remote_link(short, wait)
    print("%s started: %s, session %s" % (name.split()[0].lower(), name, sid))
    print("  Claude Desktop: the session list, \"%s\"" % name)
    print("  browser:        %s" % (link or "claude.ai/code, \"%s\" (no link yet)" % name))
    print("  this terminal:  claude attach %s" % short)
    return 1 if w.returncode else 0


def check_args(a, item):
    if not re.fullmatch(r"[0-9a-f]+", item):
        die("not a work-item id: %r" % item, 2)
    if not os.path.isdir(a.cwd):
        die("no such directory: %s" % a.cwd, 2)


def main():
    ap = argparse.ArgumentParser(prog="driver-start")
    ap.add_argument("parent")
    ap.add_argument("--cwd", default=os.getcwd())
    ap.add_argument("--wait", type=float, default=45.0)
    ap.add_argument("--about", default="")
    ap.add_argument("--relay", action="store_true")
    a = ap.parse_args()
    check_args(a, a.parent)
    text, facts = parent_facts(a.parent)
    # The batch's name rides on the log, so a successor keeps it.
    kept = re.findall(r"\bdriver_about=(\S+)", text)
    about = a.about or (kept[-1] if a.relay and kept else "")
    name = session_name(a.parent, text, about)
    kept_slug = slug(about_of(text, about))
    extra = "driver_about=%s" % kept_slug if kept_slug else ""
    if a.relay:
        name += " relay %d" % max(1, len(re.findall(r"\bdriver_session=", text)))
    prompt = "/pickup %s" % a.parent
    if not a.relay:
        return start(a.parent, text, name, prompt, "driver_session", facts, a.cwd, a.wait,
                     extra=extra)
    check_relay(a.parent)
    # The successor's /pickup claims the parent, so the old driver lets go
    # first; a successor that never starts hands the claim back.
    r = subprocess.run([WORK_ITEM, "release", a.parent], text=True, capture_output=True)
    if r.returncode:
        die("cannot release %s: %s" % (a.parent, r.stderr.strip() or "work-item failed"))
    return start(a.parent, text, name, prompt, "driver_session", facts, a.cwd, a.wait,
                 True, extra)


if __name__ == "__main__":
    sys.exit(main())
