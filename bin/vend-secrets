#!/usr/bin/env python3
# vend-secrets: set the GitHub Actions secrets the shared review workflow
# needs on every vended repo, from the local env files yadm bootstrap writes.
#
#   CLAUDE_CODE_OAUTH_TOKEN  the review itself      ~/.config/secrets/claude-token.env
#   AGENT_BOT_APP_ID         the fixer's App token  ~/.config/secrets/agent-bot.env
#   AGENT_BOT_PRIVATE_KEY    the same, as PEM       (decoded from AGENT_BOT_PRIVATE_KEY_B64)
#
# Usage: vend-secrets [--repo NAME]... [--only SECRET]... [--dry-run]
#
# Repos default to ~/.local/share/vended-repos.txt, read fresh. Values go to
# `gh secret set` on stdin, never on a command line, and are never printed.
# Rerun to rotate: setting a secret overwrites it. Exit 1 when any set
# fails, 2 on usage or a missing env file or key.
import argparse
import base64
import os
import subprocess
import sys

NAME = "vend-secrets"
OWNER = "mark-brannan"
SECRETS_DIR = os.path.expanduser("~/.config/secrets")
REPO_LIST = os.path.expanduser("~/.local/share/vended-repos.txt")

# secret name -> (env file, env key, decode)
SOURCES = {
    "CLAUDE_CODE_OAUTH_TOKEN": ("claude-token.env", "CLAUDE_CODE_OAUTH_TOKEN", None),
    "AGENT_BOT_APP_ID": ("agent-bot.env", "AGENT_BOT_APP_ID", None),
    "AGENT_BOT_PRIVATE_KEY": ("agent-bot.env", "AGENT_BOT_PRIVATE_KEY_B64", "base64"),
}


def parse_env(text):
    """KEY=value lines of a shell env file; `export`, comments and quotes allowed."""
    out = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        if line.startswith("export "):
            line = line[len("export "):].lstrip()
        key, _, value = line.partition("=")
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        out[key.strip()] = value
    return out


def read_repos(text):
    return [r.strip() for r in text.splitlines() if r.strip() and not r.lstrip().startswith("#")]


def resolve(names, secrets_dir=SECRETS_DIR):
    """{secret: value} for the names asked, or exit 2 naming what is missing."""
    cache, values = {}, {}
    for name in names:
        fname, key, decode = SOURCES[name]
        path = os.path.join(secrets_dir, fname)
        if path not in cache:
            try:
                with open(path) as f:
                    cache[path] = parse_env(f.read())
            except OSError as e:
                sys.exit("%s: %s: %s" % (NAME, path, e.strerror))
        if not cache[path].get(key):
            sys.exit("%s: %s has no %s" % (NAME, path, key))
        value = cache[path][key]
        if decode == "base64":
            value = base64.b64decode(value).decode()
            if not value.startswith("-----BEGIN"):
                sys.exit("%s: %s in %s does not decode to a PEM key" % (NAME, key, path))
        values[name] = value
    return values


def main(argv=None):
    p = argparse.ArgumentParser(prog=NAME, description="Set the review workflow's secrets on the vended repos.")
    p.add_argument("--repo", action="append", help="a repo name under %s; repeatable (default: the vended list)" % OWNER)
    p.add_argument("--only", action="append", choices=sorted(SOURCES), help="one secret; repeatable (default: all three)")
    p.add_argument("--dry-run", action="store_true", help="print what would be set; read no values")
    a = p.parse_args(argv)

    if a.repo:
        repos = a.repo
    else:
        try:
            with open(REPO_LIST) as f:
                repos = read_repos(f.read())
        except OSError as e:
            sys.exit("%s: %s: %s" % (NAME, REPO_LIST, e.strerror))
    names = a.only or list(SOURCES)

    if a.dry_run:
        for r in repos:
            print("%s/%s  %s" % (OWNER, r, " ".join(names)))
        return 0

    values = resolve(names)
    failed = 0
    for r in repos:
        for name in names:
            res = subprocess.run(["gh", "secret", "set", name, "-R", "%s/%s" % (OWNER, r)],
                                 input=values[name], text=True, capture_output=True)
            ok = res.returncode == 0
            failed += not ok
            print("%-4s %s/%s %s%s" % ("ok" if ok else "FAIL", OWNER, r, name,
                                       "" if ok else "  " + res.stderr.strip()))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
