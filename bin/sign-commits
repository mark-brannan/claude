#!/usr/bin/env python3
# sign-commits -- re-sign a branch's unsigned commits and push it, by hand.
#
#   sign-commits [branch] [-n | --dry-run]
#   sign-commits <owner/repo#n | PR URL | n> [-n | --dry-run]
#
# The PR form is the one to reach for when GitHub says "Commits must have
# verified signatures": it reads the PR's head and base from GitHub, works in
# a throwaway worktree on a scratch branch at origin/<head>, and pushes back
# to <head> under a lease on the sha it fetched. No local branch is read or
# moved, so a stale local copy cannot brief as signed, and a worktree that
# still holds the branch -- a dead session's, say -- is not in the way. Run
# it from a clone of the PR's repo, or from anywhere when the clone is at
# ~/<repo>. A PR from a fork is refused: its head is not on origin.
#
# For a person at a shell, on the machine that holds the signing key, when a
# PR is blocked on unsigned commits. The agents' gate, hooks/no-unsigned-push.py,
# refuses the push and says to run `lib/state.py branch_brief` and do what
# its `recommend:` line says; this does that, so the person need not read the
# brief first and remember which git invocation is safe for the branch's shape.
#
# The remedy is decided in one place, branch_brief (claude#329), never here:
# this runs its recommendation when that is a signing rebase or amend, and for
# anything else -- a conflict, a hand-resolved merge a rebase would drop, no
# signing key on this machine, a base git cannot see -- prints the
# recommendation and stops. The retired resign-branch.sh chose its own remedy,
# and 11 of its 12 October runs rebased a branch merely to update it
# (git-stuff curia, 2026-10-26); that is why this one chooses nothing.
#
# Steps, in order:
#   1. `git fetch --quiet origin`. branch_brief never fetches, and a plan made
#      against a stale origin/<base> counts the base's newer commits as the
#      branch's own; re-signing them makes duplicates, and the force-push
#      sends them into the PR (dotfiles#583 review).
#   1b. Bring the local branch to origin/<branch>, the PR's head: fast-forward
#      when it is merely behind (a bot or another machine pushed), stop when
#      the two have diverged. branch_brief reads the local branch, and a stale
#      one briefs as signed while the PR is blocked (colregs-mcp#75).
#   2. Print the brief in full, so the facts the command rests on are on screen.
#   3. On the checked-out branch, run the recommended command, which signs with
#      the key git is configured for (a passphrase prompt comes through).
#   4. `git push --force-with-lease origin <branch>`, the lease taken from the
#      fetch in step 1.
# --dry-run stops after step 2 and prints what 3 and 4 would run.
#
# A tool for the person, not an allow rule for agents: no settings.json rule
# names it, so an agent that tries it is judged like any other push.
#
# Exit: 0 pushed, or nothing to re-sign; 1 the brief recommends something this
# does not run by itself, the branch is not the one checked out, or a step
# failed; 2 usage.
import json
import os
import re
import shlex
import tempfile
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
                os.path.expanduser("~/.claude/lib")]  # lib/libpath.py
try:
    import state  # noqa: E402
except ImportError:
    sys.stderr.write("sign-commits: lib/state.py not found (looked beside the tool and in ~/.claude/lib)\n")
    sys.exit(2)

USAGE = "usage: sign-commits [branch | owner/repo#n | PR URL | n] [-n | --dry-run]\n"

# The recommendation forms this runs. Anything else is for a person to read.
RUNS = ("git rebase -S ", "git commit --amend -S ")


def recommendation(brief):
    """(command, whole line) from a brief's `recommend:` line; the command is
    the part before branch_brief's `   # ...` note, or '' when there is none."""
    for ln in brief.split("\n"):
        if ln.startswith("recommend: "):
            rec = ln[len("recommend: "):]
            return rec.split("   #", 1)[0].strip(), rec
    return "", ""


PR_RE = re.compile(r"^(?:https://github\.com/)?(?:([\w.-]+)/([\w.-]+)(?:#|/pull/))?#?(\d+)/?$")


def origin_slug(root):
    """owner/repo of root's origin, lower-cased, or '' when it is not GitHub."""
    p = subprocess.run(["git", "-C", root, "remote", "get-url", "origin"], text=True, capture_output=True)
    m = re.search(r"github\.com[:/]([^/]+)/(.+?)(?:\.git)?/?$", p.stdout.strip()) if p.returncode == 0 else None
    return f"{m.group(1)}/{m.group(2)}".lower() if m else ""


def sign_pr(spec, dry, cwd=None, brief=state.branch_brief, run=subprocess.run, out=sys.stdout, err=sys.stderr,
            gh=None, home=None):
    """The PR form: brief and re-sign origin/<head> in a throwaway worktree,
    push to <head> leased on the fetched sha, remove the worktree."""
    m = PR_RE.match(spec)
    owner, repo, num = m.groups()

    def git(root, *a):
        return subprocess.run(["git", "-C", root, *a], text=True, capture_output=True)

    here = git(cwd or ".", "rev-parse", "--show-toplevel")
    here = here.stdout.strip() if here.returncode == 0 else ""
    if owner:
        slug = f"{owner}/{repo}".lower()
        root = next((r for r in (here, os.path.join(home or os.path.expanduser("~"), repo))
                     if r and os.path.isdir(r) and origin_slug(r) == slug), "")
        if not root:
            err.write(f"sign-commits: no clone of {owner}/{repo} here or at ~/{repo}; cd into one and re-run\n")
            return 1
    else:
        root, slug = here, origin_slug(here) if here else ""
        if not slug:
            err.write(f"sign-commits: PR {num} names no repo, and this is not a clone of a GitHub repo; "
                      "say owner/repo#n\n")
            return 1

    gh = gh or (lambda a: subprocess.run(["gh", *a], text=True, capture_output=True))
    p = gh(["pr", "view", num, "-R", slug, "--json", "headRefName,baseRefName,isCrossRepository,state,url"])
    if p.returncode:
        err.write(f"sign-commits: gh could not read {slug}#{num}: {p.stderr.strip()}\n")
        return 1
    pr = json.loads(p.stdout)
    head, base = pr["headRefName"], pr["baseRefName"]
    if pr["state"] != "OPEN":
        err.write(f"sign-commits: {pr['url']} is {pr['state'].lower()}; nothing to sign\n")
        return 1
    if pr["isCrossRepository"]:
        err.write(f"sign-commits: {pr['url']} comes from a fork; its head is not on origin, so this cannot push it\n")
        return 1
    out.write(f"sign-commits: {pr['url']}  {head} -> {base}\n")

    p = run(["git", "-C", root, "fetch", "--quiet", "origin"])
    if p.returncode:
        err.write("sign-commits: git fetch origin failed; nothing touched\n")
        return 1
    sha = git(root, "rev-parse", "--verify", "-q", f"refs/remotes/origin/{head}").stdout.strip()
    if not sha:
        err.write(f"sign-commits: origin/{head} not found after the fetch; nothing touched\n")
        return 1

    scratch = f"sign-commits/{num}-{os.getpid()}"
    wt = tempfile.mkdtemp(prefix="sign-commits-")
    os.rmdir(wt)  # git worktree add makes it
    p = git(root, "worktree", "add", "-q", "-b", scratch, wt, sha)
    if p.returncode:
        err.write(f"sign-commits: could not make a scratch worktree: {p.stderr.strip()}\n")
        return 1
    try:
        rc, text = brief(wt, scratch, base=base)
        if rc:
            err.write(f"sign-commits: {text}")
            return 1
        # The worktrees line would only name the scratch worktree; the PR's head is what matters.
        out.write("".join(ln.replace(scratch, head) for ln in text.splitlines(True) if not ln.startswith("worktrees: ")))
        cmd, rec = recommendation(text)
        if rec.startswith("nothing on the base"):
            out.write(f"sign-commits: nothing to re-sign on {head}\n")
            return 0
        if not cmd.startswith(RUNS):
            err.write(f"sign-commits: not a step this runs by itself -- {rec.replace(scratch, head) or 'no recommendation'}\n")
            return 1
        push = ["git", "push", f"--force-with-lease=refs/heads/{head}:{sha}", "origin", f"HEAD:refs/heads/{head}"]
        out.write(f"+ {cmd}\n+ {' '.join(push)}\n")
        if dry:
            out.write("sign-commits: dry run, nothing pushed\n")
            return 0
        out.flush()
        p = run(["git", "-C", wt, *shlex.split(cmd)[1:]])
        if p.returncode:
            git(wt, "rebase", "--abort")
            err.write(f"sign-commits: `{cmd}` failed (exit {p.returncode}); nothing pushed\n")
            return 1
        p = run(["git", "-C", wt, *push[1:]])
        if p.returncode:
            err.write(f"sign-commits: push failed (exit {p.returncode}); a refused lease means someone pushed "
                      f"to {head} since the fetch -- re-run to sign what is there now\n")
            return 1
        out.write(f"sign-commits: {head} re-signed and pushed; {pr['url']}\n")
        return 0
    finally:
        git(root, "worktree", "remove", "--force", wt)
        git(root, "branch", "-D", scratch)


def main(argv, cwd=None, brief=state.branch_brief, run=subprocess.run, out=sys.stdout, err=sys.stderr, gh=None):
    """`brief` reads; `run` is every subprocess that acts (fetch, the
    recommended command, push), so a test can watch them without a key."""
    dry, br = False, None
    for a in argv:
        if a in ("-n", "--dry-run"):
            dry = True
        elif a in ("-h", "--help"):
            out.write(USAGE)
            return 0
        elif a.startswith("-") or br is not None:
            err.write(USAGE)
            return 2
        else:
            br = a

    if br and PR_RE.match(br) and (br.isdigit() or "#" in br or "/pull/" in br):
        return sign_pr(br, dry, cwd=cwd, brief=brief, run=run, out=out, err=err, gh=gh)

    def git(*a):
        return subprocess.run(["git", *a], cwd=cwd, text=True, capture_output=True)

    p = git("rev-parse", "--show-toplevel")
    if p.returncode:
        err.write("sign-commits: not inside a git repository\n")
        return 1
    root = p.stdout.strip()
    cur = git("branch", "--show-current").stdout.strip()
    br = br or cur
    if not br:
        err.write("sign-commits: HEAD is detached; name the branch to re-sign\n")
        return 2

    # A named branch that is not checked out is signed through its open PR,
    # which never reads or moves the local copy.
    slug = origin_slug(root) if br != cur else ""
    if slug:
        gh = gh or (lambda a: subprocess.run(["gh", *a], text=True, capture_output=True))
        p = gh(["pr", "list", "-R", slug, "--head", br, "--state", "open", "--json", "number,isCrossRepository",
                "-q", ".[] | select(.isCrossRepository | not) | .number"])
        nums = p.stdout.split() if p.returncode == 0 else []
        if len(nums) == 1:
            return sign_pr(f"{slug}#{nums[0]}", dry, cwd=cwd, brief=brief, run=run, out=out, err=err, gh=gh)

    p = run(["git", "-C", root, "fetch", "--quiet", "origin"])
    if p.returncode:
        err.write("sign-commits: git fetch origin failed; nothing touched\n")
        return 1

    # branch_brief reads the local branch, but the PR is origin's. A local
    # branch left behind (a bot or another machine pushed to the PR) briefs as
    # "nothing to re-sign" while the PR stays blocked (colregs-mcp#75).
    has = lambda ref: git("rev-parse", "--verify", "-q", ref).returncode == 0  # noqa: E731
    if has(f"refs/remotes/origin/{br}"):
        if not has(f"refs/heads/{br}"):
            err.write(f"sign-commits: no local branch {br}; `git switch {br}` makes it from origin/{br}, then re-run\n")
            return 1
        p = git("rev-list", "--left-right", "--count", f"refs/heads/{br}...refs/remotes/origin/{br}")
        if p.returncode:
            err.write(f"sign-commits: could not compare {br} with origin/{br}; nothing touched\n")
            return 1
        ahead, behind = (int(x) for x in p.stdout.split())
        if ahead and behind:
            err.write(f"sign-commits: {br} and origin/{br} have diverged ({ahead} local-only, {behind} origin-only "
                      "commit(s)); reconcile them by hand first -- a leased push would drop origin's\n")
            return 1
        if behind:
            if br != cur:
                err.write(f"sign-commits: {br} is {behind} commit(s) behind origin/{br}; check it out and re-run\n")
                return 1
            ff = ["git", "merge", "--ff-only", f"origin/{br}"]
            out.write(f"sign-commits: {br} is {behind} commit(s) behind origin/{br}, the PR's head\n+ {' '.join(ff)}\n")
            if dry:
                out.write("sign-commits: dry run, nothing touched; a real run fast-forwards first, then briefs\n")
                return 0
            out.flush()
            p = run(["git", "-C", root, *ff[1:]])
            if p.returncode:
                err.write(f"sign-commits: fast-forward to origin/{br} failed (exit {p.returncode}); nothing else touched\n")
                return 1

    rc, text = brief(root, br)
    if rc:
        err.write(f"sign-commits: {text}")
        return 1
    out.write(text)

    cmd, rec = recommendation(text)
    if rec.startswith("nothing on the base"):
        out.write(f"sign-commits: nothing to re-sign on {br}\n")
        return 0
    if not cmd.startswith(RUNS):
        err.write(f"sign-commits: not a step this runs by itself -- {rec or 'no recommendation'}\n")
        return 1
    if br != cur:
        err.write(f"sign-commits: check out {br} first; the command rewrites the checked-out branch\n")
        return 1

    push = ["git", "push", "--force-with-lease", "origin", br]
    out.write(f"+ {cmd}\n")
    if not dry:
        out.flush()
        p = run(["git", "-C", root, *shlex.split(cmd)[1:]])
        if p.returncode:
            err.write(f"sign-commits: `{cmd}` failed (exit {p.returncode}); nothing pushed. "
                      "If a rebase is in progress, finish it or run `git rebase --abort`.\n")
            return 1
    out.write("+ " + " ".join(push) + "\n")
    if dry:
        out.write("sign-commits: dry run, nothing touched\n")
        return 0
    out.flush()
    p = run(["git", "-C", root, *push[1:]])
    if p.returncode:
        err.write(f"sign-commits: push failed (exit {p.returncode}); the branch is re-signed locally\n")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
