</style></head><body>
<header><h1>Metrics</h1><small>built {built} · GitHub refreshed {gh}</small><nav>{nav}</nav></header>
<div class="tiles">{tiles}</div>
{body}
<footer>Rendered by metrics-dashboard from metrics.db (metrics-db). Hover any step for its values. Green deltas move in the wanted direction.</footer>
</body></html>"""

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--db"); ap.add_argument("--out"); ap.add_argument("--days", type=int, default=56)
    a = ap.parse_args()
    sd = state_dir()
    if not sd and not (a.db and a.out):
        print("metrics-dashboard: state repo not found; pass --db and --out", file=sys.stderr); return 3
    db = a.db or os.path.join(sd, "metrics", "dashboard", "metrics.db")
    out = a.out or os.path.join(sd, "metrics", "dashboard", "index.html")
    if not os.path.exists(db):
        print(f"metrics-dashboard: {db} missing; run metrics-db first", file=sys.stderr); return 1
    print(build(db, out, a.days))
    return 0

if __name__ == "__main__":
    sys.exit(main())
