#!/usr/bin/env python3
# metrics-dashboard -- render the metrics SQLite file (see metrics-db) as one
# self-contained HTML page: inline SVG, no scripts, no network, so it opens
# from file://, survives being mailed to a phone, and reads the same in the
# dark. Six sections, one per question the page exists to answer:
#   open work      issues, PRs and board cards over time
#   sessions       hours at the keyboard vs agent hours, friction, decisions
#   typing         prompts and words the user typed, per day
#   input          keys, clicks and presence from ActivityWatch, in and out of sessions
#   agent work     how much lands with how few touches
#   cost           API-equivalent dollars by model and per merged PR, and the session
#                  shape behind them: cold context, context per turn, length
#   ci checks      the CI review checks' cost per check, week, repo and model
#
# Usage: metrics-dashboard [--db FILE] [--out FILE] [--days N]
#   --days   the daily window (default 56); weekly series cover the whole span.
# Writes <state>/metrics/dashboard/index.html by default and prints its path.
# Python 3 stdlib only.
import argparse, datetime as dt, html, os, re, sqlite3, sys
from collections import defaultdict

sys.dont_write_bytecode = True  # no __pycache__ left in the seeded tree
sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
                os.path.expanduser("~/.claude/lib")]  # lib/libpath.py
try:
    import when  # noqa: E402
except ImportError:
    sys.exit("metrics-dashboard: lib/ not found (looked beside the tool and in ~/.claude/lib)")

def state_dir():
    """<state repo>/state/global, found by lib/state.py's state_repo (the one
    search path: CLAUDE_STATE_REPO, cloud checkouts, then the usual clones);
    None when it is not here. lib/ sits beside this checkout or in ~/.claude."""
    try:
        import state
    except ModuleNotFoundError as e:
        if e.name != "state":
            raise  # state.py is here but broken (a partial lib/): say so
        return None
    return state.state_dir_or_none()

# --- SVG ---------------------------------------------------------------------
# Categorical slots in fixed order (the dataviz reference palette, validated):
# blue, orange, aqua, yellow. Colors are CSS variables so the dark theme is a
# stylesheet, not a second render. Text never wears a series color.
W, H, ML, MR, MT, MB = 560, 170, 44, 12, 10, 26

def fmt(v):
    if v is None: return "–"
    if isinstance(v, float) and not v.is_integer(): return f"{v:,.1f}"
    v = int(v)
    return f"{v/1000:.1f}k" if abs(v) >= 10000 else f"{v:,}"

def ticks(vmax):
    if vmax <= 0: return [0, 1]
    import math
    step = 10 ** math.floor(math.log10(vmax))
    for m in (1, 2, 5, 10):
        if vmax / (step * m) <= 5:
            step *= m; break
    n = math.ceil(vmax / step)
    return [i * step for i in range(n + 1)]

def x_labels(keys, every):
    out = []
    for i, k in enumerate(keys):
        if i % every == 0 or i == len(keys) - 1 and len(keys) > 2 and (len(keys) - 1) % every >= every // 2:
            out.append((i, k[5:] if len(k) == 10 else k))
    return out

def frame(keys, vmax, every):
    tk = ticks(vmax); top = tk[-1] or 1
    pw, ph = W - ML - MR, H - MT - MB
    y = lambda v: MT + ph - ph * v / top
    g = []
    for t in tk:
        g.append(f'<line class="grid" x1="{ML}" x2="{W-MR}" y1="{y(t):.1f}" y2="{y(t):.1f}"/>'
                 f'<text class="ax" x="{ML-6}" y="{y(t)+3.5:.1f}" text-anchor="end">{fmt(t)}</text>')
    for i, lab in x_labels(keys, every):
        xx = ML + pw * (i + 0.5) / max(len(keys), 1)
        g.append(f'<text class="ax" x="{xx:.1f}" y="{H-8}" text-anchor="middle">{lab}</text>')
    g.append(f'<line class="base" x1="{ML}" x2="{W-MR}" y1="{y(0):.1f}" y2="{y(0):.1f}"/>')
    return "".join(g), y, pw, ph, top

def lines(title, keys, series, every=7, unit=""):
    """series: [(name, {key: value})]; one y axis, same unit for every series."""
    vmax = max([v for _, s in series for v in s.values() if v is not None] or [0])
    g, y, pw, ph, top = frame(keys, vmax, every)
    n = max(len(keys), 1); xs = lambda i: ML + pw * (i + 0.5) / n
    body = [g]
    for si, (name, s) in enumerate(series):
        pts = [(xs(i), y(s[k])) for i, k in enumerate(keys) if s.get(k) is not None]
        if not pts: continue
        d = "M" + " L".join(f"{px:.1f},{py:.1f}" for px, py in pts)
        body.append(f'<path class="s{si+1} ln" d="{d}"/>')
        if 1 < len(series) <= 3:  # direct label at the line's end
            body.append(f'<text class="lbl" x="{pts[-1][0]+4:.1f}" y="{pts[-1][1]+3.5:.1f}">{html.escape(name)}</text>')
    for i, k in enumerate(keys):  # hover layer: one hit target per step
        tip = k + "".join(f"\n{name}: {fmt(s.get(k))}{unit}" for name, s in series)
        body.append(f'<rect class="hit" x="{xs(i)-pw/n/2:.1f}" y="{MT}" width="{pw/n:.1f}" height="{ph}"><title>{html.escape(tip)}</title></rect>')
    return card(title, "".join(body), [n for n, _ in series] if len(series) > 1 else [])

def bars(title, keys, series, every=7, unit=""):
    """Stacked bars. series: [(name, {key: value})]; segments keep a 2px gap."""
    tot = {k: sum((s.get(k) or 0) for _, s in series) for k in keys}
    g, y, pw, ph, top = frame(keys, max(tot.values() or [0]), every)
    n = max(len(keys), 1); bw = pw / n
    body = [g]
    for i, k in enumerate(keys):
        acc = 0; x0 = ML + bw * i + max(bw * 0.12, 1)
        for si, (name, s) in enumerate(series):
            v = s.get(k) or 0
            if v <= 0: continue
            y1, y0 = y(acc + v), y(acc)
            hgt = max(y0 - y1 - (2 if acc else 0), 0.5)
            body.append(f'<rect class="s{si+1}" x="{x0:.1f}" y="{y1:.1f}" width="{max(bw-2*max(bw*0.12,1),1):.1f}" height="{hgt:.1f}" rx="1"/>')
            acc += v
        tip = k + "".join(f"\n{name}: {fmt(s.get(k) or 0)}{unit}" for name, s in series) + (f"\ntotal: {fmt(tot[k])}{unit}" if len(series) > 1 else "")
        body.append(f'<rect class="hit" x="{ML+bw*i:.1f}" y="{MT}" width="{bw:.1f}" height="{ph}"><title>{html.escape(tip)}</title></rect>')
    return card(title, "".join(body), [n for n, _ in series] if len(series) > 1 else [])

def card(title, svg_body, legend):
    leg = "".join(f'<span><i class="s{i+1}"></i>{html.escape(n)}</span>' for i, n in enumerate(legend))
    return (f'<figure><figcaption>{html.escape(title)}</figcaption>'
            f'<svg viewBox="0 0 {W} {H}" role="img" aria-label="{html.escape(title)}">{svg_body}</svg>'
            f'{"<div class=leg>" + leg + "</div>" if leg else ""}</figure>')

def table_card(title, head, rows, labels=1):
    th = "".join(f'<th{"" if i < labels else " class=num"}>{html.escape(h)}</th>' for i, h in enumerate(head))
    tr = "".join("<tr>" + f"<td>{html.escape(str(r[0]))}</td>" + "".join(f'<td{"" if i < labels else " class=num"}>{html.escape(str(c))}</td>' for i, c in enumerate(r[1:], 1)) + "</tr>" for r in rows)
    return f'<figure class="wide"><figcaption>{html.escape(title)}</figcaption><table><thead><tr>{th}</tr></thead><tbody>{tr}</tbody></table></figure>'

def usd(v):
    return "–" if v is None else f"${v:,.2f}" if abs(v) >= 0.995 else f"${v:,.3f}"

CI_CHECKS = ["claude-review", "claude-maxims", "claude-arete"]

def tile(label, now, prev=None, unit="", good="down"):
    delta = ""
    if prev not in (None, 0) and now is not None:
        pct = (now - prev) / prev * 100
        cls = "good" if (pct > 0) == (good == "up") else "bad"
        if abs(pct) < 1: cls = "flat"
        delta = f'<small class="{cls}">{"+" if pct >= 0 else ""}{pct:.0f}% vs prior</small>'
    elif prev is not None:
        delta = '<small class="flat">prior: ' + fmt(prev) + '</small>'
    return f'<div class="tile"><b>{fmt(now)}{unit}</b><span>{html.escape(label)}</span>{delta}</div>'

# --- data ----------------------------------------------------------------------
def days(n, end):
    return [(end - dt.timedelta(days=i)).isoformat() for i in range(n - 1, -1, -1)]

def mondays(first, end):
    d = first - dt.timedelta(days=first.weekday()); out = []
    while d <= end:
        out.append(d.isoformat()); d += dt.timedelta(days=7)
    return out

# A minute is active input at this many key presses (~4 words); stray hotkeys
# stay under it, sustained typing runs near 200. A guess to tune on real data.
ACTIVE_KEYS_PER_MIN = 20
# Foreground categories charted by name; the rest of input-export's map is "other".
INPUT_CATS = ["claude", "terminal", "github", "browser"]

def minute_day(m):
    return dt.datetime.fromtimestamp(m * 60, dt.timezone.utc).date().isoformat()

def epoch_min(iso):
    return int(when.epoch(iso) // 60)

# Context tokens a turn sends: what was re-read, what was written, what went uncached.
CTX = "coalesce(cache_read_tokens, 0) + coalesce(cache_creation_tokens, 0) + coalesce(input_tokens, 0)"

def model_name(m):
    """'claude-opus-5-5' -> 'opus': the family, as the legend has room for."""
    return re.sub(r"^claude-|-[\d-]+$", "", m or "unknown") or m

def session_minutes(rows):
    """{host: set of UTC minutes some session on that host was open}; parallel
    sessions share a minute, counted once."""
    out = defaultdict(set)
    for r in rows:
        try:
            a, b = epoch_min(r["started_at"]), epoch_min(r["ended_at"])
        except (AttributeError, TypeError, ValueError):
            continue
        out[r["host"]].update(range(a, b + 1))
    return out

def build(db, out, ndays):
    cx = sqlite3.connect(db); cx.row_factory = sqlite3.Row
    q = lambda sql, *a: cx.execute(sql, a).fetchall()
    ndays = max(ndays, 14)  # the tiles compare two fixed 7-day windows
    today = dt.date.today(); dkeys = days(ndays, today); start = dkeys[0]
    first = q("select min(substr(started_at,1,10)) f from sessions")[0]["f"] or start
    wkeys = mondays(dt.date.fromisoformat(first), today)
    WEEK = "date(substr(%s,1,10), '-' || ((strftime('%%w', substr(%s,1,10)) + 6) %% 7) || ' days')"
    def wk(col): return WEEK % (col, col)
    def series(rows, kcol, vcol): return {r[kcol]: r[vcol] for r in rows}
    meta = dict((r["key"], r["value"]) for r in q("select * from meta"))

    # open work ------------------------------------------------------------
    gh = q("select repo, kind, substr(created_at,1,10) c, substr(coalesce(closed_at,'9999'),1,10) x, head_ref from gh_items")
    def open_on(kind, day, repo=None):
        return sum(1 for r in gh if r["kind"] == kind and r["c"] <= day and r["x"] > day and (repo is None or r["repo"] == repo))
    project = {}
    for r in q("select repo, topics from gh_repos"):
        p = [t for t in (r["topics"] or "").split(",") if t.startswith("project-")]
        project[r["repo"]] = p[0][8:] if p else "other"
    def open_by_project(kind, day):
        out = defaultdict(int)
        for r in gh:
            if r["kind"] == kind and r["c"] <= day and r["x"] > day:
                out[project.get(r["repo"], "other")] += 1
        return out
    daily_issues = {d: open_by_project("issue", d) for d in dkeys}
    projects = sorted({p for v in daily_issues.values() for p in v}, key=lambda p: (p == "other", -daily_issues[dkeys[-1]].get(p, 0)))
    issue_series = [(p, {d: daily_issues[d].get(p, 0) for d in dkeys}) for p in projects]
    pr_open = ("open PRs", {d: open_on("pr", d) for d in dkeys})
    merged = q(f"select {wk('merged_at')} w, sum(head_ref like 'claude/%') agent, sum(head_ref not like 'claude/%') other from gh_items where kind='pr' and merged_at is not null group by w")
    ev = q("select item_id, ts, status, owner from item_events order by item_id, ts")
    owner_of, hist = {}, defaultdict(list)
    for r in ev:
        if r["owner"] and r["item_id"] not in owner_of: owner_of[r["item_id"]] = r["owner"]
        hist[r["item_id"]].append((r["ts"][:10], r["status"]))
    def cards_open(day, owner):
        n = 0
        for it, h in hist.items():
            if owner_of.get(it) != owner: continue
            st = [s for d, s in h if d <= day]
            if st and st[-1] not in ("done", "closed"): n += 1
        return n
    card_first = min((r["ts"][:10] for r in ev), default=start)
    ckeys = [d for d in dkeys if d >= card_first]
    user_cards = [(o, {d: cards_open(d, o) for d in ckeys}) for o in ("human-ruling", "human-click")]
    agent_cards = [("agent queue", {d: cards_open(d, "agent") for d in ckeys})]

    # sessions --------------------------------------------------------------
    cx.execute("create temp view tv as select session_id, sum(prompts) prompts from typing group by session_id")
    # typed is NULL for a session with no transcript row: unknown, so in no headless or bucket count
    cx.execute("create temp view sv as select s.*, t.prompts typed from sessions s left join tv t on t.session_id = s.session_id")
    cx.execute("create temp view rn as select repo, substr(repo, instr(repo, '/') + 1) name from gh_repos")
    daily = q("select substr(started_at,1,10) d, count(*) n, coalesce(sum(typed=0), 0) headless, coalesce(sum(typed>0), 0) interactive, sum(human_seconds)/3600.0 hh, sum(agent_seconds)/3600.0 ah, "
              "sum(fr_correction) c, sum(fr_override) o, sum(fr_rebuke) r, sum(fr_pushback) p, "
              "sum(dec_scoping) ds, sum(dec_inline) di, sum(dec_gate) dg, sum(blk_total) b, sum(typed) ut, sum(tool_calls) tc, sum(commits) cm "
              "from sv where started_at >= ? group by d", start)
    weekly = q(f"select {wk('started_at')} w, count(*) n, sum(tool_calls) tc, sum(commits) cm, sum(fr_total) fr, sum(dec_total) dec, "
               "sum(human_seconds)/3600.0 hh, sum(agent_seconds)/3600.0 ah, "
               "coalesce(sum(typed=0), 0) t0, coalesce(sum(typed=1), 0) t1, coalesce(sum(typed between 2 and 5), 0) t2, coalesce(sum(typed>=6), 0) t3 from sv group by w")
    typing_d = q("select substr(first_ts,1,10) d, sum(prompts) p, sum(words) w, sum(chars) c from typing where first_ts >= ? group by d", start)
    typing_w = q(f"select {wk('first_ts')} w, sum(prompts) p, sum(words) wd from typing group by w")
    # events sit in the week their session started, prompts in the week of the first one: a transcript is never split
    sess_w = {r["w"]: r for r in weekly}
    def per_prompt(col, scale, nd):
        return {r["w"]: round(scale * (sess_w[r["w"]][col] if r["w"] in sess_w else 0) / r["p"], nd) for r in typing_w if r["p"]}

    # merged PRs by how many prompts the user typed into the sessions on that branch
    touches, pr_usd, pr_n = {}, defaultdict(float), defaultdict(int)
    # commits.repo is the checkout's label: a repo's own name for a primary
    # checkout (then it must be this PR's repo), a worktree label otherwise
    # (then only the branch name can match).
    # A session's dollars are split evenly across the branches it committed on,
    # so a session that fed three PRs is not counted three times.
    for r in q("select g.repo||'#'||g.number pr, " + wk("g.merged_at") + " w, "
               "case when count(s.session_id) = 0 then -1 else coalesce(sum(s.typed), 0) end t, "
               "coalesce(sum(s.cost_usd / nb.n), 0) usd from gh_items g "
               "left join (select distinct repo, branch, session_id from commits) c on c.branch = g.head_ref "
               "and (c.repo in (g.repo, substr(g.repo, instr(g.repo, '/') + 1)) "
               "or c.repo not in (select name from rn union select repo from rn)) "
               "left join sv s on s.session_id = c.session_id "
               "left join (select session_id, count(distinct repo || '/' || branch) n from commits group by session_id) nb "
               "on nb.session_id = s.session_id where g.kind='pr' and g.merged_at is not null group by g.repo, g.number"):
        b = "no session" if r["t"] < 0 else "0–1 prompts" if r["t"] <= 1 else "2–5 prompts" if r["t"] <= 5 else "6+ prompts"
        touches.setdefault(b, defaultdict(int))[r["w"]] += 1
        if r["t"] >= 0:
            pr_usd[r["w"]] += r["usd"] or 0; pr_n[r["w"]] += 1
    touch_order = ["0–1 prompts", "2–5 prompts", "6+ prompts", "no session"]
    pr_cost = ("$ per merged PR", {w: round(pr_usd[w] / n, 2) for w, n in pr_n.items() if n})

    # cost: the Stop hook's list-price estimate per session, and the shape behind it ---
    costw = q(f"select {wk('started_at')} w, count(*) n, sum(cost_usd) usd, sum(cache_creation_tokens) cw, "
              f"sum(cache_read_tokens) cr, sum({CTX}) ctx, sum(assistant_turns) turns, "
              "sum(elapsed_seconds < 300) short, sum(elapsed_seconds between 300 and 3599) mid, "
              "sum(elapsed_seconds >= 3600) long from sessions group by w")
    mtot, mweek = defaultdict(float), defaultdict(lambda: defaultdict(float))
    for r in q(f"select {wk('s.started_at')} w, c.model m, sum(c.cost_usd) usd from session_cost c "
               "join sessions s on s.session_id = c.session_id group by w, m"):
        m = model_name(r["m"]); mtot[m] += r["usd"] or 0; mweek[m][r["w"]] += r["usd"] or 0
    ranked = sorted(mtot, key=lambda m: -mtot[m])  # fixed order by spend: four named at most
    named = ranked if len(ranked) <= 4 else ranked[:3]  # a 5th and later fold into other
    for m in ranked[len(named):]:
        for w, v in mweek[m].items(): mweek["other"][w] += v
    model_series = [(m, {w: round(v, 2) for w, v in mweek[m].items()}) for m in named + (["other"] if len(named) < len(ranked) else [])]
    ratio = lambda num, den, scale=1: {r["w"]: round(scale * (r[num] or 0) / r[den], 1) for r in costw if r[den]}

    # ci checks: one row per check per workflow run (view ci_checks, metrics-db) ---
    has_ci = bool(q("select 1 from sqlite_master where name='ci_checks'"))
    ci = q("select ts, what, repo, model, coalesce(cost_usd, 0) cost_usd from ci_checks") if has_ci else []
    ci_figs = []
    if ci:
        tot, cnt = defaultdict(float), defaultdict(int)
        by_repo, by_model, ci_week = defaultdict(lambda: [0.0, 0]), defaultdict(lambda: [0.0, 0]), defaultdict(lambda: defaultdict(float))
        for r in ci:
            tot[r["what"]] += r["cost_usd"]; cnt[r["what"]] += 1
            for acc, k in ((by_repo, r["repo"]), (by_model, model_name(r["model"]))):
                acc[(r["what"], k)][0] += r["cost_usd"]; acc[(r["what"], k)][1] += 1
            d = dt.date.fromisoformat(r["ts"][:10]); ci_week[r["what"]][(d - dt.timedelta(days=d.weekday())).isoformat()] += r["cost_usd"]
        order = [c for c in CI_CHECKS + sorted(set(tot) - set(CI_CHECKS)) if c in tot]
        cikeys = mondays(dt.date.fromisoformat(min(r["ts"][:10] for r in ci)), today)
        ci_figs.append(table_card("Cost per check, all collected runs", ["check", "total", "runs", "mean per run"],
            [[c, usd(tot[c]), cnt[c], usd(tot[c] / cnt[c])] for c in order] +
            [["all checks", usd(sum(tot.values())), sum(cnt.values()), usd(sum(tot.values()) / sum(cnt.values()))]]))
        ci_figs.append(bars("CI check $ per week, by check", cikeys, [(c, {w: round(v, 3) for w, v in ci_week[c].items()}) for c in order[:4]], every=max(len(cikeys) // 8, 1), unit="$"))
        for title, acc, hdr in (("Cost by repo and check", by_repo, "repo"), ("Cost by model and check", by_model, "model")):
            ranked = sorted(acc.items(), key=lambda kv: -kv[1][0])
            ci_figs.append(table_card(title, [hdr, "check", "total", "runs", "mean per run"],
                [[k[1], k[0], usd(v[0]), v[1], usd(v[0] / v[1])] for k, v in ranked], labels=2))
        ci_note = (f"Rows are the headless-run artifacts of the CI review checks, collected by metrics-db --github (they expire after 90 days), "
                   f"one per check per workflow run, from trusted runs only; cost is the CLI's own total_cost_usd, not an estimate. "
                   f"{sum(cnt.values())} check rows from {len({r['repo'] for r in ci})} repos, {min(r['ts'][:10] for r in ci)} to {max(r['ts'][:10] for r in ci)}.")
    else:
        ci_note = "No CI check rows yet: run metrics-db --github to collect the headless-run artifacts."

    # input: one row per host-minute the host's ActivityWatch covered -------------
    lo = epoch_min(start + "T00:00:00Z")
    has_input = bool(q("select 1 from sqlite_master where name='input'"))
    inp = q("select host, minute, keys, clicks, afk, seen from input where minute >= ?", lo) if has_input else []
    wins = q("select category, minute, seconds from input_win where minute >= ?", lo) if has_input else []
    inside = session_minutes(q("select host, started_at, ended_at from sessions where host is not null and ended_at >= ?", start))
    present, active, keys_in, keys_out, keys_d, clicks_d = (defaultdict(float) for _ in range(6))
    for r in inp:
        d = minute_day(r["minute"])
        present[d] += max((r["seen"] or 0) - (r["afk"] or 0), 0) / 3600.0
        if (r["keys"] or 0) >= ACTIVE_KEYS_PER_MIN: active[d] += 1 / 60.0
        (keys_in if r["minute"] in inside.get(r["host"], ()) else keys_out)[d] += r["keys"] or 0
        keys_d[d] += r["keys"] or 0; clicks_d[d] += r["clicks"] or 0
    fg = defaultdict(lambda: defaultdict(float))
    for r in wins:
        c = r["category"] if r["category"] in INPUT_CATS else "other"
        fg[c][minute_day(r["minute"])] += (r["seconds"] or 0) / 3600.0
    cover = sorted({minute_day(r["minute"]) for r in inp})
    r1 = lambda dd: {k: round(v, 1) for k, v in dd.items()}
    def in7(dd, a, b): return sum(v for k, v in dd.items() if dkeys[a] <= k <= dkeys[b])
    r0 = lambda v: None if v is None else round(v)

    # tiles: last 7 days vs the 7 before ---------------------------------------
    def win(sql, a, b):
        return q(sql, dkeys[a], dkeys[b])[0][0] or 0
    S7 = "select %s from sv where substr(started_at,1,10) between ? and ?"
    T7 = "select %s from typing where substr(first_ts,1,10) between ? and ?"
    a7, b7, a14, b14 = -7, -1, -14, -8
    # chars only from sessions on a host that exports keys, to match keys_in
    TH7 = ("select sum(t.chars) from typing t join sessions s on s.session_id = t.session_id "
           "where s.host is not null and substr(t.first_ts,1,10) between ? and ?")
    def cold(a, b):
        ctx = win(S7 % "sum(cache_creation_tokens + cache_read_tokens)", a, b)
        return 100.0 * win(S7 % "sum(cache_creation_tokens)", a, b) / ctx if ctx else None
    def per_turn(a, b):
        turns = win(S7 % "sum(assistant_turns)", a, b)
        return win(S7 % f"sum({CTX})", a, b) / turns / 1000 if turns else None
    tiles = [
        tile("sessions, 7d", win(S7 % "count(*)", a7, b7), win(S7 % "count(*)", a14, b14), good="up"),
        tile("of them headless, 7d", win(S7 % "sum(typed=0)", a7, b7), win(S7 % "sum(typed=0)", a14, b14), good="up"),
        tile("hours at the keyboard, 7d", round(win(S7 % "sum(human_seconds)/3600.0", a7, b7), 1), round(win(S7 % "sum(human_seconds)/3600.0", a14, b14), 1), good="down"),
        tile("agent hours, 7d", round(win(S7 % "sum(agent_seconds)/3600.0", a7, b7), 1), round(win(S7 % "sum(agent_seconds)/3600.0", a14, b14), 1), good="up"),
        tile("prompts typed, 7d", win(T7 % "sum(prompts)", a7, b7), win(T7 % "sum(prompts)", a14, b14), good="down"),
        tile("words typed, 7d", win(T7 % "sum(words)", a7, b7), win(T7 % "sum(words)", a14, b14), good="down"),
        tile("friction events, 7d", win(S7 % "sum(fr_total)", a7, b7), win(S7 % "sum(fr_total)", a14, b14), good="down"),
        tile("gate decisions, 7d", win(S7 % "sum(dec_gate)", a7, b7), win(S7 % "sum(dec_gate)", a14, b14), good="down"),
        tile("active input hours, 7d", round(in7(active, a7, b7), 1), round(in7(active, a14, b14), 1), good="down"),
        tile("keys outside Claude, 7d", int(in7(keys_out, a7, b7)), int(in7(keys_out, a14, b14)), good="down"),
        tile("chars to Claude per key, 7d", round(win(TH7, a7, b7) / in7(keys_in, a7, b7), 2) if in7(keys_in, a7, b7) else None,
             round(win(TH7, a14, b14) / in7(keys_in, a14, b14), 2) if in7(keys_in, a14, b14) else None, good="up"),
        tile("days with input data, 7d", sum(1 for d in cover if dkeys[a7] <= d <= dkeys[b7]), sum(1 for d in cover if dkeys[a14] <= d <= dkeys[b14]), good="up"),
        tile("open issues", open_on("issue", dkeys[-1]), open_on("issue", dkeys[-8]), good="down"),
        tile("open PRs", open_on("pr", dkeys[-1]), open_on("pr", dkeys[-8]), good="down"),
        tile("rulings waiting", cards_open(dkeys[-1], "human-ruling"), cards_open(dkeys[-8], "human-ruling") if dkeys[-8] >= card_first else None, good="down"),
        tile("API-equivalent $, 7d", round(win(S7 % "sum(cost_usd)", a7, b7)), round(win(S7 % "sum(cost_usd)", a14, b14)), good="down"),
        tile("cold context share, 7d", r0(cold(a7, b7)), r0(cold(a14, b14)), unit="%", good="down"),
        tile("context per turn, 7d", r0(per_turn(a7, b7)), r0(per_turn(a14, b14)), unit="k", good="down"),
    ]

    figs = {
        "open": [
            lines("Open issues, by project", dkeys, issue_series),
            lines("Open pull requests, all repos", dkeys, [pr_open]),
            bars("PRs merged per week: agent branch vs other", wkeys, [("claude/* branch", series(merged, "w", "agent")), ("other", series(merged, "w", "other"))], every=4),
            lines("Board cards waiting on the user, by section", ckeys, user_cards, every=max(len(ckeys) // 8, 1)),
            lines("Board cards in the agent's queue", ckeys, agent_cards, every=max(len(ckeys) // 8, 1)),
        ],
        "sessions": [
            lines("Hours per day: at the keyboard vs agent", dkeys, [("keyboard", series(daily, "d", "hh")), ("agent", series(daily, "d", "ah"))], unit="h"),
            bars("Sessions per day: headless vs interactive", dkeys, [("headless (nothing typed)", series(daily, "d", "headless")), ("interactive", series(daily, "d", "interactive"))]),
            bars("Friction events per day, by type", dkeys, [("correction", series(daily, "d", "c")), ("override", series(daily, "d", "o")), ("rebuke", series(daily, "d", "r")), ("pushback", series(daily, "d", "p"))]),
            bars("Decisions pushed per day, by type", dkeys, [("scoping", series(daily, "d", "ds")), ("inline", series(daily, "d", "di")), ("gate", series(daily, "d", "dg"))]),
            lines("Friction per 100 prompts, weekly", wkeys, [("friction/100", per_prompt("fr", 100.0, 1))], every=4),
            lines("Decisions per keyboard hour, weekly", wkeys, [("decisions/h", {r["w"]: round(r["dec"] / r["hh"], 2) for r in weekly if r["hh"]})], every=4),
        ],
        "typing": [
            bars("Prompts typed per day (by first-prompt day)", dkeys, [("prompts", series(typing_d, "d", "p"))]),
            bars("Words typed per day (by first-prompt day)", dkeys, [("words", series(typing_d, "d", "w"))]),
            lines("Words per prompt, weekly mean", wkeys, [("words/prompt", {r["w"]: round(r["wd"] / r["p"], 1) for r in typing_w if r["p"]})], every=4),
            lines("Characters per prompt, daily mean", dkeys, [("chars/prompt", {r["d"]: round(r["c"] / r["p"]) for r in typing_d if r["p"]})]),
        ],
        "input": [
            lines("Hours per day: keyboard vs active input vs present", dkeys, [("keyboard", series(daily, "d", "hh")), ("active input", r1(active)), ("present", r1(present))], unit="h"),
            bars("Keys per day: inside a session vs outside", dkeys, [("inside a session", dict(keys_in)), ("outside", dict(keys_out))]),
            bars("Present hours per day, by foreground app", dkeys, [(c, r1(fg[c])) for c in INPUT_CATS + ["other"]], unit="h"),
            lines("Clicks per day", dkeys, [("clicks", dict(clicks_d))]),
        ],
        "agent": [
            bars("Sessions per week, by prompts typed", wkeys, [("0 (headless)", series(weekly, "w", "t0")), ("1", series(weekly, "w", "t1")), ("2–5", series(weekly, "w", "t2")), ("6+", series(weekly, "w", "t3"))], every=4),
            bars("Merged PRs per week, by prompts typed on the branch", wkeys, [(b, touches.get(b, {})) for b in touch_order], every=4),
            lines("Tool calls per prompt, weekly", wkeys, [("tool calls/prompt", per_prompt("tc", 1, 1))], every=4),
            lines("Agent hours per keyboard hour, weekly", wkeys, [("agent h / keyboard h", {r["w"]: round(r["ah"] / r["hh"], 2) for r in weekly if r["hh"]})], every=4),
            lines("Commits per prompt, weekly", wkeys, [("commits/prompt", per_prompt("cm", 1, 2))], every=4),
        ],
        "ci": ci_figs,
        "cost": [
            bars("API-equivalent $ per week, by model", wkeys, model_series, every=4),
            lines("API-equivalent $ per merged PR, weekly mean", wkeys, [pr_cost], every=4),
            lines("Cold context share, weekly", wkeys, [("cold %", {r["w"]: round(100.0 * (r["cw"] or 0) / ((r["cw"] or 0) + (r["cr"] or 0)), 1) for r in costw if r["cw"] or r["cr"]})], every=4, unit="%"),
            lines("Context per turn, weekly mean", wkeys, [("k tokens/turn", ratio("ctx", "turns", 0.001))], every=4, unit="k"),
            lines("Turns per session, weekly mean", wkeys, [("turns/session", ratio("turns", "n"))], every=4),
            bars("Sessions per week, by length", wkeys, [("under 5 min", series(costw, "w", "short")), ("5 min to 1 h", series(costw, "w", "mid")), ("over 1 h", series(costw, "w", "long"))], every=4),
        ],
    }
    sections = [("open", "Open work", "Issues and PRs are reconstructed from GitHub timestamps, so the history is complete; board cards start when the item store did."),
                ("sessions", "Sessions and friction", f"Daily series cover the last {ndays} days; weekly series the whole record."),
                ("typing", "Typing", "Prompts the user typed into interactive sessions, from the local transcripts. Harness-injected and headless prompts are excluded; pasted blocks are not counted as typing. Each transcript is counted on the day its first prompt was typed, so a session that runs past midnight or is resumed later keeps all its prompts on that first day."),
                ("input", "Input", f"Per-minute counts from ActivityWatch on each host that exports them (input-export); counts and app categories only. A minute is active input at {ACTIVE_KEYS_PER_MIN}+ key presses; present is time ActivityWatch did not call away. A session's minutes are those between its start and end on the host whose home holds its cwd. Days with no data are gaps, never zeros; the coverage tile says how many there were."),
                ("agent", "Agent work vs touches", "A touch is one typed prompt. A PR's touches are the prompts typed into every session that committed on its branch."),
                ("cost", "Cost", "Dollars are the Stop hook's estimate at API list price, pricing each session's four token counts per model (hooks/session-metrics.jq): a weight for comparing sessions, models and weeks, not a bill. A sub-agent's spend lands on its own model. Cold context is the share of context tokens written to the cache instead of re-read from it; a write is priced far above a re-read, and a gap past the cache window makes the next turn cold for the whole context. A merged PR's dollars are those of the sessions that committed on its branch, each session's figure split evenly across the branches it committed on; PRs with no session are left out of the mean.")]
    sections.append(("ci", "CI review checks", ci_note))
    body = "".join(f'<h2 id="{k}">{html.escape(t)}</h2><p class="note">{html.escape(n)}</p><div class="grid">{"".join(figs[k])}</div>' for k, t, n in sections)
    page = PAGE.format(tiles="".join(tiles), body=body,
                       built=html.escape(meta.get("built_at", "?")), gh=html.escape(meta.get("gh_refreshed_at", "never")),
                       nav=" · ".join(f'<a href="#{k}">{html.escape(t)}</a>' for k, t, _ in sections))
    os.makedirs(os.path.dirname(out), exist_ok=True)
    with open(out, "w", encoding="utf-8") as f:
        f.write(page)
    return out

PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Metrics</title>
<style>
:root {{ --page:#f9f9f7; --surface:#fcfcfb; --ink:#0b0b0b; --ink2:#52514e; --muted:#898781; --grid:#e1e0d9; --base:#c3c2b7;
  --s1:#2a78d6; --s2:#eb6834; --s3:#1baf7a; --s4:#eda100; --good:#006300; --bad:#d03b3b; }}
