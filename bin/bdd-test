#!/bin/sh
# bdd-test -- run the pytest-bdd suite (tests/, features/) through a venv kept
# outside any repo, so a box whose system python lacks pytest-bdd still runs it.
# The venv is made on first use and synced to requirements-dev.txt each run.
#
#   bdd-test [pytest args]   default: -q tests
#   bdd-test --venv          print the venv path
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
venv=${BDD_TEST_VENV:-$HOME/.local/share/claude-bdd-venv}
[ "${1:-}" = --venv ] && { echo "$venv"; exit 0; }
[ -x "$venv/bin/python" ] || uv venv -q "$venv"
uv pip install -q -p "$venv/bin/python" -r "$root/requirements-dev.txt"
cd "$root"
[ $# -gt 0 ] || set -- -q tests
exec "$venv/bin/python" -m pytest -p no:cacheprovider "$@"
