#!/usr/bin/env python3
# work-item -- the work-item store: one file per item, a brief plus a log,
# the id its filename (dotfiles#510).
#
#   work-item create [--id <id>] [--owner <o>] [--repo <r>] [--parent <id>]
#                    [--model <m>] [--effort <e>] [--points <n>]
#                    [--brief <text>|-] <title>    print the new item's id
#   work-item brief <id> [--points <n>] <text>|-   replace the brief, log `briefed`
#   work-item log <id> <word>...                   append one log line
#   work-item claim <id>                           take it: `status=claimed`
#   work-item release <id>                         hand it back: `status=ready`
#   work-item show <id>                            print the file
#   work-item fold <id>                            print its folded state
#   work-item list [--all]                         every live item as a card row
#   work-item dir                                  print the items directory
#
# The format, ruled in pen (one-entry-point curia, 2026-10-01/02):
#
#   # <title>
#
#   ## Brief
#   points: 3
#   <the brief>
#
#   ## Log
#   2026-10-01T23:20:15Z 86eba7f7 status=open owner=agent repo=- parent=- model=sonnet effort=medium
#   2026-10-02T08:30:11Z 9a1b2c3d cost tokens=812340 usd=1.42 by=grind
#
# The id is epoch seconds then the session's eight hex, opaque; the file is
# the lookup. An item is created in `open`, always. Six statuses: open, ready,
# claimed, blocked, done, closed; the transitions are ALLOWED below. A claim
# is valid when the folded status is ready or closed and no other session
# holds it. A GitHub-homed item carries `home=`, with no link back.
#
# Refused at write: a create whose brief carries no link (kanban-lint's L6); a
# `status=done` line with no `evidence=`; any `status=closed`, which only the
# future whole-tree sweep writes (docs/work-item-lifecycle.md).
#
# Pencil (dotfiles#510's defaults): a flat folder; a holder that wrote nothing
# on the item for WORK_ITEM_STALE_SECS (2h) has let go; and this is a GATE --
# a write that cannot land, or is refused, exits non-zero (1 refused, 2 usage).
# Writes are plain files in the state repo; the Stop hook commits and pushes.
# Python 3 stdlib only.
import fcntl
import os
import re
import sys
import time
from pathlib import Path

STATUSES = ("open", "ready", "claimed", "blocked", "done", "closed")
OWNERS = ("agent", "human-ruling", "human-click")
POINTS = ("1", "2", "3", "5", "8", "13")
FACTS = ("owner", "repo", "parent", "model", "effort", "home", "until")
# The pen transitions; every self-transition is allowed too.
ALLOWED = {
    ("open", "ready"), ("ready", "claimed"), ("claimed", "blocked"),
    ("claimed", "ready"), ("claimed", "done"), ("blocked", "claimed"),
    ("blocked", "ready"), ("done", "claimed"), ("done", "ready"),
    ("done", "closed"), ("closed", "claimed"),
}


class Exit(Exception):
    def __init__(self, code, msg):
        super().__init__(msg)
        self.code = code


def die(msg):
    raise Exit(2, msg)


def refuse(msg):
    raise Exit(1, msg)


def state_dir():
    """lib/state.py's state_dir, so the search path for the state repo has
    one home: in this checkout beside the tool, else the seeded copy."""
    here = Path(__file__).resolve().parent
    for d in (here.parent / "lib", Path.home() / ".claude" / "lib"):
        if (d / "state.py").is_file():
            sys.path.insert(0, str(d))
            break
    else:
        die("lib/state.py not found")
    sys.dont_write_bytecode = True  # no __pycache__ left in the seeded tree
    import state
    d = state.state_dir()
    if not d:
        die("lib/state.py could not name the state dir")
    return Path(d)


def items_dir():
    d = os.environ.get("WORK_ITEM_DIR")
    return Path(d) if d else state_dir() / "items"


def iso(t):
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t))


def is_item_id(s):
    return bool(re.fullmatch(r"[0-9]{10}[0-9a-f]{8}", s or ""))


def me():
    raw = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    hex8 = raw.replace("-", "")[:8].lower()
    if len(hex8) != 8:
        die("no session id (run inside a session)")
    if not re.fullmatch(r"[0-9a-f]{8}", hex8):
        die(f"session id {raw} does not start with eight hex")
    return hex8


def word(name, v):
    """A log value is one word: the line is split on spaces."""
    if "\n" in v:
        die(f"{name} must be one line")
    if not v or " " in v or "\t" in v:
        die(f"{name} must be one word, got [{v}]")


def points_ok(p):
    if p not in POINTS:
        die(f"points is one of 1 2 3 5 8 13, got [{p}]")


LINK = re.compile(r"https?://|(^|[^\w./-])[\w.-]+/[\w.-]+#\d+|\]\((\.\./)*log/")


def num(s):
    """awk's string-to-number: the leading numeric prefix, else 0."""
    m = re.match(r"\s*[-+]?(\d+\.?\d*|\.\d+)([eE][-+]?\d+)?", s)
    return float(m.group(0)) if m else 0.0


def fmt(x):
    """awk's number output: integral values whole, the rest %.6g."""
    return str(int(x)) if x == int(x) and abs(x) < 1e16 else "%.6g" % x


def fold(path, cutoff=""):
    """An item's state, folded from its file: (key, value) pairs, the last
    value of each log fact winning. The log is `<iso> <sid8> <words>`; a word
    `k=v` sets fact k, a line that omits a fact changes nothing. The holder is
    the session of the newest `status=claimed` line while the status is
    claimed or blocked; it is stale when that session's newest line on the
    item is older than <cutoff> (ISO UTC strings sort as times). `cost` lines
    sum to cost_tokens and cost_usd; `briefed` lines count. points comes from
    the brief, not the log."""
    title = status = holder = since = points = created = updated = ""
    fact = dict.fromkeys(FACTS, "")
    seen = {}
    sec = ""
    briefed = costs = 0
    ctok = cusd = 0.0
    for line in path.read_text().splitlines():
        if sec == "" and line.startswith("# ") and title == "":
            title = line[2:]
            continue
        if re.fullmatch(r"## Brief[ \t]*", line):
            sec = "brief"
            continue
        if re.fullmatch(r"## Log[ \t]*", line):
            sec = "log"
            continue
        if line.startswith("## "):
            sec = "other"
            continue
        if sec == "brief" and line.startswith("points:"):
            points = line[len("points:"):].lstrip(" \t").rstrip(" \t\r")
            continue
        f = line.split()
        if sec != "log" or len(f) < 3:
            continue
        t, s = f[0], f[1]
        created = created or t
        updated = seen[s] = t
        if f[2] == "briefed":
            briefed += 1
        for w in f[2:]:
            if "=" not in w:
                continue
            k, v = w.split("=", 1)
            if f[2] == "cost":
                if k == "tokens":
                    ctok += num(v)
                elif k == "usd":
                    cusd += num(v)
            elif k == "status":
                status = v
                if v == "claimed":
                    holder, since = s, t
                elif v != "blocked":
                    holder = since = ""
            elif k in fact:
                fact[k] = v
        if f[2] == "cost":
            costs += 1
    stale = "yes" if holder and cutoff and seen.get(holder, "") < cutoff else "no"
    return [("id", path.name[:-3] if path.name.endswith(".md") else path.name),
            ("title", title), ("status", status), ("holder", holder),
            ("held_since", since), ("holder_last", seen.get(holder, "") if holder else ""),
            ("holder_stale", stale), *fact.items(), ("points", points),
            ("briefed", str(briefed)), ("costs", str(costs)),
            ("cost_tokens", fmt(ctok)), ("cost_usd", fmt(cusd)),
            ("created", created), ("updated", updated)]


class Item:
    def __init__(self, item_id):
        if not is_item_id(item_id):
            die(f"not an item id: {item_id or '<id>'}")
        self.id = item_id
        self.path = items_dir() / f"{item_id}.md"
        self.lockf = None

    def need(self):
        if not self.path.is_file():
            refuse(f"no item {self.id} in {items_dir()}")
        return self

    def lock(self):
        """Hold the item's write lock for the rest of the process, waiting up to 10s."""
        p = Path(os.environ.get("TMPDIR") or "/tmp") / f"work-item.{self.id}.lock"
        try:
            self.lockf = open(p, "a")
        except OSError:
            refuse(f"could not open the lock {p}")
        for _ in range(11):
            try:
                fcntl.flock(self.lockf, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return
            except BlockingIOError:
                time.sleep(1)
        refuse(f"item {self.id} is locked by another writer")

    def facts(self):
        stale = int(os.environ.get("WORK_ITEM_STALE_SECS") or 7200)
        try:
            return dict(fold(self.path, iso(time.time() - stale)))
        except OSError:
            refuse(f"could not read {self.path}")

    def append(self, sid, words):
        """One line from this session, or fail loudly."""
        try:
            with open(self.path, "a") as fh:
                fh.write(f"{iso(time.time())} {sid} {words}\n")
        except OSError:
            refuse(f"could not write {self.path}")

    def move(self, sid, to):
        """Check a status move against the transitions and the holder, under the lock."""
        if to not in STATUSES:
            die(f"unknown status {to} (one of {' '.join(STATUSES)})")
        f = self.facts()
        holder = f["holder"]
        live = holder if holder and f["holder_stale"] == "no" else ""
        if live and live != sid:
            refuse(f"{self.id} is held by {live} since {f['held_since']} "
                   f"(last wrote {f['holder_last']})")
        if to == "claimed" and holder and not live:
            return  # a stale holder has let go: the item reads as handed back
        if f["status"] != to and (f["status"], to) not in ALLOWED:
            refuse(f"{self.id}: {f['status']} -> {to} is not a transition")

    def write_brief(self, brief, points):
        """Rewrite the Brief section from brief and points."""
        try:
            lines = self.path.read_text().splitlines(keepends=True)
            head = next(i for i, l in enumerate(lines) if re.fullmatch(r"## Brief[ \t]*\n?", l))
            log = next(i for i, l in enumerate(lines) if re.fullmatch(r"## Log[ \t]*\n?", l))
            tmp = self.path.with_name(f"{self.path.name}.tmp.{os.getpid()}")
            tmp.write_text("".join(lines[:head]) + brief_section(brief, points)
                           + "".join(lines[log:]))
            os.replace(tmp, self.path)
        except (OSError, StopIteration):
            refuse(f"could not write {self.path}")


def brief_text(path):
    """The brief folded onto one line: its lines bar `points:`, joined by a
    space, tabs made spaces so the text fits one TSV column."""
    out, sec = [], ""
    for line in path.read_text().splitlines():
        if line.startswith("## "):
            sec = "brief" if re.fullmatch(r"## Brief[ \t]*", line) else "other"
        elif sec == "brief" and line.strip() and not line.startswith("points:"):
            out.append(line.strip().replace("\t", " "))
    return " ".join(out)


def card_line(f, brief):
    """The item as a board card line, so a reader of the board reads it with
    the same parse: a brief that already carries its own `id:` (a card moved
    off kanban.md, brief verbatim) is the line; any other is drawn as
    `**title**: brief`, then its home link and the facts the brief does not
    already name, then `id:` last."""
    i = f["id"]
    if re.search(r"(^|[ (])id:[ \t]*" + i + r"([^0-9a-z]|$)", brief):
        return brief
    line = f"**{f['title']}**" + (f": {brief}" if brief else "")
    m = re.fullmatch(r"([\w.-]+)/([\w.-]+)#(\d+)", f["home"])
    if m and f["home"] not in brief:
        line += f" ([{f['home']}](https://github.com/{m[1]}/{m[2]}/issues/{m[3]}))"
    for k in ("repo", "model", "effort", "until"):
        if f[k] not in ("", "-") and not re.search(rf"(^|[ (]){k}:", brief):
            line += f" {k}: {f[k]}"
    return f"{line} id: {i}"


def list_items(args):
    """One TSV row per item, oldest id first, done and closed left out unless
    --all: id owner status holder updated repo line. holder is the live
    holder only; an item claimed by a stale one reads `ready`, as a claim
    on it would (Item.move)."""
    if args not in ([], ["--all"]):
        die("list takes only --all")
    d = items_dir()
    stale = int(os.environ.get("WORK_ITEM_STALE_SECS") or 7200)
    cutoff = iso(time.time() - stale)
    for p in sorted(d.glob("*.md")) if d.is_dir() else []:
        if not is_item_id(p.name[:-3]):
            continue
        try:
            f = dict(fold(p, cutoff))
            brief = brief_text(p)
        except OSError:
            continue  # a reader lists what it can read
        status, holder = f["status"], f["holder"]
        if holder and f["holder_stale"] == "yes":
            status, holder = ("ready" if status == "claimed" else status), ""
        if not args and status in ("done", "closed"):
            continue
        row = (f["id"], f["owner"] or "agent", status, holder, f["updated"],
               f["repo"], card_line(f, brief))
        print("\t".join(re.sub(r"[\t\r\n]", " ", v) for v in row))


def brief_section(brief, points):
    return ("## Brief\n" + (f"points: {points}\n" if points else "")
            + (f"{brief}\n" if brief else "") + "\n")


def read_brief(arg):
    """The brief text, from the argument or stdin for `-`. A `## ` line would
    end the brief early on the next read."""
    brief = sys.stdin.read().rstrip("\n") if arg == "-" else arg
    if any(l.startswith("## ") for l in brief.split("\n")):
        die("a brief line may not start with '## '")
    return brief


def check_owner(o):
    if o not in OWNERS:
        die(f"owner is agent, human-ruling or human-click, got [{o}]")


def create(args):
    opt = {"id": "", "owner": "agent", "repo": "-", "parent": "-", "model": "-",
           "effort": "-", "points": ""}
    brief, has_brief = "", False
    while args:
        a = args[0]
        if a == "--brief":
            brief, has_brief = read_brief(args[1] if len(args) > 1 else ""), True
        elif a.startswith("--") and a[2:] in opt:
            opt[a[2:]] = args[1] if len(args) > 1 else ""
        elif a == "--":
            args = args[1:]
            break
        elif a.startswith("-"):
            die(f"unknown option {a}")
        else:
            break
        args = args[2:]
    if len(args) != 1:
        die("create takes one title (quote it)")
    title = args[0]
    if not title or "\n" in title:
        die("the title is one non-empty line")
    check_owner(opt["owner"])
    for k in ("repo", "parent", "model", "effort"):
        word(k, opt[k])
    if opt["parent"] != "-" and not is_item_id(opt["parent"]):
        die(f"parent is an item id, got [{opt['parent']}]")
    if opt["points"]:
        points_ok(opt["points"])
    sid = me()
    if not LINK.search(brief):
        refuse("the brief carries no link: an http link or owner/repo#n, "
               "so a loop with no home gets a log entry first")
    it = Item(opt["id"] or f"{int(time.time())}{sid}")
    try:
        items_dir().mkdir(parents=True, exist_ok=True)
    except OSError:
        refuse(f"could not create {items_dir()}")
    it.lock()
    now = iso(time.time())
    body = (f"# {title}\n\n" + brief_section(brief, opt["points"]) + "## Log\n"
            + f"{now} {sid} status=open owner={opt['owner']} repo={opt['repo']} "
              f"parent={opt['parent']} model={opt['model']} effort={opt['effort']}\n")
    if has_brief or opt["points"]:
        body += f"{now} {sid} briefed\n"
    # Exclusive create: a second create of one id is refused, never an overwrite.
    try:
        with open(it.path, "x") as fh:
            fh.write(body)
    except FileExistsError:
        refuse(f"item {it.id} already exists: {it.path}")
    except OSError:
        refuse(f"could not write {it.path}")
    print(it.id)


def main(argv):
    cmd, args = (argv[0], argv[1:]) if argv else ("", [])
    if cmd == "create":
        return create(args)
    if cmd == "list":
        return list_items(args)
    if cmd == "dir":
        print(items_dir())
        return 0
    if cmd not in ("brief", "log", "claim", "release", "show", "fold"):
        sys.stderr.write("".join(l[4:] + "\n" for l in
                                 Path(__file__).read_text().splitlines()[4:15]))
        return 2
    it = Item(args[0] if args else "").need()
    args = args[1:]
    if cmd == "show":
        sys.stdout.write(it.path.read_text())
    elif cmd == "fold":
        print("\n".join(f"{k}={v}" for k, v in it.facts().items()))
    elif cmd == "brief":
        points = ""
        if args[:1] == ["--points"]:
            points = args[1] if len(args) > 1 else ""
            points_ok(points)
            args = args[2:]
        if len(args) != 1:
            die("brief takes the text, or - for stdin")
        brief = read_brief(args[0])
        sid = me()
        it.lock()
        it.write_brief(brief, points or it.facts()["points"])
        it.append(sid, "briefed")
    elif cmd == "log":
        if not args:
            die("log takes one or more words")
        line = " ".join(args)
        if "\n" in line:
            die("a log line is one line")
        sid = me()
        to = ""
        evidence = False
        for w in args:
            if w.startswith("status="):
                to = w[len("status="):]
            elif w.startswith("owner="):
                check_owner(w[len("owner="):])
            elif w.startswith("evidence=") and len(w) > len("evidence="):
                evidence = True
        if to == "closed":
            refuse("status=closed is the whole-tree sweep's, which does not exist yet "
                   "(docs/work-item-lifecycle.md); log status=done evidence=<link>")
        if to == "done" and not evidence:
            refuse("status=done needs evidence=<link>: the PR, commit, roll anchor or "
                   "decisions line that shows it")
        it.lock()
        if to:
            it.move(sid, to)
        it.append(sid, line)
    elif cmd == "claim":
        sid = me()
        it.lock()
        it.move(sid, "claimed")
        it.append(sid, "status=claimed")
    elif cmd == "release":
        sid = me()
        it.lock()
        if it.facts()["holder"] != sid:
            refuse(f"{it.id} is not held by this session ({sid})")
        it.move(sid, "ready")
        it.append(sid, "status=ready")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Exit as e:
        sys.stderr.write(f"work-item: {e}\n")
        sys.exit(e.code)
