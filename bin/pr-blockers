#!/usr/bin/env python3
# pr-blockers [--wait [--timeout SECONDS]] [--leave-easy] <owner/repo#n | PR URL>
#
# One line per thing that keeps the pull request from merging, each naming its
# cause and its remedy. Exit 0 when there are none, 1 when there are, 2 when
# the PR cannot be read, for any reason, including a malformed reply or a
# missing gh, never as an exit 1 with nothing on stdout. Exit 3, one stderr line and
# nothing on stdout, when the ref is not an open PR: an issue, merged, or closed. Read-only: it calls gh only to read.
#
# --wait re-reads the PR every 30 s (PRB_WAIT_INTERVAL seconds, for tests) in place
# of a hand-written polling loop, and stops at the first of: no check pending,
# so CI has settled (prints the normal output, exits 0 or 1); any blocker that
# is not a pending check, so there is no point waiting for the rest of CI
# (prints all lines, exits 1); the PR leaving the open state (exit 3, as above).
# Past --timeout seconds (default 540, under the Bash tool's ten-minute ceiling)
# it prints the current blockers and one last line saying it timed out, exit 4.
# A read that fails is retried once on the next tick, then exit 2. A pending
# check and a mergeability GitHub has not yet computed count as still waiting.
# One progress line per tick goes to stderr; stdout is the same contract.
#
# --leave-easy leaves the CI fixer its threads: while a check named `fixer`
# (or `<caller job> / fixer`, a reusable workflow's) is queued or running, an
# unresolved thread whose only comment is claude[bot]'s `[easy]` finding on
# the PR's current head prints as a `fixer's:` line, which sets no exit code
# and does not stop --wait. With no fixer pending it is an ordinary thread
# line again: the fixer has replied, or will not come. The PR-ownership
# section of rules/code.md holds the contract this serves.
#
# Lines come in priority order: open conversations (unresolved review threads,
# requested changes) first, then merge conflicts, then everything else
# (signatures, draft, checks). Both need a human or a merge before the checks
# are worth reading; conversations come first because they can often be
# settled before the conflicts are. A branch that is merely behind its base is
# no line at all: the fixup contract leaves it to the queue.
#
# Reads GitHub's view of the PR, which a local checkout cannot see: commits
# without a verified signature (the ruleset refuses them), a merge conflict,
# failing or pending checks. A PR GitHub calls BLOCKED
# for a reason none of those names gets a line saying so; it never prints
# nothing for an unexplained BLOCKED. GitHub computes mergeability lazily, so
# a fresh push can read UNKNOWN; that is a line too, never a clean exit.
#
# Every read goes over GraphQL (`gh pr view`, the review threads, the commit
# signatures), so one rate-limit bucket covers the run. A Claude Code cloud
# session refuses GraphQL (HTTP 403); there the same facts come from REST and
# the CCR threads route, shaped like the GraphQL replies, so the output is the
# same line for line. GraphQL stays first, so REST quota is not spent while the
# GraphQL bucket has budget. When GitHub answers 403 "rate limit
# exceeded" the PR is unreadable, which is itself what blocks the caller: it
# prints one blocker line with the reset time and exits 1, not 2.
import json
import os
import re
import shlex
import subprocess
import sys
import time
from datetime import datetime, timezone

sys.dont_write_bytecode = True
sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
                os.path.expanduser("~/.claude/lib")]  # lib/libpath.py
try:
    import ghrest  # noqa: E402
except ImportError:
    sys.stderr.write("pr-blockers: lib/ghrest.py not found (looked beside the tool and in ~/.claude/lib)\n")
    sys.exit(2)

FAILED = {"FAILURE", "ERROR", "TIMED_OUT", "CANCELLED", "ACTION_REQUIRED", "STARTUP_FAILURE"}
PENDING = {"PENDING", "EXPECTED", "QUEUED", "IN_PROGRESS", "WAITING", "REQUESTED"}


COMMITS = """query($owner:String!,$name:String!,$n:Int!,$endCursor:String){
  repository(owner:$owner,name:$name){pullRequest(number:$n){
    commits(first:100,after:$endCursor){pageInfo{hasNextPage endCursor}
      nodes{commit{oid author{name user{login}} signature{isValid state}}}}}}}"""


class RateLimited(Exception):
    pass


class NoGraphQL(Exception):
    pass


class NotOpen(Exception):
    """Not an open pull request; str(e) says what it is."""


def gh(*args):
    p = subprocess.run(["gh", *args], capture_output=True, text=True)
    if p.returncode != 0:
        if "rate limit" in (p.stderr + p.stdout).lower():
            raise RateLimited()
        if ghrest.NO_GRAPHQL in p.stderr + p.stdout:
            raise NoGraphQL()
        tail = ((p.stderr or p.stdout).strip().splitlines() or ["failed"])[-1]
        if "Could not resolve to a PullRequest" in tail or (  # the PR read itself; a 404 on a later route is still exit 2
                "HTTP 404" in tail and re.fullmatch(r"repos/[^/]+/[^/]+/pulls/\d+", args[-1])):
            raise NotOpen("not a pull request (an issue, or no such number)")
        sys.stderr.write(f"pr-blockers: gh {' '.join(args[:2])}: {tail}\n")
        sys.exit(2)
    return p.stdout


def parse(ref):
    m = (re.fullmatch(r"([\w.-]+)/([\w.-]+)#(\d+)", ref)
         or re.fullmatch(r"https://github\.com/([\w.-]+)/([\w.-]+)/pull/(\d+)/?(?:[#?].*)?", ref))
    if not m:
        sys.stderr.write(USAGE)
        sys.exit(2)
    return m[1], m[2], m[3]


def values(text):
    """gh api --paginate joins JSON replies back to back; read them all."""
    dec, i, out = json.JSONDecoder(), 0, []
    text = text.strip()
    while i < len(text):
        val, i = dec.raw_decode(text, i)
        out.append(val)
        while i < len(text) and text[i].isspace():
            i += 1
    return out


def reset_time():
    """When the GraphQL bucket, the only one this tool draws on, refills: read off a call's headers.
    `rate_limit` is no use: it has read a fresh bucket while the real one was spent."""
    p = subprocess.run(["gh", "api", "-i", "graphql", "-f", "query={viewer{login}}"], capture_output=True, text=True)
    m = re.search(r"^x-ratelimit-reset:\s*(\d+)", p.stdout, re.I | re.M)
    if not m:
        return "an unknown time"
    return datetime.fromtimestamp(int(m[1]), timezone.utc).strftime("%H:%MZ")


THREADS = """query($o:String!,$r:String!,$n:Int!,$endCursor:String){repository(owner:$o,name:$r){
pullRequest(number:$n){reviewThreads(first:100,after:$endCursor){pageInfo{hasNextPage endCursor}
nodes{isResolved isOutdated path line comments(first:1){totalCount
nodes{author{__typename login} body url originalCommit{oid}}}}}}}}"""


def oneline(s, n=80):
    """Comment text is written by strangers and read by agents: printable ASCII, one line, bounded."""
    return re.sub(r"[^\x20-\x7e]", "?", str(s or ""))[:n]


def graphql_threads(owner, repo, n):
    text = gh("api", "graphql", "--paginate", "-f", f"query={THREADS}",
              "-f", f"o={owner}", "-f", f"r={repo}", "-F", f"n={n}")  # -F would coerce a repo named 123 or true
    return [t for page in values(text) for t in page["data"]["repository"]["pullRequest"]["reviewThreads"]["nodes"]]


# The fixer's own test (mark-brannan/.github, .github/actions/easy-fixes/fixer.py,
# easy_threads); a drift between the two only delays a thread, never loses it.
EASY = re.compile(r"^\s*(?:\U0001F916\s*)?\[(?:nit|should)\]\s*\[easy\]")
BOT_LOGINS = {"claude", "claude[bot]"}  # GraphQL drops the [bot] that REST keeps


def fixer_pending(checks):
    """The name of a fixer check still queued or running, else None."""
    for r in checks or []:
        name = r.get("name") or ""
        if (name == "fixer" or name.endswith("/ fixer")) and (
                r.get("status") not in (None, "COMPLETED") or (r.get("conclusion") or "") in PENDING):
            return name
    return None


def fixers(t, head):
    """True when the thread is the fixer's to answer: claude[bot]'s [easy] finding on this head, unanswered."""
    comments = t["comments"]
    c = (comments["nodes"] or [{}])[0]
    author = c.get("author") or {}
    return (author.get("login") in BOT_LOGINS and author.get("__typename") == "Bot"
            and bool(EASY.match(c.get("body") or ""))
            and bool(head) and (c.get("originalCommit") or {}).get("oid") == head
            and comments.get("totalCount", len(comments["nodes"])) == 1)


def conversations(threads, decision, head=None, fixer=None):
    """fixer: the pending fixer check's name when --leave-easy holds its threads back, else None."""
    out = []
    if decision == "CHANGES_REQUESTED":
        out.append("a reviewer requested changes; fix: address the review, then re-request it")
    for t in threads:
        if t["isResolved"]:
            continue
        c = (t["comments"]["nodes"] or [{}])[0]
        who = oneline((c.get("author") or {}).get("login") or "?", 40)
        body = oneline(((c.get("body") or "").strip().splitlines() or [""])[0])
        path = oneline(t["path"], 120)
        where = f"{path}:{int(t['line'])}" if t.get("line") else path
        if fixer and fixers(t, head):
            out.append(f"fixer's: [easy] review thread at {where} {oneline(c.get('url') or '', 200)}; "
                       f"fix: none of yours while {oneline(fixer, 60)} runs; take it once the fixer replies or ends")
            continue
        out.append(f"unresolved review thread at {where} by {who}{' (outdated)' if t['isOutdated'] else ''}: "
                   f"{json.dumps(body)}; fix: answer or act on it, then resolve the thread")
    return out


def must_be_open(state, merged=False):
    """state as GitHub spells it, any case; a read without one is open, the old contract."""
    if merged or (state or "OPEN").upper() != "OPEN":
        raise NotOpen("merged" if merged or state.upper() == "MERGED" else "closed without merging")


def graphql_read(owner, repo, n):
    pr = json.loads(gh("pr", "view", n, "--repo", f"{owner}/{repo}", "--json",
                       "mergeStateStatus,mergeable,statusCheckRollup,headRefName,headRefOid,reviewDecision,state"))
    must_be_open(pr.get("state"))
    replies = values(gh("api", "graphql", "--paginate", "-f", f"query={COMMITS}",
                        "-f", f"owner={owner}", "-f", f"name={repo}", "-F", f"n={n}"))
    commits = [c["commit"] for r in replies
               for c in r["data"]["repository"]["pullRequest"]["commits"]["nodes"]]
    return pr, commits, graphql_threads(owner, repo, n)


def run_gh(args):
    return gh(*args)


def rest_read(owner, repo, n):
    """The same three reads over REST, shaped like graphql_read's."""
    r = f"repos/{owner}/{repo}"
    pr = ghrest.rest(run_gh, f"{r}/pulls/{n}")
    must_be_open(pr.get("state"), pr.get("merged"))
    if pr["mergeable"] is None:  # GitHub is still computing it after a push: one retry
        time.sleep(3)
        pr = ghrest.rest(run_gh, f"{r}/pulls/{n}")
    sha = pr["head"]["sha"]
    latest = {}
    for rv in ghrest.rest_pages(run_gh, f"{r}/pulls/{n}/reviews"):
        if rv["state"] in ("APPROVED", "CHANGES_REQUESTED", "DISMISSED"):
            latest[(rv["user"] or {}).get("login")] = rv["state"]
    checks = [{"name": c["name"], "status": c["status"].upper(), "conclusion": (c["conclusion"] or "").upper()}
              for c in ghrest.rest_pages(run_gh, f"{r}/commits/{sha}/check-runs", "check_runs")]
    checks += [{"context": s["context"], "state": s["state"].upper()}
               for s in ghrest.rest(run_gh, f"{r}/commits/{sha}/status").get("statuses") or []]
    view = {"mergeStateStatus": pr["mergeable_state"].upper(),
            "mergeable": {True: "MERGEABLE", False: "CONFLICTING"}.get(pr["mergeable"], "UNKNOWN"),
            "statusCheckRollup": checks, "headRefName": pr["head"]["ref"], "headRefOid": sha,
            "reviewDecision": "CHANGES_REQUESTED" if "CHANGES_REQUESTED" in latest.values() else ""}
    commits = [{"oid": c["sha"], "author": {"name": c["commit"]["author"]["name"],
                                            "user": {"login": (c.get("author") or {}).get("login")}},
                "signature": {"isValid": c["commit"]["verification"]["verified"],
                              "state": c["commit"]["verification"]["reason"]}}
               for c in ghrest.rest_pages(run_gh, f"{r}/pulls/{n}/commits")]
    listed = ghrest.rest(run_gh, f"{r}/pulls/{n}/ccr/review_threads")
    if len(listed) >= 100:  # the CCR route does not page, so this may be a truncated list: unread, not clean
        raise RuntimeError("100 or more review threads; the CCR list may be truncated")
    threads = []
    for t in listed:
        if t["resolved"]:
            continue
        c = ghrest.rest(run_gh, f"{r}/pulls/comments/{t['comment_ids'][0]}") if t["comment_ids"] else {}
        user = c.get("user") or {}
        threads.append({"isResolved": False, "path": c.get("path"), "line": c.get("line"),
                        "isOutdated": bool(c) and c.get("line") is None and c.get("position") is None,
                        "comments": {"totalCount": len(t["comment_ids"]), "nodes": [{
                            "author": {"__typename": user.get("type"), "login": user.get("login")},
                            "body": c.get("body"), "url": c.get("html_url"),
                            "originalCommit": {"oid": c.get("original_commit_id")}}]}})
    return view, commits, threads


def blockers(owner, repo, n, leave_easy=False):
    try:
        pr, commits, threads = graphql_read(owner, repo, n)
    except NoGraphQL:
        pr, commits, threads = rest_read(owner, repo, n)
    head, state = pr["headRefName"], pr["mergeStateStatus"]
    fixer = fixer_pending(pr.get("statusCheckRollup")) if leave_easy else None
    conflicts, out = [], []
    talk = conversations(threads, pr.get("reviewDecision"), pr.get("headRefOid"), fixer)
    for c in commits:
        v = c.get("signature") or {}
        if not v.get("isValid"):
            who = ((c["author"].get("user") or {}).get("login")) or c["author"]["name"]
            out.append(f"unsigned commit {c['oid'][:7]} by {who} (reason: {(v.get('state') or 'unsigned').lower()}); "
                       f"the ruleset requires verified signatures; fix: run `python3 ~/.claude/lib/state.py branch_brief <repo-root> {shlex.quote(head)}` and do what its recommend line says")
    if pr["mergeable"] == "CONFLICTING" or state == "DIRTY":
        conflicts.append("merge conflict with the base; fix: merge the base into the branch, resolve, never linearize afterwards")
    # BEHIND is not a line: the fixup contract (pickup skill, section 6) leaves
    # a branch that is merely behind its base alone, the queue updates it.
    if state == "DRAFT":
        out.append("the PR is a draft; fix: mark it ready for review")
    for r in pr.get("statusCheckRollup") or []:
        name = r.get("name") or r.get("context") or "?"
        done = r.get("conclusion") or r.get("state") or ""
        if r.get("status") not in (None, "COMPLETED") or done in PENDING:
            out.append(f"check pending: {name}; fix: wait for it, or read why it hangs")
        elif done in FAILED:
            out.append(f"check failing: {name} ({done.lower()}); fix: read its log and repair the cause")
    if state == "UNKNOWN" or pr["mergeable"] == "UNKNOWN":
        out.append("GitHub has not yet computed whether the PR can merge; fix: run pr-blockers again in a minute")
    out = talk + conflicts + out
    if state == "BLOCKED" and not out:
        out.append("BLOCKED, cause not named by pr-blockers: likely review approval or a ruleset rule")
    return out


USAGE = "usage: pr-blockers [--wait [--timeout SECONDS]] [--leave-easy] <owner/repo#n | PR URL>\n"
WAITING = ("check pending:", "GitHub has not yet computed")  # lines that time alone may clear
IDLE = ("the PR is a draft",)  # lines that neither stop a wait nor clear with time
FIXERS = "fixer's:"  # --leave-easy: not the caller's, so no exit code and no stop to a wait


def attempt(ref, leave_easy=False):
    """One read: (lines, None), or ([], exit code) when the PR is not open (3) or unreadable (2)."""
    try:
        return blockers(*ref, leave_easy=leave_easy), None
    except RateLimited:
        return [f"GitHub API rate limit exceeded; pr-blockers cannot read the PR until {reset_time()}; "
                "fix: wait for the reset, then run pr-blockers again"], None
    except NotOpen as e:
        sys.stderr.write(f"pr-blockers: {ref[0]}/{ref[1]}#{ref[2]} is {e}\n")
        return [], 3
    except SystemExit:  # gh() has already said why on stderr
        return [], 2
    except Exception as e:  # exit 1 means "blockers"; an unreadable PR must never look like that
        sys.stderr.write(f"pr-blockers: could not read the PR: {type(e).__name__}: {e}\n")
        return [], 2


def report(lines):
    for line in lines:
        print(line)
    return 1 if any(not x.startswith(FIXERS) for x in lines) else 0


def wait(ref, timeout, leave_easy=False):
    interval = float(os.environ.get("PRB_WAIT_INTERVAL", 30))
    deadline = time.monotonic() + timeout
    lines, failed = None, False
    while True:
        got, rc = attempt(ref, leave_easy)
        if rc == 2 and not failed:
            failed = True  # one transient failure is retried on the next tick
        elif rc:
            return rc
        else:
            failed, lines = False, got
            waiting = [x for x in got if x.startswith(WAITING)]
            idle = [x for x in got if x.startswith(IDLE + (FIXERS,))]
            if len(waiting) + len(idle) != len(got) or not waiting:  # a real blocker, or CI has settled
                return report(got)
            sys.stderr.write(f"pr-blockers: {time.strftime('%H:%M:%S')} {len(waiting)} still pending\n")
        left = deadline - time.monotonic()
        if left <= 0:
            if lines is None:
                return 2
            report(lines)
            print(f"pr-blockers: timed out after {timeout:g}s with checks still pending")
            return 4
        time.sleep(min(interval, left))


def main(argv):
    do_wait, leave_easy, timeout, refs = False, False, 540.0, []
    it = iter(argv)
    for a in it:
        if a == "--wait":
            do_wait = True
        elif a == "--leave-easy":
            leave_easy = True
        elif a == "--timeout":
            try:
                timeout = float(next(it, ""))
                if timeout < 0:
                    raise ValueError
            except ValueError:
                sys.stderr.write(USAGE)
                return 2
        elif a in ("-h", "--help"):
            sys.stderr.write(USAGE)
            return 2
        else:
            refs.append(a)
    if len(refs) != 1 or ("--timeout" in argv and not do_wait):
        sys.stderr.write(USAGE)
        return 2
    ref = parse(refs[0])
    if do_wait:
        return wait(ref, timeout, leave_easy)
    lines, rc = attempt(ref, leave_easy)
    return rc or report(lines)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
