#!/usr/bin/env python3
"""The scoping lock: one writer per scoping target, at a time.

The scoping touch point runs one session per target at a time; a held scoping
refuses rather than warns. The lock is a second, hard file beside the curia's
LIVE, which stays the soft sitting marker it is. Its format:

  <session-id> <ISO-8601 UTC> <read>

the same one-line shape as LIVE, plus <read>: the commit of the record the
run read, so a later run can tell whether the record moved since. Given the
record's path, `take` takes its commit after syncing, never before; given
anything else (an issue's updatedAt), it records that as is.

A GATE, NOT A CONVENIENCE: anything that stops the lock being read from
origin, taken and pushed -- no state repo on lib-state.sh's search path, no
origin, a pull that will not rebase, a rejected push -- exits 2 and the run
stops. A $CLAUDE_STATE_REPO with no .git is not an error: the search goes on
down that path, as it does for the shell hooks. The lock is pushed at
once, not left for the Stop hook's debounced push, because a lock another
machine cannot see is no lock.

A lease, not a hold: a scoping runs 10 to 25 minutes,
and the lock lapses SCOPING_LOCK_STALE_SECS (default 25m) after it was
taken. The lapse is the release; nothing has to run at minute 25. The
holder's own re-take keeps the original time, so re-taking never extends a
run; only a re-take after the lapse starts a new lease. A lapsed lock is
taken over, and the takeover says whose it was.

Usage:
  scoping-lock take    <dir> <session-id> <record-file|read>
                                                  0 taken, kept or retaken,
                                                  1 held (names the holder),
                                                  2 could not take
  scoping-lock check   <dir> <session-id>         the clock, local, no sync:
                                                  0 `ours <age>m of <lease>m`,
                                                  1 `held <sid> <age>m`,
                                                  3 `lapsed <age>m` or `free`: take before writing
  scoping-lock read    <dir>      `free`, or `live|stale <sid> <at> <read> <age>m`
  scoping-lock release <dir> <session-id>         removes this session's lock only
  scoping-lock read-of <file>     <sha>, or <sha>+dirty when the file has edits

<dir> is the target's folder, relative to the state repo or absolute:
state/global/curia/<id> for a curia, state/global/scoping/<key> otherwise.
"""
import os
import sys
import time
from datetime import datetime, timezone
from pathlib import Path


def state_repo():
    """lib/state.py's state_repo, the one search path for the state repo
    (cloud checkouts included): in this checkout beside the tool, else the
    seeded copy. None when it cannot be found or named."""
    here = Path(__file__).resolve().parent
    for d in (here.parent / "lib", Path.home() / ".claude" / "lib"):
        if (d / "state.py").is_file():
            sys.path.insert(0, str(d))
            break
    else:
        return None
    sys.dont_write_bytecode = True  # no __pycache__ left in the seeded tree
    import state
    r = state.state_repo()
    return Path(r) if r else None


SR = state_repo()
try:
    import gitrun
except ImportError:
    sys.exit("scoping-lock: lib/gitrun.py not found (looked beside the tool and in ~/.claude/lib)")
LEASE = int(os.environ.get("SCOPING_LOCK_STALE_SECS") or 1500)
STAMP = "%Y-%m-%dT%H:%M:%SZ"


def die(msg):
    print(f"scoping-lock: {msg}", file=sys.stderr)
    sys.exit(2)


def git(*args, cwd=SR, timeout=None):
    """Run git quietly; True when it exits 0. A timeout counts as a failure."""
    return gitrun.ok(*args, cwd=cwd, timeout=timeout)


def git_out(*args, cwd=SR):
    return gitrun.out(*args, cwd=cwd)


def lock_of(d):
    """The LOCK path relative to the state repo, which is where git wants it."""
    p = Path(d)
    if p.is_absolute():
        try:
            p = p.relative_to(SR)
        except ValueError:
            die(f"{d} is outside the state repo {SR}")
    return p / "LOCK"


def describe(line):
    """(live|stale, sid, at, read, age in minutes) for one lock line."""
    f = line.split()
    if len(f) < 2:
        return "stale", "?", "?", "?", "?"
    try:
        at = datetime.strptime(f[1], STAMP).replace(tzinfo=timezone.utc).timestamp()
    except ValueError:
        at = 0
    age = int(time.time() - at)
    return ("stale" if age >= LEASE else "live"), f[0], f[1], (f[2] if len(f) > 2 else "?"), age // 60


def sync():
    """Bring origin's copy of every lock in before reading this one."""
    if git("pull", "--rebase", "--autostash", "-q", timeout=120):
        return True
    git("rebase", "--abort")
    return False


def push():
    """Mirrors stop-continuity.sh: two tries, never leave a rebase wedged."""
    for attempt in (1, 2):
        sync()
        if git("push", "-q", "origin", "HEAD", timeout=120):
            return True
        time.sleep(attempt)
    return False


def commit_lock(lock, message):
    """Commit only that one path. A re-take that wrote the same line has nothing to commit."""
    if git("diff", "--quiet", "HEAD", "--", str(lock)) and git("ls-files", "--error-unmatch", "--", str(lock)):
        return True
    return git("-c", f"user.name={os.environ.get('GIT_AUTHOR_NAME', 'Claude')}",
               "-c", f"user.email={os.environ.get('GIT_AUTHOR_EMAIL', 'noreply@anthropic.com')}",
               "-c", "commit.gpgsign=false", "commit", "-q", "--only", "-m", message, "--", str(lock))


def read_of(f):
    f = Path(f)
    sha = git_out("log", "-1", "--format=%h", "--", f.name, cwd=f.parent) if f.parent.is_dir() else ""
    if not sha:
        die(f"{f} has no commit")
    return sha if git("diff", "--quiet", "HEAD", "--", f.name, cwd=f.parent) else sha + "+dirty"


def take(lock, sid, read_at):
    if not sync():
        die("cannot sync with origin; a lock another machine cannot see is no lock")
    rf = Path(read_at) if Path(read_at).is_absolute() else SR / read_at
    if rf.is_file():
        read_at = read_of(rf)
    path = SR / lock
    at, done = datetime.now(timezone.utc).strftime(STAMP), "taken"
    if path.is_file():
        state, holder, held_at, held_read, age = describe(path.read_text())
        if holder != sid:
            if state == "live":
                print(f"held: {holder} since {held_at}, read {held_read}, {age}m ago ({lock})")
                return 1
            print(f"stale: {holder} since {held_at}, {age}m ago; taking it over")
        elif state == "live":
            at, done = held_at, f"kept, {age}m of {LEASE // 60}m"
            if held_read != read_at:
                print(f"read moved: {held_read} -> {read_at}")
        else:
            done = "retaken"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(f"{sid} {at} {read_at}\n")
    except OSError as e:
        die(f"cannot write {lock}: {e}")
    before = git_out("rev-parse", "HEAD")
    if not (git("add", "--", str(lock)) and commit_lock(lock, f"scoping lock: take {lock} ({sid[:8]})")):
        die(f"cannot commit {lock}")
    ours = git_out("rev-parse", "HEAD")
    if not push():
        # A lost race or a dead origin. An unpushed lock commit left here would
        # conflict with the winner's on every later pull, so drop it.
        if ours != before and git_out("rev-parse", "HEAD") == ours:
            git("reset", "-q", "--keep", before)
        die("lock not pushed, so not taken; another machine may hold it. Run read after the next sync")
    # Two sessions on this machine can both pass the check above; the file says who won.
    winner = path.read_text().split()[0]
    if winner != sid:
        print(f"held: {winner} ({lock})")
        return 1
    print(f"{done}: {lock}")
    return 0


def check(lock, sid):
    path = SR / lock
    if not path.is_file():
        print("free")
        return 3
    state, holder, _, _, age = describe(path.read_text())
    if holder == sid:
        if state == "live":
            print(f"ours {age}m of {LEASE // 60}m")
            return 0
        print(f"lapsed {age}m")
        return 3
    if state == "live":
        print(f"held {holder} {age}m")
        return 1
    print("free")
    return 3


def release(lock, sid):
    if not sync():
        die("cannot sync with origin")
    path = SR / lock
    if not path.is_file():
        print("free")
        return 0
    holder = (path.read_text().split() or ["?"])[0]
    if holder != sid:
        print(f"not ours: {holder} holds {lock}; left in place")
        return 1
    if not git("rm", "-q", "--", str(lock)):
        path.unlink(missing_ok=True)
    if not commit_lock(lock, f"scoping lock: release {lock} ({sid[:8]})"):
        die("cannot commit the release")
    if not push():
        die("release committed but not pushed; the next Stop pushes it")
    print(f"released: {lock}")
    return 0


def main(argv):
    if len(argv) < 2:
        print(__doc__[__doc__.index("Usage:"):].rstrip(), file=sys.stderr)
        return 2
    cmd, args = argv[0], argv[1:]
    if cmd == "read-of":
        print(read_of(args[0]))
        return 0
    if SR is None:  # state_repo() names only a directory that has a .git
        die("no state repo on lib-state.sh's search path (lib/state.py)")
    lock = lock_of(args[0])
    if cmd == "read":
        path = SR / lock
        if path.is_file():
            print("{} {} {} {} {}m".format(*describe(path.read_text())))
        else:
            print("free")
        return 0
    if cmd == "take":
        if len(args) != 3:
            die("take needs <dir> <session-id> <record-file|read>")
        return take(lock, args[1], args[2])
    if cmd in ("check", "release"):
        if len(args) < 2 or not args[1]:
            die(f"{cmd} needs <dir> <session-id>")
        return (check if cmd == "check" else release)(lock, args[1])
    die(f"unknown command {cmd}")


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
