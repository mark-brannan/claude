#!/usr/bin/env python3
# SOFT SHOULD: id generation belongs in lib/ids.py, the one home for every
# entity's id (card 17910884757abba648). This script still makes a roll-entry stamp itself;
# move it there when convenient, no deadline.
# agent-decision -- append an agent's pencil call to the decisions logs.
#
#   agent-decision [--repo <dir>] [--curia <id>]... [--undo <text>]
#                  [--link <url>] <the call>
#
# One entry, appended to <repo>/docs/agent_decisions.md (the repo is the git
# checkout holding the cwd unless --repo names one) and, for each --curia, to
# that curia's agent_decisions.md in the state repo:
#
#   ### 20261003t232843z
#   - Points on the brief are 1 2 3 5 8 13. Undo: revert the scale line. ([#511](https://...))
#
# The heading is the curia roll's stamp, UTC to the second, so an entry's
# anchor is `#<stamp>` (work item 179098332512f38edd).
# Both files are append-only: nothing edits an entry after it is written.
# Two calls in the same second share one heading, as roll.md's words do. The
# curia copy never goes in roll.md, which holds the user's words alone.
#
# The repo file and its header are created on the first entry; a curia must
# already have its folder. The repo's .gitattributes gets
# `docs/agent_decisions.md merge=union` if it lacks it, so two PRs that each
# append an entry rebase without a conflict; commit it with the entry.
# A bare GitHub PR or issue URL in --link is written as [#<n>](<url>).
# Exits 0 on success, 1 when a target is refused, 2 on usage. Python 3
# stdlib only.
import argparse
import datetime
import fcntl
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "hooks"))
import lib_state  # noqa: E402

HEADER = """# Agent decisions

Append-only. Each entry is a call an agent made in pencil: a default it took
under the one-way-door test, with its undo. Written by `agent-decision`; the
heading is the UTC stamp, so `agent_decisions.md#<stamp>` links one entry.
"""
LAST = re.compile(rb"\n### (\d{8}t\d{6}z)\n(?:- [^\n]*\n)+\Z")
UNION = "docs/agent_decisions.md merge=union"
GH_URL = re.compile(r"https://github\.com/[^/\s]+/[^/\s]+/(?:pull|issues)/(\d+)\S*")


def line(call, undo, link):
    text = " ".join(call.split())
    if undo:
        text += " Undo: " + " ".join(undo.split())
    if link:
        link = " ".join(link.split())
        m = GH_URL.fullmatch(link)
        text += f" ([#{m.group(1)}]({link}))" if m else f" ({link})"
    return f"- {text}\n"


def append(path, bullet, now, header=""):
    """Append one bullet under this second's heading, under an exclusive lock."""
    stamp = now.strftime("%Y%m%dt%H%M%Sz")
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        old = os.pread(fd, os.fstat(fd).st_size, 0)
        m = LAST.search(old)
        same = m and m.group(1).decode() == stamp
        text = ("" if old else header) + ("" if same else f"\n### {stamp}\n") + bullet
        os.write(fd, text.encode("utf-8"))
    finally:
        os.close(fd)


def ensure_union(root):
    """Add the union-merge line to the repo's .gitattributes; True if added."""
    path = os.path.join(root, ".gitattributes")
    try:
        with open(path, encoding="utf-8") as f:
            old = f.read()
    except FileNotFoundError:
        old = ""
    if UNION in old.splitlines():
        return False
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o644)
    try:
        os.write(fd, (("\n" if old and not old.endswith("\n") else "") + UNION + "\n").encode())
    finally:
        os.close(fd)
    return True


def repo_root(given):
    out = subprocess.run(["git", "-C", given or ".", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True)
    return os.path.realpath(out.stdout.strip()) if out.returncode == 0 else None


def main(argv):
    p = argparse.ArgumentParser(prog="agent-decision", add_help=True)
    p.add_argument("--repo")
    p.add_argument("--curia", action="append", default=[])
    p.add_argument("--undo")
    p.add_argument("--link")
    p.add_argument("call", nargs="+")
    a = p.parse_args(argv)
    call = " ".join(" ".join(a.call).split())
    if not call:
        print("agent-decision: the call is empty", file=sys.stderr)
        return 2
    bullet = line(call, a.undo, a.link)
    root = repo_root(a.repo)
    if not root or not os.path.isdir(root):
        print("agent-decision: not in a git checkout; pass --repo", file=sys.stderr)
        return 1
    targets = [(os.path.join(root, "docs", "agent_decisions.md"), HEADER)]
    if a.curia:
        state = lib_state.state_dir()
        for cid in a.curia:
            folder = os.path.join(state or "", "curia", cid)
            if not state or not re.fullmatch(r"[A-Za-z0-9][\w.-]*", cid) or not os.path.isdir(folder):
                print(f"agent-decision: no curia folder for {cid!r}", file=sys.stderr)
                return 1
            targets.append((os.path.join(folder, "agent_decisions.md"), HEADER))
    docs = os.path.join(root, "docs")
    if os.path.realpath(docs) != docs:  # O_NOFOLLOW guards only the last component
        print(f"agent-decision: {docs} is a symlink", file=sys.stderr)
        return 1
    now = datetime.datetime.now(datetime.timezone.utc)
    os.makedirs(docs, exist_ok=True)
    try:
        if ensure_union(root):
            print(os.path.join(root, ".gitattributes"))
        for path, header in targets:
            append(path, bullet, now, header)
            print(path)
    except OSError as e:  # ELOOP: a symlink in the target's place
        print(f"agent-decision: {e.filename}: {e.strerror}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
