#!/usr/bin/env bash
# headersHelper for the user-scope `github-pat` MCP server: prints the
# Authorization header as JSON, reading the token from the sops-decrypted
# file so it never sits in a tracked or MCP config file.
# Reads the first GITHUB_PERSONAL_ACCESS_TOKEN= line; tolerates an `export `
# prefix, one pair of surrounding quotes and CRLF line endings.
set -euo pipefail
f="$HOME/.config/secrets/github-token.env"
[ -r "$f" ] || { echo "no readable $f" >&2; exit 1; }
tok=$(sed -n -e 's/\r$//' \
  -e 's/^\(export[[:space:]]\{1,\}\)\{0,1\}GITHUB_PERSONAL_ACCESS_TOKEN=//' \
  -e 't found' -e 'd' \
  -e ': found' -e "s/^\"\(.*\)\"\$/\1/" -e "s/^'\(.*\)'\$/\1/" -e 'p' -e 'q' "$f")
[ -n "$tok" ] || { echo "no token in $f" >&2; exit 1; }
printf '{"Authorization":"Bearer %s"}\n' "$tok"
