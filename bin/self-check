#!/usr/bin/env python3
# self-check: one table that says whether the live layer is the one on main
# and whether this session's hooks are firing, for the moment the readouts
# go quiet and nothing says why.
#
# Rows: the live ~/.claude clone's branch and sha against origin/main, its
# dirty files, the hooks that traced a swallowed error in the last day, this
# session's hook records by event and the last one, the metrics cache's last
# event, and the metrics hook run by hand on this session's transcript, its
# stderr kept. The hand run writes to a scratch
# state repo, so the live crossing state is never advanced by a check.
#
# Usage: self-check [SESSION_ID | TRANSCRIPT] [--offline]
#
# The session defaults to $CLAUDE_CODE_SESSION_ID; outside a session, with none
# given, it lists the newest sessions with hook records to pick from.
# --offline skips the fetch of origin/main. Exit 1 when any row is bad, 0 otherwise, 2 on usage.
# Python 3 stdlib only; needs lib/ beside it or in ~/.claude/lib (exit 3 if not).
import argparse
import collections
import glob
import json
import os
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

NAME = "self-check"
sys.dont_write_bytecode = True
sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
                os.path.expanduser("~/.claude/lib")]  # lib/libpath.py
try:
    import gitrun  # noqa: E402
    import hooktrace  # noqa: E402
    import jsonl  # noqa: E402
    import state  # noqa: E402
    import when as when_  # noqa: E402
except ImportError:
    print("%s: lib/ not found (looked beside the tool and in ~/.claude/lib)" % NAME, file=sys.stderr)
    sys.exit(3)

LIVE = os.path.expanduser("~/.claude")
HOOK = os.path.join(LIVE, "hooks", "metrics-live.py")


def git(*args, timeout=None):
    p = gitrun.run("-C", LIVE, *args, timeout=timeout)
    return p.stdout.rstrip() if p.returncode == 0 else None


def live_row(fetch):
    """The clone every session runs: on main, tracking a live upstream, not behind."""
    fetched = git("fetch", "-q", "origin", "main", timeout=20) is not None if fetch else None
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if branch is None:
        return ("bad", "%s is not a git clone" % LIVE)
    sha = git("rev-parse", "--short", "HEAD")
    main = git("rev-parse", "--short", "origin/main")
    if main is None:
        return ("bad", "%s @ %s, no origin/main" % (branch, sha))
    track = git("for-each-ref", "--format=%(upstream:track)", "refs/heads/" + branch) or ""
    counts = git("rev-list", "--left-right", "--count", "HEAD...origin/main")
    ahead, behind = (int(n) for n in counts.split()) if counts else (0, 0)
    value = "%s @ %s, origin/main %s, %d behind, %d ahead" % (branch, sha, main, behind, ahead)
    if "gone" in track:
        value += ", upstream deleted"
    if fetched is not True:
        value += ", not fetched" if fetched is None else ", fetch failed (origin/main may be stale)"
    if branch != "main" or behind or "gone" in track:
        return ("bad", value)
    return ("warn" if ahead or fetched is not True else "ok", value)


def dirty_row():
    out = git("status", "--porcelain")
    if out is None:
        return ("bad", "git status failed")
    paths = [line[3:] for line in out.splitlines()]
    if not paths:
        return ("ok", "clean")
    return ("warn", "%d: %s" % (len(paths), ", ".join(paths[:5]) + (" ..." if len(paths) > 5 else "")))


def hook_records(transcript):
    """Every hook attachment in the transcript, oldest first."""
    recs = []
    for entry in jsonl.read(transcript):
        a = entry.get("attachment") if entry.get("type") == "attachment" else None
        if isinstance(a, dict) and a.get("hookEvent"):
            recs.append({"ts": entry.get("timestamp", ""), "event": a["hookEvent"],
                         "name": a.get("hookName", ""), "type": a.get("type", ""),
                         "exit": a.get("exitCode")})
    return recs


def last_event(transcript):
    """Timestamp of the newest tool result or typed prompt: each one fires the metrics hook.

    A denied call fires no PostToolUse and a failed one fires PostToolUseFailure, which
    the metrics hook is not wired to, so neither counts."""
    last = None
    for entry in jsonl.read(transcript):
        if entry.get("type") != "user":
            continue
        content = (entry.get("message") or {}).get("content")
        results = [c for c in content if isinstance(c, dict) and c.get("type") == "tool_result"] \
            if isinstance(content, list) else []
        if results:
            if not entry.get("toolDenialKind") and not any(c.get("is_error") for c in results):
                last = entry.get("timestamp")
        elif (entry.get("origin") or {}).get("kind") == "human":
            last = entry.get("timestamp")
    return last


# The metrics hook rewrites its cache on every record; this much behind one is a broken hook.
STALE_CACHE_SECONDS = 120
# The hook writes the cache before the event lands in the transcript: p99 1 s over 1,000 sessions.
CACHE_BEHIND_EVENT_SECONDS = 10


def when(ts):
    """An ISO timestamp as an aware datetime, or None."""
    try:
        return when_.parse(ts)
    except (AttributeError, ValueError):
        return None


def ago(t, now):
    return "%ds ago" % (now - t).total_seconds() if t else "at an unreadable time"


def hook_rows(recs, now):
    if not recs:
        return [("bad", "none in this transcript"), ("bad", "-")]
    by_event = collections.Counter(r["event"] for r in recs)
    failed = sum(1 for r in recs if r["exit"] not in (None, 0))
    counts = ", ".join("%s %d" % kv for kv in sorted(by_event.items()))
    if failed:
        counts += "; %d non-zero exits" % failed
    # A record lands only when a hook prints something, so its age says nothing about liveness.
    last, t = recs[-1], when(recs[-1]["ts"])
    return [("warn" if failed else "ok", counts),
            ("ok", "%s %s, %s" % (last["name"], last["type"], ago(t, now)))]


def cache_row(state_dir, sid, last_record, last_evt, now):
    """The file the statusline prints from; state_shard_path in hooks/lib-state.sh."""
    live = os.path.join(state_dir, "metrics", "live")
    path = os.path.join(live, sid + ".json")
    if not os.path.exists(path):
        path = os.path.join(live, sid[:2] or "_", sid + ".json")
    try:
        with open(path, encoding="utf-8") as fh:
            cache = json.load(fh)
    except (OSError, ValueError):
        return ("bad", "no cache at %s" % path)
    t, hook_t, evt_t = when(cache.get("updated_at")), when(last_record), when(last_evt)
    value = "%s, %s" % (cache.get("last_event", "?"), ago(t, now))
    if t is None:
        return ("bad", value)
    if evt_t and (evt_t - t).total_seconds() > CACHE_BEHIND_EVENT_SECONDS:
        return ("bad", value + ", %ds behind the last tool result or prompt" % (evt_t - t).total_seconds())
    if hook_t and (hook_t - t).total_seconds() > STALE_CACHE_SECONDS:
        return ("bad", value + ", older than the last hook record")
    return ("ok", value)


state_dir = state.state_dir


def hand_run_row(transcript, sid, cwd):
    """metrics-live.py as PostToolUse wires it, against a scratch state repo, stderr kept."""
    if not os.path.isfile(HOOK):
        return ("bad", "%s missing" % HOOK)
    payload = json.dumps({"session_id": sid, "transcript_path": transcript, "cwd": cwd,
                          "hook_event_name": "PostToolUse", "tool_name": "Bash",
                          "tool_input": {"command": "true"}})
    with tempfile.TemporaryDirectory(prefix="self-check-") as scratch:
        os.mkdir(os.path.join(scratch, ".git"))
        env = dict(os.environ, CLAUDE_STATE_REPO=scratch)
        try:
            p = subprocess.run([sys.executable, HOOK, "posttooluse", "0", "show"], input=payload, env=env,
                               capture_output=True, text=True, timeout=60)
        except subprocess.TimeoutExpired:
            return ("bad", "timed out after 60s")
    try:
        msg = json.loads(p.stdout).get("systemMessage", "") if p.stdout.strip() else ""
    except ValueError:
        msg = ""
    err = p.stderr.strip().splitlines()
    value = "exit %d, block %s, stderr %s" % (
        p.returncode, "%d lines" % len(msg.splitlines()) if msg else "empty",
        repr(err[0][:80]) if err else "empty")
    if p.returncode or err:
        return ("bad", value)
    return ("ok" if msg else "warn", value)


def hook_errors_row(sd, rows=None):
    """Hooks that traced a swallowed error in the last day (lib/hooktrace.py)."""
    rows = hooktrace.recent(sd) if rows is None else rows
    if not rows:
        return ("ok", "none traced in the last day")
    return ("warn", "%d: %s" % (len(rows), hooktrace.summary(rows)))


def find_transcript(arg):
    if arg and os.path.isfile(arg):
        return arg, os.path.splitext(os.path.basename(arg))[0]
    sid = arg or os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if not sid:
        return None, ""
    # A prefix will do, so the eight characters the session list prints are enough.
    hits = glob.glob(os.path.join(LIVE, "projects", "*", sid + "*.jsonl"))
    if len(hits) != 1:
        return None, sid
    return hits[0], os.path.splitext(os.path.basename(hits[0]))[0]


def recent_sessions(now, n=5, scan=50):
    """The newest transcripts with hook records, as "id8 age project"; headless runs have none."""
    paths = sorted(glob.glob(os.path.join(LIVE, "projects", "*", "*.jsonl")), key=os.path.getmtime, reverse=True)
    out = []
    for path in paths[:scan]:
        with open(path, encoding="utf-8", errors="replace") as fh:
            if '"hookEvent"' not in fh.read():
                continue
        age = now.timestamp() - os.path.getmtime(path)
        out.append("%s %ds ago %s" % (os.path.basename(path)[:8], age, os.path.basename(os.path.dirname(path))))
        if len(out) == n:
            break
    return out


def table(rows):
    w = max(len(r[0]) for r in rows)
    return "\n".join("%-4s  %-*s  %s" % (s, w, label, value) for label, s, value in rows)


def main(argv):
    ap = argparse.ArgumentParser(prog=NAME, description="Is the live layer on main, and are this session's hooks firing?")
    ap.add_argument("session", nargs="?", help="session id or its prefix, or a transcript path (default: $CLAUDE_CODE_SESSION_ID)")
    ap.add_argument("--offline", action="store_true", help="skip the fetch of origin/main")
    args = ap.parse_args(argv)

    rows = [("live ~/.claude", *live_row(not args.offline)), ("dirty files", *dirty_row()),
            ("hook errors", *hook_errors_row(state_dir()))]
    transcript, sid = find_transcript(args.session)
    now = datetime.now(timezone.utc)
    if transcript:
        recs = hook_records(transcript)
        records, last = hook_rows(recs, now)
        rows += [("hook records", *records), ("last hook record", *last),
                 ("metrics cache", *cache_row(state_dir(), sid, recs[-1]["ts"] if recs else None,
                                              last_event(transcript), now)),
                 ("metrics hook by hand", *hand_run_row(transcript, sid, os.getcwd()))]
    elif sid:
        rows.append(("transcript", "bad", "no single transcript for session %r" % sid))
    else:
        rows.append(("session", "warn", "none given; pass one of the newest below"))

    print("%s  session %s  %s\n" % (NAME, (sid or "-")[:8], when_.stamp(now.timestamp())))
    print(table(rows))
    if not sid:
        print("\n" + "\n".join("  " + s for s in recent_sessions(now)))
    return 1 if any(s == "bad" for _, s, _ in rows) else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
