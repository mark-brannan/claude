#!/usr/bin/env python3
"""curia-quotes: check that every quote a curia digest cites from the roll is in the roll.

Usage: curia-quotes DIGEST_OR_CURIA_DIR ...

A citation is `<curia>/roll.md#<stamp>`, or a bare `#<stamp>` (or `roll.md#<stamp>`)
which means the curia last named on the line, else the digest's own. On a line
with citations, each quoted span ("..." or curly quotes) of two words or more
must match the text of one of the entries that line cites. Allowed, as the
curia skill's digests do: `[...]` or an ellipsis for a cut, `[bracketed]` edits
(each a wildcard), case and punctuation and whitespace differences, and small
typo fixes (a segment need only be 90% similar). Segments match on word
boundaries, except where a bracket cuts into a word (`[T]he`, `use[d]`). A cited
stamp with no entry in the roll is a mismatch too. Straight quotes pair left to
right, so one unbalanced `"` on a citing line misreads the quotes after it.

Exits 1 and names each mismatch as `file:line: reason: "quote"`; 0 when all
match; 2 on a usage error.

The stamp pattern and roll-entry parse are kept local: lib/ids.py and
hooks/curia-roll.py own the stamp format and are being refactored.
"""
import difflib
import re
import sys
from pathlib import Path

sys.dont_write_bytecode = True

STAMP = r"\d{8}t\d{6}z"
# A curia name starts with a word character, so ".." never names a folder
# outside the curia folders.
REF = re.compile(rf"(?<![\w.-])(?:(\w[\w.-]*)/)?roll\.md#({STAMP})|(?<![\w./-])#({STAMP})")
ENTRY = re.compile(rf"^### ({STAMP})\n(`{{3,}})\n(.*?)\n\2$", re.S | re.M)
QUOTE = re.compile(r'"([^"\n]+)"|“([^”\n]+)”')
CUT = re.compile(r"\[[^\]]*\]|\.\.\.|…")
THRESHOLD = 0.9


def load_roll(path):
    """{stamp: text}; entries sharing a stamp are joined by a blank line."""
    out = {}
    for m in ENTRY.finditer(path.read_text(encoding="utf-8", errors="replace")):
        out[m.group(1)] = out[m.group(1)] + "\n\n" + m.group(3) if m.group(1) in out else m.group(3)
    return out


def norm(s):
    return " ".join(re.sub(r"[\W_]+", " ", s.casefold()).split())


def segment_end(seg, text, at, lopen, ropen):
    """Offset in text just past seg's first match at or after at: exact, on word
    boundaries save an open side, else the best fuzzy word window at THRESHOLD;
    -1 if none. text is normalized and padded with a space at each end."""
    needle = ("" if lopen else " ") + seg + ("" if ropen else " ")
    i = text.find(needle, at)
    if i >= 0:
        return i + len(needle) - (not ropen)
    spans = [m.span() for m in re.finditer(r"\S+", text[at:])]
    n = len(seg.split(" "))
    best, best_end = 0.0, -1
    for k in range(len(spans)):
        for w in {max(1, n - 1), n, n + 1}:
            if k + w > len(spans):
                continue
            cand = text[at + spans[k][0]:at + spans[k + w - 1][1]]
            r = difflib.SequenceMatcher(None, seg, cand, autojunk=False).ratio()
            if r > best:
                best, best_end = r, at + spans[k + w - 1][1]
    return best_end if best >= THRESHOLD else -1


def quote_matches(quote, text):
    """Every segment of the quote, in order, somewhere in the entry."""
    text, at = f" {norm(text)} ", 0
    bounds = [0, *(x for m in CUT.finditer(quote) for x in m.span()), len(quote)]
    for j in range(0, len(bounds), 2):
        raw = quote[bounds[j]:bounds[j + 1]]
        seg = norm(raw)
        if not seg:
            continue
        lopen = j > 0 and quote[bounds[j] - 1] == "]" and raw[:1].isalnum()
        ropen = bounds[j + 1] < len(quote) and quote[bounds[j + 1]] == "[" and raw[-1:].isalnum()
        end = segment_end(seg, text, at, lopen, ropen)
        if end < 0:
            return False
        at = end
    return True


def check(digest):
    problems, rolls = [], {}
    own = digest.parent.name

    def roll_of(curia):
        if curia not in rolls:
            p = digest.parent / "roll.md" if curia == own else digest.parent.parent / curia / "roll.md"
            rolls[curia] = load_roll(p) if p.is_file() else None
        return rolls[curia]

    for n, line in enumerate(digest.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        cited, curia = [], own
        for m in REF.finditer(line):
            curia = m.group(1) or curia
            cited.append((curia, m.group(2) or m.group(3)))
        texts = []
        for c, stamp in cited:
            roll = roll_of(c)
            if roll is None:
                problems.append(f"{digest}:{n}: no roll.md for curia {c} (cited #{stamp})")
            elif stamp not in roll:
                problems.append(f"{digest}:{n}: no entry {stamp} in {c}/roll.md")
            else:
                texts.append(roll[stamp])
        if not texts:
            continue
        for m in QUOTE.finditer(line):
            q = m.group(1) or m.group(2)
            if len(norm(q).split()) >= 2 and not any(quote_matches(q, t) for t in texts):
                problems.append(f'{digest}:{n}: not in the cited entry: "{q}"')
    return problems


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: curia-quotes DIGEST_OR_CURIA_DIR ...", file=sys.stderr)
        return 2
    problems = []
    for a in argv:
        p = Path(a)
        p = p / "digest.md" if p.is_dir() else p
        if not p.is_file():
            print(f"curia-quotes: no such digest: {a}", file=sys.stderr)
            return 2
        problems += check(p.resolve())
    for line in problems:
        print(line)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
