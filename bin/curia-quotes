#!/usr/bin/env python3
"""curia-quotes: check that every quote a curia digest cites from the roll is in the roll.

Usage: curia-quotes DIGEST_OR_CURIA_DIR ...
       curia-quotes --flips ROLL_OR_CURIA_DIR [--since STAMP]

A citation is `<curia>/roll.md#<stamp>`, or a bare `#<stamp>` (or `roll.md#<stamp>`)
which means the curia last named on the line, else the digest's own. On a line
with citations, each quoted span ("..." or curly quotes) of two words or more
must match the text of one of the entries that line cites. Allowed, as the
curia skill's digests do: `[...]` or an ellipsis for a cut, `[bracketed]` edits
(each a wildcard), case and punctuation and whitespace differences, and a
typo fix in any word of three letters or more (one edit, two in a word of
seven or more); a shorter word must match, as `on`, `or` and `of` are one
edit apart. Segments match word for word, except where a bracket cuts into a
word (`[T]he`, `use[d]`). A negation or a number, in digits or words, must
match exactly, so a fix never flips what was said. A cited stamp with no entry
in the roll is a mismatch too. Straight quotes pair left to right, so one unbalanced `"` on a
citing line misreads the quotes after it.

--flips lists flip candidates instead: each sentence of a roll entry after
STAMP (all entries without it) that holds a negation or a number and reads
non-emphatic (no "!", and that word not in capitals, so an acronym such as
ADR leaves it listed), as `stamp: sentence`. It is the
lint facet's list for the next open; it always exits 0.

Exits 1 and names each mismatch as `file:line: reason: "quote"`; 0 when all
match; 2 on a usage error.

The stamp pattern and roll-entry parse are kept local: lib/ids.py and
hooks/curia-roll.py own the stamp format and are being refactored.
"""
import re
import sys
from pathlib import Path

sys.dont_write_bytecode = True

STAMP = r"\d{8}t\d{6}z"
# A curia name starts with a word character and a path prefix before it is no
# citation, so "../roll.md#<stamp>" never reads a roll outside the curia folders.
REF = re.compile(rf"(?<![\w./-])(?:(\w[\w.-]*)/)?roll\.md#({STAMP})|(?<![\w./-])#({STAMP})")
ENTRY = re.compile(rf"^### ({STAMP})\n(`{{3,}})\n(.*?)\n\2$", re.S | re.M)
QUOTE = re.compile(r'"([^"\n]+)"|“([^”\n]+)”')
CUT = re.compile(r"\[[^\]]*\]|\.\.\.|…")
NEGATIONS = set("""no not nor never none nothing nobody nowhere neither without
cannot cant dont doesnt didnt wont wouldnt shouldnt couldnt isnt arent wasnt
werent hasnt havent hadnt mustnt neednt mightnt shant oughtnt aint unless except
zero one two three four five six seven eight nine ten eleven twelve twenty
hundred thousand million first second third half once twice""".split())


def load_roll(path):
    """{stamp: text}; entries sharing a stamp are joined by a blank line."""
    out = {}
    for m in ENTRY.finditer(path.read_text(encoding="utf-8", errors="replace")):
        out[m.group(1)] = out[m.group(1)] + "\n\n" + m.group(3) if m.group(1) in out else m.group(3)
    return out


def norm(s):
    """Casefolded words, punctuation dropped; an apostrophe joins (don't -> dont)."""
    return " ".join(re.sub(r"[\W_]+", " ", re.sub(r"['’]", "", s.casefold())).split())


def guarded(w):
    return w in NEGATIONS or any(c.isdigit() for c in w)


def edits(a, b):
    """Damerau-Levenshtein distance (adjacent swaps count as one edit)."""
    d = [[i + j if i * j == 0 else 0 for j in range(len(b) + 1)] for i in range(len(a) + 1)]
    for i in range(1, len(a) + 1):
        for j in range(1, len(b) + 1):
            d[i][j] = min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + (a[i - 1] != b[j - 1]))
            if i > 1 and j > 1 and a[i - 1] == b[j - 2] and a[i - 2] == b[j - 1]:
                d[i][j] = min(d[i][j], d[i - 2][j - 2] + 1)
    return d[-1][-1]


def word_matches(q, t, lopen=False, ropen=False):
    """q (quoted) stands for t (roll): equal, or a typo fix of one edit (two in
    a word of seven letters or more) when neither is a negation or a number.
    An open side matches a word the bracket cuts into."""
    if lopen and ropen:
        return q in t
    if lopen or ropen:
        return t.endswith(q) if lopen else t.startswith(q)
    if q == t:
        return True
    if guarded(q) or guarded(t) or min(len(q), len(t)) < 3:
        return False
    return edits(q, t) <= (2 if min(len(q), len(t)) >= 7 else 1)


def segment_end(seg, words, at, lopen, ropen):
    """Index in words just past seg's first word-for-word match at or after
    at, or -1. The first and last words may be open where a bracket cuts in."""
    n = len(seg)
    for k in range(at, len(words) - n + 1):
        if all(word_matches(q, words[k + i], lopen and i == 0, ropen and i == n - 1)
               for i, q in enumerate(seg)):
            return k + n
    return -1


def quote_matches(quote, text):
    """Every segment of the quote, in order, somewhere in the entry."""
    words, at = norm(text).split(), 0
    bounds = [0, *(x for m in CUT.finditer(quote) for x in m.span()), len(quote)]
    for j in range(0, len(bounds), 2):
        raw = quote[bounds[j]:bounds[j + 1]]
        seg = norm(raw).split()
        if not seg:
            continue
        lopen = j > 0 and quote[bounds[j] - 1] == "]" and raw[:1].isalnum()
        ropen = bounds[j + 1] < len(quote) and quote[bounds[j + 1]] == "[" and raw[-1:].isalnum()
        end = segment_end(seg, words, at, lopen, ropen)
        if end < 0:
            return False
        at = end
    return True


def check(digest):
    problems, rolls = [], {}
    own = digest.parent.name

    def roll_of(curia):
        if curia not in rolls:
            p = digest.parent / "roll.md" if curia == own else digest.parent.parent / curia / "roll.md"
            rolls[curia] = load_roll(p) if p.is_file() else None
        return rolls[curia]

    for n, line in enumerate(digest.read_text(encoding="utf-8", errors="replace").splitlines(), 1):
        cited, curia = [], own
        for m in REF.finditer(line):
            curia = m.group(1) or curia
            cited.append((curia, m.group(2) or m.group(3)))
        texts = []
        for c, stamp in cited:
            roll = roll_of(c)
            if roll is None:
                problems.append(f"{digest}:{n}: no roll.md for curia {c} (cited #{stamp})")
            elif stamp not in roll:
                problems.append(f"{digest}:{n}: no entry {stamp} in {c}/roll.md")
            else:
                texts.append(roll[stamp])
        if not texts:
            continue
        for m in QUOTE.finditer(line):
            q = m.group(1) or m.group(2)
            if len(norm(q).split()) >= 2 and not any(quote_matches(q, t) for t in texts):
                problems.append(f'{digest}:{n}: not in the cited entry: "{q}"')
    return problems


def flips(roll, since=""):
    """[(stamp, sentence)]: sentences of entries after since where one word
    (a negation or a number) could flip the meaning, and the tone is plain."""
    out = []
    for stamp, text in sorted(load_roll(roll).items()):
        if stamp <= since:
            continue
        for sent in re.split(r"(?<=[.?!])\s+|\n+", text):
            sent = " ".join(sent.split())
            if "!" in sent:
                continue
            hits = [w for w in sent.split() if any(guarded(n) for n in norm(w).split())]
            if hits and not any(w.isupper() for w in hits):
                out.append((stamp, sent))
    return out


def main_flips(args):
    since = ""
    if "--since" in args:
        i = args.index("--since")
        if i + 1 == len(args):
            args = []
        else:
            since, args = args[i + 1], args[:i] + args[i + 2:]
    p = Path(args[0]) if len(args) == 1 else None
    p = p / "roll.md" if p and p.is_dir() else p
    if not p or not p.is_file() or since and not re.fullmatch(STAMP, since):
        print("usage: curia-quotes --flips ROLL_OR_CURIA_DIR [--since STAMP]", file=sys.stderr)
        return 2
    for stamp, sent in flips(p, since):
        print(f"{stamp}: {sent}")
    return 0


def main(argv):
    if argv and argv[0] == "--flips":
        return main_flips(argv[1:])
    if not argv or argv[0] in ("-h", "--help"):
        print("usage: curia-quotes DIGEST_OR_CURIA_DIR ...", file=sys.stderr)
        return 2
    problems = []
    for a in argv:
        p = Path(a)
        p = p / "digest.md" if p.is_dir() else p
        if not p.is_file():
            print(f"curia-quotes: no such digest: {a}", file=sys.stderr)
            return 2
        problems += check(p.resolve())
    for line in problems:
        print(line)
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
