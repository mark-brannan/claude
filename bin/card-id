#!/bin/sh
# SOFT SHOULD: id generation belongs in lib/ids.py, the one home for every
# entity's id (card 17910884757abba648). This script still makes a work item's id itself;
# move it there when convenient, no deadline.
# card-id -- make a work item's identifier, and look one up.
#
# A work item's identifier is epoch seconds then the minting session's eight
# hex, no separator -- 1790836842077c62eb -- never edited, never reused. A
# work item's file is named by it, and its card line carries it as `id: <id>`.
#
#   card-id new [<session-id>]    print a fresh id (session from
#                                 $CLAUDE_CODE_SESSION_ID when not given)
#   card-id show <id>             the item: `<section>\t<group>\t<card>`
#   card-id roll-stamp [<epoch>]  print the curia roll's stamp for now (or for
#                                 <epoch> seconds), e.g. 20261002t054107z
#
# No ledger. Two sessions never share a hex; one session minting
# twice in the same second is the only collision, and `new` steps to the next
# second past any id already filed in the store or already handed out (a marker
# file per id, under $CARD_ID_CLAIMS, default a per-user dir in $TMPDIR), so
# back-to-back calls never match even before the item is filed.
set -u

self=$0
case $self in */*) ;; *) self=$(command -v "$self" 2>/dev/null || printf '%s' "$self") ;; esac
self_dir=$(cd "$(dirname "$self")" 2>/dev/null && pwd)
lib=""
for c in "$self_dir/../hooks/lib-state.sh" "$HOME/.claude/hooks/lib-state.sh"; do
  [ -f "$c" ] && { lib=$c; break; }
done
[ -n "$lib" ] || { printf 'card-id: lib-state.sh not found\n' >&2; exit 2; }
# shellcheck disable=SC1090
. "$lib"

die() { printf 'card-id: %s\n' "$*" >&2; exit 2; }

case "${1:-}" in
  new)
    sid=${2:-${CLAUDE_CODE_SESSION_ID:-}}
    hex=$(printf '%s' "$sid" | tr -d '-' | cut -c1-8 | tr 'A-F' 'a-f')
    case $hex in ????????) ;; *) die "no session id (pass one, or run inside a session)" ;; esac
    case $hex in *[!0-9a-f]*) die "session id $sid does not start with eight hex" ;; esac
    # Step past an item already in the store: the same second, same session
    # is the one collision left, so take the next second until the id is free.
    dir=$(items_dir)
    t=$(date -u +%s)
    # Two calls before the first item is filed: each id is also claimed by
    # creating a marker file (noclobber is atomic), so a second call in the
    # same second steps on. Markers older than a day are swept.
    claims=${CARD_ID_CLAIMS:-${TMPDIR:-/tmp}/card-id-claims-$(id -u)}
    mkdir -p "$claims" 2>/dev/null && find "$claims" -type f -mmin +1440 -delete 2>/dev/null
    while :; do
      if [ ! -e "$dir/$t$hex.md" ]; then
        if [ -d "$claims" ]; then
          ( set -C; : > "$claims/$t$hex" ) 2>/dev/null && break
        else break; fi
      fi
      t=$((t + 1))
    done
    printf '%s%s\n' "$t" "$hex" ;;
  show)
    is_card_id "${2:-}" || die "not a card id: ${2:-<id>}"
    board_card "$2" || { printf 'card-id: no item %s in %s\n' "$2" "$(items_dir)" >&2; exit 1; } ;;
  roll-stamp)
    epoch=${2:-$(date -u +%s)}
    case $epoch in ''|*[!0-9]*) die "not epoch seconds: $epoch" ;; esac
    ids_dir=$self_dir/../lib
    [ -f "$ids_dir/ids.py" ] || ids_dir=$HOME/.claude/lib
    python3 -c 'import datetime, sys; sys.path.insert(0, sys.argv[1]); import ids
print(ids.get_roll_stamp(datetime.datetime.fromtimestamp(int(sys.argv[2]), datetime.timezone.utc)))' "$ids_dir" "$epoch" ;;
  *) sed -n '11,15p' "$0" | sed 's/^#   //' >&2; exit 2 ;;
esac
