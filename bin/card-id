#!/bin/sh
# card-id -- make a work item's identifier, and look one up. The command line
# over lib/ids.py, the one home for every entity's id (card 17910884757abba648):
# this script formats no id of its own. SOFT SHOULD: the command itself is
# still shell; rewrite it in Python when convenient, no deadline.
#
# A work item's identifier is epoch seconds then the minting session's eight
# hex, no separator -- 1790836842077c62eb -- never edited, never reused. A
# work item's file is named by it, and its card line carries it as `id: <id>`.
#
#   card-id new [<session-id>]    print a fresh id (session from
#                                 $CLAUDE_CODE_SESSION_ID when not given)
#   card-id show <id>             the item: `<section>\t<group>\t<card>`
#   card-id roll-stamp [<epoch>]  print the curia roll's stamp for now (or for
#                                 <epoch> seconds), e.g. 20261002t054107z
#
# Two sessions never share a hex; one session asking twice in the same second
# is the only collision, and `new` never repeats: the id's seconds are the
# clock, or the next second past this session's last id (one counter per
# session under $CARD_ID_STATE, default ~/.local/state/card-id, advanced under
# a lock), stepped past any id already filed in the store. Without a usable
# counter dir, `new` says so on stderr and only steps past the store.
set -u

self=$0
case $self in */*) ;; *) self=$(command -v "$self" 2>/dev/null || printf '%s' "$self") ;; esac
self_dir=$(cd "$(dirname "$self")" 2>/dev/null && pwd)
lib=""
for c in "$self_dir/../hooks/lib-state.sh" "$HOME/.claude/hooks/lib-state.sh"; do
  [ -f "$c" ] && { lib=$c; break; }
done
[ -n "$lib" ] || { printf 'card-id: lib-state.sh not found\n' >&2; exit 2; }
# shellcheck disable=SC1090
. "$lib"
ids_dir=$self_dir/../lib
[ -f "$ids_dir/ids.py" ] || ids_dir=$HOME/.claude/lib

die() { printf 'card-id: %s\n' "$*" >&2; exit 2; }
# py <code> [arg...] -- run <code> with lib/ids.py imported as ids; the args
# follow the lib dir in sys.argv, so <code> reads them from sys.argv[2:].
py() {
  code=$1; shift
  python3 -c "import sys; sys.path.insert(0, sys.argv[1]); import ids
$code" "$ids_dir" "$@"
}

case "${1:-}" in
  new)
    sid=${2:-${CLAUDE_CODE_SESSION_ID:-}}
    py 'h = ids.session_hex(sys.argv[2])
if not h:
    print("card-id: no session id, or not one that starts with eight hex: %s (pass one, or run inside a session)" % (sys.argv[2] or "<empty>"), file=sys.stderr)
    sys.exit(2)
i, note = ids.new_item_id(h, int(sys.argv[3]), sys.argv[4], ids.card_id_state_dir())
if note:
    print("card-id:", note, file=sys.stderr)
print(i)' "$sid" "$(date -u +%s)" "$(items_dir)" ;;
  show)
    is_card_id "${2:-}" || die "not a card id: ${2:-<id>}"
    board_card "$2" || { printf 'card-id: no item %s in %s\n' "$2" "$(items_dir)" >&2; exit 1; } ;;
  roll-stamp)
    epoch=${2:-$(date -u +%s)}
    case $epoch in ''|*[!0-9]*) die "not epoch seconds: $epoch" ;; esac
    py 'import datetime
print(ids.get_roll_stamp(datetime.datetime.fromtimestamp(int(sys.argv[2]), datetime.timezone.utc)))' "$epoch" ;;
  *) sed -n '11,15p' "$0" | sed 's/^#   //' >&2; exit 2 ;;
esac
