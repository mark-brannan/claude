#!/usr/bin/env python3
# cwhat -- the cards and hand-offs, read by a human: what each one is for and
# which model and effort to run it with. Reads the state repo's files only:
# no tokens, no network, no writes.
#
#   cwhat                 the board: what needs you, the newest hand-offs,
#                         and how big Claude's queue is
#   cwhat <id>            one card or hand-off; a card's children too.
#                         <id> may be a card id or its first 6+ characters,
#                         a hand-off's file name, or a session's 8 hex
#   cwhat -s <word>...    the live cards and hand-offs matching every word;
#                         bare words that are not a subcommand search too
#   cwhat curia [<id>]    every curia, or one (a fuzzy id): its open questions
#                         and latest sitting
#   cwhat agora           the decisions waiting on you, ready then waiting,
#                         each with its agora brief; `docket` is the same
#   cwhat scoping         every scoping target: its proposal, its lock
#   cwhat tools           the ~/.claude/bin tools worth running yourself
#
#   -v, --verbose         the whole brief, every row
#   -a, --all             include done, closed and taken
#   --no-pager            print straight through (a pipe never pages)
#
# The file formats have one home each: a card is folded by work-item's own
# fold, a hand-off read by lib/state.py's pickup reader, a decision's
# readiness by lib/state.py's ruling_readiness, a scoping lock by scoping-lock.
import argparse
import importlib.machinery
import importlib.util
import os
import re
import shlex
import shutil
import subprocess
import sys
import textwrap
import time
from datetime import datetime, timezone
from pathlib import Path

sys.dont_write_bytecode = True
HERE = Path(os.path.realpath(__file__)).parent
sys.path[:0] = [os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "lib"),
                os.path.expanduser("~/.claude/lib")]  # lib/libpath.py
try:
    import state  # noqa: E402
    import when  # noqa: E402
except ImportError:
    sys.exit("cwhat: lib/state.py not found (looked beside the tool and in ~/.claude/lib)")


def _tool(name):
    path = HERE / name
    if not path.is_file():
        path = Path(os.path.expanduser(f"~/.claude/bin/{name}"))
    mod_name = name.replace("-", "_")
    loader = importlib.machinery.SourceFileLoader(mod_name, str(path))
    spec = importlib.util.spec_from_loader(mod_name, loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


WI = _tool("work-item")
os.environ["RULING_REF_CACHE_ONLY"] = "1"  # ready/waiting from the local cache only: no gh call

OWNER = {"agent": "Claude's queue", "human-ruling": "needs your decision",
         "human-click": "your click work"}
LIVE_CARD = set(WI.STATUSES) - {"done", "closed"}
TOOLS = [  # (command, what it answers, needs the network)
    ("worklist [project]", "the agents' board view; `worklist card <id>` for one card", True),
    ("pickup-list find <word>", "hand-offs matching a word, any status", False),
    ("work-item show <id>", "a card's raw file: brief and every log line", False),
    ("self-check", "is the live ~/.claude the one on main, and are the hooks firing", True),
    ("spend [--by repo|day|bot]", "what the sessions cost, by PR, repo, day or hour", False),
    ("metrics-db && metrics-dashboard", "build the metrics SQLite, then its HTML page", False),
    ("reply-length", "how long replies run and how long you take to answer", False),
    ("pr-blockers <owner/repo#n>", "what still stands between a PR and your turn", True),
    ("github-limits [dir] --offline", "a repo measured against GitHub's documented limits", False),
    ("prune-branches / prune-worktrees", "what is safe to delete; nothing goes without --delete", True),
]


class Out:
    def __init__(self):
        self.tty = sys.stdout.isatty()
        self.color = self.tty and not os.environ.get("NO_COLOR")
        self.width = min(shutil.get_terminal_size((100, 24)).columns, 110)
        self.lines = []

    def _sgr(self, code, s):
        return f"\033[{code}m{s}\033[0m" if self.color and s else s

    def bold(self, s):
        return self._sgr("1", s)

    def dim(self, s):
        return self._sgr("2", s)

    def say(self, s=""):
        self.lines.append(s)

    def wrap(self, s, lead="  ", rest=None, style=None, limit=None, more=None):
        """s wrapped after lead, later lines indented by rest (default: lead's
        width); at most limit lines, then "… N more lines: <more>" when more is given."""
        rest = " " * len(lead) if rest is None else rest
        lines = textwrap.wrap(s, self.width - max(len(lead), len(rest))) or [""]
        for i, ln in enumerate(lines[:limit]):
            self.say((rest if i else lead) + (style(ln) if style else ln))
        if more and limit and len(lines) > limit:
            self.say(self.dim(f"{rest}… {len(lines) - limit} more lines: {more}"))

    def flush(self, pager=True):
        text = "\n".join(self.lines) + "\n"
        rows = shutil.get_terminal_size((100, 24)).lines
        if pager and self.tty and len(self.lines) >= rows:
            cmd = os.environ.get("PAGER") or "less -FRX"
            try:
                subprocess.run(shlex.split(cmd), input=text, text=True)
                return
            except OSError:
                pass
        sys.stdout.write(text)


def ago(iso):
    try:
        t = when.parse(iso)
    except (ValueError, AttributeError):
        return "?"
    s = max(0, time.time() - (t if t.tzinfo else t.replace(tzinfo=timezone.utc)).timestamp())
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{int(s // n)}{unit}"
    return "now"


def dash(v):
    return v if v and v != "-" else "—"


def short_model(m):
    return state._mshort(m or "") or "—"


# -- the store ---------------------------------------------------------------

def gdir():
    return Path(state.state_dir())


def items_dir():
    return Path(state.items_dir())


def pickup_dir():
    return gdir() / "pickup"


def card(path, full=True):
    """A card's fold; full adds its brief, notes and PRs (another two reads)."""
    f = dict(WI.fold(path))
    f["kind"] = "card"
    f["path"] = path
    if full:
        add_brief(f)
    return f


def add_brief(f):
    path = f["path"]
    f["brief"] = WI.brief_text(path)
    notes, prs = [], []
    sec = ""
    for ln in path.read_text().splitlines():
        if ln.startswith("## "):
            sec = ln[3:].strip()
        elif sec == "Log":
            p = ln.find(" note=")
            if p >= 0:
                notes.append(ln[p + 6:])
            prs += re.findall(r"\b(?:pr|evidence)=(https?://\S+)", ln)
    f["notes"], f["prs"] = notes, list(dict.fromkeys(prs))


def pickup(path):
    # claims="": a hand-off's own status is the answer; the claims ledger costs a process per file
    rec = state.work_records([str(path)], claims="").rstrip("\n").split("\037")
    keys = ("_kind", "title", "status", "until", "claim", "model", "effort", "link", "id", "updated")
    f = dict(zip(keys, rec + [""] * (len(keys) - len(rec))))
    text = path.read_text(errors="replace")
    head, _, body = text.partition("\n---\n")
    hf = dict(re.findall(r"^([a-z_]+): ?(.*)$", head, re.M))
    f["kind"], f["path"], f["head"] = "hand-off", path, hf
    f["brief"] = " ".join(ln.strip() for ln in body.splitlines()
                          if ln.strip() and not re.match(r"(until|effort|link|model):", ln))
    f["repo"] = hf.get("branch", "").split(" ")[0]
    return f


def all_cards(full=True):
    return [card(p, full) for p in sorted(items_dir().glob("*.md"))]


def all_pickups():
    d = pickup_dir()
    return [pickup(p) for p in sorted(list(d.glob("*.md")) + list(d.glob("*/*.md")))]


def find_one(key):
    if state.is_card_id(key):
        p = items_dir() / f"{key}.md"
        return [p] if p.is_file() else []
    if re.fullmatch(r"[0-9]{6,17}[0-9a-f]*", key):
        hits = sorted(items_dir().glob(f"{key}*.md"))
        if hits:
            return hits
    d = pickup_dir()
    name = key[:-3] if key.endswith(".md") else key
    hits = sorted(d.glob(f"{name}.md")) + sorted(d.glob(f"*/{name}.md"))
    if not hits and re.fullmatch(r"[0-9a-f]{8}([0-9a-f-]{28})?", key):
        sid8 = key.replace("-", "")[:8]
        hits = sorted(d.glob(f"*-{sid8}.md")) + sorted(d.glob(f"*/*-{sid8}.md"))
    return hits


def live(f):
    if f["kind"] == "card":
        return f["status"] in LIVE_CARD
    return f["status"] == "open"


def keep(f, everything):
    return everything or live(f)


# -- views -------------------------------------------------------------------

def run_with(o, f):
    m, e = short_model(f.get("model")), dash(f.get("effort"))
    return o.bold(f"{m} · {e}") if m != "—" or e != "—" else o.dim("— (none recorded)")


def show_card(o, f, verbose):
    o.say(o.bold(f["title"]))
    where = dash(f["repo"]).rsplit("/", 1)[-1]
    held = f" by {f['holder']}" if f["holder"] else ""
    o.say(o.dim(f"card {f['id']} · {OWNER.get(f['owner'], f['owner'])} · "
                f"{f['status']}{held} · {where}"))
    o.say(f"run with: {run_with(o, f)}")
    if f["parent"] not in ("", "-"):
        pp = items_dir() / f"{f['parent']}.md"
        title = dict(WI.fold(pp))["title"] if pp.is_file() else "(not in the store)"
        o.say(f"part of:  {f['parent']}  {title}")
    o.say(o.dim(f"created {ago(f['created'])} ago · updated {ago(f['updated'])} ago"))
    for pr in f["prs"]:
        o.say(f"PR:       {pr}")
    o.say()
    o.say(o.bold("What it's for"))
    o.wrap(f["brief"] or "(no brief)", limit=None if verbose else 6, more=f"cwhat -v {f['id']}")
    if f["notes"]:
        o.say()
        o.say(o.bold("Latest note"))
        o.wrap(f["notes"][-1])
    kids = [card(p) for p in sorted(items_dir().glob("*.md"))
            if f"parent={f['id']}" in p.read_text()]
    kids = [k for k in kids if k["parent"] == f["id"]]
    if kids:
        o.say()
        o.say(o.bold(f"Children ({len(kids)})"))
        rows(o, kids, verbose=True)


def show_pickup(o, f, verbose):
    h = f["head"]
    o.say(o.bold(f["title"] or "(empty hand-off)"))
    o.say(o.dim(f"hand-off {f['id']} · {f['status']} · written by a "
                f"{h.get('model', '?')} session"))
    o.say(f"run with: {run_with(o, f)}")
    if f["link"]:
        o.say(f"link:     {f['link']}")
    if h.get("branch"):
        o.say(f"branch:   {h['branch']}")
    o.say(o.dim(f"updated {ago(f['updated'])} ago · session {h.get('session', '?')}"))
    rest = f["brief"][len(f["title"]):].strip() if f["brief"].startswith(f["title"]) else f["brief"]
    if rest:
        o.say()
        o.say(o.bold("The rest of the hand-off"))
        o.wrap(rest, limit=None if verbose else 8, more=f"cwhat -v {f['id']}")
    if h.get("prompt"):
        o.say()
        o.say(o.bold("Your last words in that session"))
        o.wrap(h["prompt"], style=o.dim)


def rows(o, items, verbose, cap=12):
    items = sorted(items, key=lambda f: f.get("updated", ""), reverse=True)
    shown = items if verbose else items[:cap]
    o.say(o.dim(f"  {'model':<7} {'effort':<7} {'status':<8} {'age':>4}  what"))
    for f in shown:
        lead = f"  {short_model(f.get('model')):<7} {dash(f.get('effort')):<7} {f['status']:<8} " \
               f"{ago(f.get('updated', '')):>4}  "
        o.wrap(f["title"] or "(untitled)", lead)
        repo = dash(f.get("repo")).rsplit("/", 1)[-1]
        o.say(" " * len(lead) + o.dim(f"{f['kind']} {f['id']} · {repo}"))
    if len(items) > len(shown):
        o.say(o.dim(f"  … {len(items) - len(shown)} more (-v for all)"))


def board(o, verbose, everything):
    cards = all_cards(full=False)
    o.say(o.bold("cwhat") + o.dim(f" · {datetime.now().strftime('%a %d %b %H:%M')} · local files only"))
    for owner in ("human-ruling", "human-click"):
        mine = [f for f in cards if f["owner"] == owner and keep(f, everything)]
        o.say()
        o.say(o.bold(f"{OWNER[owner].capitalize()} ({len(mine)})"))
        rows(o, mine, verbose, cap=8)
    hand = [f for f in all_pickups() if keep(f, everything)]
    o.say()
    o.say(o.bold(f"Hand-offs waiting ({len(hand)}), newest first"))
    rows(o, hand, verbose, cap=8)
    agent = [f for f in cards if f["owner"] == "agent" and keep(f, everything)]
    held = sum(1 for f in agent if f["status"] == "claimed")
    o.say()
    o.say(o.bold(f"Claude's queue: {len(agent)} cards") + f", {held} held by a session now")
    o.say(o.dim("  cwhat <word> searches it"))
    o.say()
    o.say(o.dim("ids: a card is 10 digits (when it was made, Unix seconds) + 8 hex, "
                "e.g. 1793905381fff197bb;"))
    o.say(o.dim("     a hand-off is <date>T<time>-<the session's first 8 hex>. "
                "cwhat <id> explains either."))


def search(o, words, verbose, everything):
    ws = [w.lower() for w in words]
    hits = [f for f in all_cards() + all_pickups()
            if keep(f, everything) and all(w in f"{f['title']} {f['brief']} {f['id']}".lower() for w in ws)]
    o.say(o.bold(f"{len(hits)} match{'es' if len(hits) != 1 else ''} for {' '.join(words)}")
          + ("" if everything else o.dim(" (live only; -a for all)")))
    if hits:
        rows(o, hits, verbose)
        if len(hits) == 1:
            o.say()
            (show_card if hits[0]["kind"] == "card" else show_pickup)(o, hits[0], verbose)


def tools(o):
    o.say(o.bold("Tools you can run yourself") + o.dim(" (all in ~/.claude/bin, on your PATH)"))
    o.say()
    for cmd, what, net in TOOLS:
        o.say("  " + o.bold(cmd) + (o.dim("  needs GitHub") if net else ""))
        o.wrap(what, "      ")
    o.say()
    o.say(o.dim("The rest of ~/.claude/bin is plumbing the agents and hooks call."))


# -- curiae, the agora, scoping ---------------------------------------------
# A curia's layout is the curia skill's "Where a curia lives"; a scoping
# target's, the scoping skill's §1, §2 and §6.

def curia_dirs():
    return sorted(d for d in (gdir() / "curia").glob("*/") if (d / "digest.md").is_file())


def stamp_line(path):
    """(session id, ISO time) from a LIVE or CLOSED file, or None."""
    try:
        text = path.read_text()
    except OSError:
        return None
    at = re.search(r"\d{4}-\d{2}-\d{2}T[\d:]+Z?", text)
    sid = re.search(r"\b[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}\b", text)
    return (sid.group(0) if sid else "?", at.group(0)) if at else None


def curia(d):
    text = (d / "digest.md").read_text(errors="replace")
    head = dict(re.findall(r"^- ([a-z]+): (.*)$", text.split("\n## ", 1)[0], re.M))
    title = next((ln[2:] for ln in text.splitlines() if ln.startswith("# ")), d.name)
    title = re.sub(r"^Curia:\s*", "", title)
    oq = re.search(r"^## Open questions\s*$(.*?)(?=^## |\Z)", text, re.M | re.S)
    questions = []
    for ln in re.sub(r"<!--.*?-->", "", oq.group(1) if oq else "", flags=re.S).splitlines():
        if re.match(r"(?:[-*]|\d+\.)\s+", ln):
            questions.append(ln.strip())
        elif questions and ln.startswith((" ", "\t")) and ln.strip():
            questions[-1] += " " + ln.strip()
    live, closed = stamp_line(d / "LIVE"), stamp_line(d / "CLOSED")
    opened = re.search(r"\d{4}-\d{2}-\d{2}", head.get("opened", ""))
    return {"id": d.name, "title": title, "status": head.get("status", "open").split()[0],
            "opened": opened.group(0) if opened else "?", "live": live, "closed": closed,
            "touched": max((x[1] for x in (live, closed) if x), default=""),
            "unclosed": bool(live and (not closed or closed[1] < live[1])),
            "questions": questions, "path": d}


def find_curia(key):
    ds = {d.name: d for d in curia_dirs()}
    if key in ds:
        return [ds[key]]
    hits = [d for n, d in ds.items() if n.startswith(key)] or [d for n, d in ds.items() if key in n]
    if not hits:
        import difflib
        hits = [ds[n] for n in difflib.get_close_matches(key, list(ds), n=3, cutoff=0.5)]
    return hits


def curia_list(o, verbose):
    cs = sorted((curia(d) for d in curia_dirs()), key=lambda c: c["touched"], reverse=True)
    o.say(o.bold(f"Curiae ({len(cs)})") + o.dim(" · newest-touched first · cwhat curia <id> for one"))
    o.say(o.dim(f"  {'status':<8} {'opened':<10} {'touched':>7}  id: question"))
    for c in cs:
        now = " · last sitting not closed" if c["unclosed"] else ""
        lead = f"  {c['status']:<8} {c['opened']:<10} {(ago(c['touched']) if c['touched'] else '—'):>7}  "
        line = f"{c['id']}: {c['title']}{now}"
        o.wrap(line, lead, limit=None if verbose else 2)


def curia_show(o, c, verbose):
    o.say(o.bold(c["id"]) + f"  {c['title']}")
    o.say(o.dim(f"status {c['status']} · opened {c['opened']} · {c['path']}"))
    if c["live"]:
        closed = " (not closed)" if c["unclosed"] else \
            (f", closed {c['closed'][1]} (closed)" if c["closed"] else " (closed)")
        o.say(f"latest sitting: {c['live'][1]}{closed} · session {c['live'][0][:8]}")
    else:
        o.say(o.dim("latest sitting: none recorded"))
    o.say()
    o.say(o.bold(f"Open questions ({len(c['questions'])})"))
    for q in c["questions"] if verbose else c["questions"][:10]:
        o.wrap(q if verbose else q[:300], "  ", "     ")
    if not verbose and len(c["questions"]) > 10:
        o.say(o.dim(f"  … {len(c['questions']) - 10} more: cwhat -v curia {c['id']}"))


def agora(o, verbose, everything):
    cards = [f for f in all_cards(full=False) if f["owner"] == "human-ruling" and keep(f, everything)]
    for f in cards:
        add_brief(f)
    briefs = gdir() / "agora" / "briefs"
    split = {"ready": [], "waiting": []}
    for f in cards:
        split[state.ruling_readiness(f"{f['title']} {f['brief']}".replace("\n", " "))].append(f)
    o.say(o.bold(f"The agora docket ({len(cards)})") + o.dim(" · as worklist splits it, from cached refs"))
    for k in ("ready", "waiting"):
        o.say()
        o.say(o.bold(f"{k.capitalize()} ({len(split[k])})"))
        for f in sorted(split[k], key=lambda f: f.get("updated", ""), reverse=True):
            o.wrap(f["title"] or "(untitled)", "  - ")
            b = briefs / f"{f['id']}.md"
            o.say("    " + o.dim(f"card {f['id']} · " + (f"brief {b}" if b.is_file() else "no agora brief")))


def scoping_targets():
    """(target, folder, its proposals, newest last) for every scoping lock folder and every
    curia with a scoping proposal or a lock."""
    out = [(d.name, d, sorted(d.glob("*-scoping-proposal*.md")))
           for d in sorted((gdir() / "scoping").glob("*/"))]
    for d in curia_dirs():
        props = sorted((d / "inputs").glob("*-scoping-proposal*.md"))
        if props or (d / "LOCK").is_file():
            out.append((f"curia {d.name}", d, props))
    return out


def scoping(o, verbose):
    sl = _tool("scoping-lock")
    rows_ = []
    for name, d, props in scoping_targets():
        last = props[-1] if props else None
        filed = bool(last and re.search(r"^## Filed\b", last.read_text(errors="replace"), re.M))
        lock = (d / "LOCK").read_text().strip() if (d / "LOCK").is_file() else ""
        lk = sl.describe(lock) if lock else None
        if not last:
            mark = "never started"
        elif not filed or (lk and lk[0] == "stale"):
            mark = "half-done"
        else:
            mark = ""
        rows_.append((last.name[:10] if last else "", name, "filed" if filed else ("proposed" if last else "—"),
                      lk, mark, len(props)))
    rows_.sort(key=lambda r: r[0], reverse=True)
    o.say(o.bold(f"Scoping targets ({len(rows_)})") + o.dim(" · newest proposal first"))
    o.say(o.dim(f"  {'proposal':<10} {'status':<9} {'lock':<18} target"))
    for date, name, st, lk, mark, n in rows_:
        lock = f"{lk[0]} {lk[1][:8]} {lk[4]}m" if lk else "—"
        extra = (f"  ({n} proposals)" if n > 1 and verbose else "") + (f"  {mark}" if mark else "")
        o.say(f"  {date or '—':<10} {st:<9} {lock:<18} {name}" + (o.bold(extra) if mark else o.dim(extra)))
    o.say()
    o.say(o.dim("filed: the proposal records what it filed. half-done: proposed and never filed, "
                "or a stale lock left behind."))


def show_many(o, items, show, rule=False):
    for i, x in enumerate(items):
        if i:
            o.say()
            if rule:
                o.say(o.dim("─" * min(o.width, 60)))
        show(x)


def main(argv):
    ap = argparse.ArgumentParser(prog="cwhat", add_help=True,
                                 description="Cards and hand-offs, read by a human.")
    ap.add_argument("words", nargs="*")
    ap.add_argument("-v", "--verbose", action="store_true")
    ap.add_argument("-a", "--all", action="store_true")
    ap.add_argument("--no-pager", action="store_true")
    ap.add_argument("-s", "--search", action="store_true", help="search for the words")
    a = ap.parse_args(argv)
    o = Out()
    w = a.words
    if a.search and w:
        search(o, w, a.verbose, a.all)
    elif not w:
        board(o, a.verbose, a.all)
    elif w == ["tools"]:
        tools(o)
    elif w == ["curia"]:
        curia_list(o, a.verbose)
    elif w[0] == "curia" and len(w) == 2:
        hits = find_curia(w[1])
        if not hits:
            o.say(f"no curia matches {w[1]}")
            curia_list(o, a.verbose)
        show_many(o, hits, lambda d: curia_show(o, curia(d), a.verbose))
    elif w in (["agora"], ["docket"]):
        agora(o, a.verbose, a.all)
    elif w == ["scoping"]:
        scoping(o, a.verbose)
    elif len(a.words) == 1 and (hits := find_one(a.words[0])):
        show_many(o, hits, lambda p: show_card(o, card(p), a.verbose) if p.parent == items_dir()
                  else show_pickup(o, pickup(p), a.verbose), rule=True)
    else:
        search(o, a.words, a.verbose, a.all)
    o.flush(pager=not a.no_pager)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(0)
    except WI.Exit as e:
        sys.exit(f"cwhat: {e}")
