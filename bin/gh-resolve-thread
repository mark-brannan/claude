#!/bin/sh
# gh-resolve-thread <threadId> [--reply BODY | --reply-only BODY]
#   one PR review thread, by node id:
#   (bare)              resolve it, only if its last comment is a signed agent reply
#   --reply BODY        post BODY on it and resolve it, in one GraphQL request
#   --reply-only BODY   post BODY on it and leave it open
#
# Exists so thread work can be allowlisted as `Bash(gh-resolve-thread:*)`.
# The alternative, a `gh api graphql:*` glob, would also approve deleteRef,
# closePullRequest and every other mutation GitHub exposes. The mutations are
# hard-coded; the id and body travel as GraphQL variables, never interpolated.
#
# Signed, as rules/code.md says: first line opens with "🤖 ", last line is
# "🤖 <model> · <effort> · <8 hex>". BODY must be. For the bare resolve, the
# thread's last comment must be signed and the caller's own: review bots sign
# their findings too, so a signature alone would close a thread nobody
# answered. One a bot posted on after the agent's reply stays open as well.
#
# The allowlist skips auto mode's judgment, which lets a session reply only on
# a PR it is working. So the reply modes post only when this checkout is that
# PR: its origin is the PR's repo and its branch the PR's head. Anywhere else
# they refuse and name the raw reply call, which auto mode then judges.
#
# A cloud session answers GraphQL with HTTP 403; the GitHub MCP server's
# review-thread tools work there, under auto mode's judgment, so the refusal
# points at them rather than at a REST fallback here.
#
# Exit: 0 on success; 1 on usage error, an unsigned body, an unanswered
# thread, a PR this checkout is not, a 403, or when GitHub does not report
# the result; gh's own status otherwise.
set -u

usage() {
  echo "usage: gh-resolve-thread <threadId> [--reply BODY | --reply-only BODY]   (one PRRT_... id, no loop)" >&2
  exit 1
}

signed() {  # $1 body, $2 what it is, for the message
  first=$(printf '%s\n' "$1" | head -n 1)
  last=$(printf '%s\n' "$1" | sed '/^[[:space:]]*$/d' | tail -n 1)
  case $first in
    '🤖 '*) ;;
    *) echo "gh-resolve-thread: $2 must open with '🤖 ' (rules/code.md, signed replies)" >&2; return 1 ;;
  esac
  printf '%s\n' "$last" | grep -Eq '^🤖 [^ ]+ · [^ ]+ · [0-9a-f]{8}$' || {
    echo "gh-resolve-thread: $2 must end with '🤖 <model> · <effort> · <8 hex>'" >&2; return 1; }
}

[ $# -eq 1 ] || [ $# -eq 3 ] || usage
id=$1
case $id in
  PRRT_*) ;;
  *) echo "gh-resolve-thread: '$id' is not a review-thread id (expected PRRT_...)" >&2; exit 1 ;;
esac
mode=resolve
if [ $# -eq 3 ]; then
  case $2 in
    --reply) mode=reply ;;
    --reply-only) mode=reply-only ;;
    *) usage ;;
  esac
  body=$3
  signed "$body" "the reply" || exit 1
fi

# One read for every mode: the PR's repo, head branch and number, the
# thread's first comment id (for the REST reply call), the caller, the last
# comment's author, each as type:login (a bot's login drops [bot] in
# GraphQL, and a user may hold that bare name), then its body.
err=$(mktemp) || exit 1
trap 'rm -f "$err"' EXIT
# shellcheck disable=SC2016  # $id and $body are GraphQL variables, resolved by GitHub
info=$(gh api graphql \
  -f query='query($id:ID!){viewer{login} node(id:$id){... on PullRequestReviewThread{pullRequest{number headRefName repository{nameWithOwner}} first:comments(first:1){nodes{databaseId}} last:comments(last:1){nodes{body author{login __typename}}}}}}' \
  -f id="$id" \
  --jq '.data as $d | $d.node | (.pullRequest.repository.nameWithOwner // ""), (.pullRequest.headRefName // ""), (.pullRequest.number // ""), (.first.nodes[0].databaseId // ""), ($d.viewer.login // "" | if endswith("[bot]") then "Bot:" + .[:-5] else "User:" + . end), ((.last.nodes[0].author // {}) | if .login then .__typename + ":" + .login else "" end), (.last.nodes[0].body // "")' \
  2>"$err")
rc=$?
if [ $rc -ne 0 ]; then
  if grep -q 'HTTP 403' "$err"; then
    echo "gh-resolve-thread: GitHub refused GraphQL (HTTP 403), as it does in a Claude Code cloud session; use the GitHub MCP server's review-thread reply and resolve tools there" >&2
    exit 1
  fi
  cat "$err" >&2; exit $rc
fi
repo=$(printf '%s\n' "$info" | sed -n 1p)
head=$(printf '%s\n' "$info" | sed -n 2p)
num=$(printf '%s\n' "$info" | sed -n 3p)
cid=$(printf '%s\n' "$info" | sed -n 4p)
me=$(printf '%s\n' "$info" | sed -n 5p)
lastauthor=$(printf '%s\n' "$info" | sed -n 6p)
lastbody=$(printf '%s\n' "$info" | sed '1,6d')
[ -n "$repo" ] || { echo "gh-resolve-thread: no review thread $id" >&2; exit 1; }

if [ "$mode" != resolve ]; then
  branch=$(git symbolic-ref --short -q HEAD)
  origin=$(git remote get-url origin 2>/dev/null)
  case $origin in
    *github.com[:/]"$repo"|*github.com[:/]"$repo".git) here=yes ;;
    *) here=no ;;
  esac
  if [ "$here" = no ] || [ "$branch" != "$head" ]; then
    echo "gh-resolve-thread: $id is on $repo#$num (branch $head), and this checkout is not; only a session working that PR replies there." >&2
    echo "  If this session works it, reply with: gh api -X POST repos/$repo/pulls/$num/comments/$cid/replies -f body=<signed reply>" >&2
    echo "  then resolve with: gh-resolve-thread $id" >&2
    exit 1
  fi
fi

# shellcheck disable=SC2016
case $mode in
  resolve)
    { [ -n "$me" ] && [ "$lastauthor" = "$me" ] && signed "$lastbody" "the thread's last comment"; } || {
      echo "gh-resolve-thread: $id has no signed reply of yours ($me) as its last comment; answer it with --reply BODY" >&2; exit 1; }
    out=$(gh api graphql \
      -f query='mutation($id:ID!){resolveReviewThread(input:{threadId:$id}){thread{isResolved}}}' \
      -f id="$id") || exit $? ;;
  reply)
    # GraphQL runs the two fields in order, so the reply can land and the
    # resolve fail; gh then exits non-zero with the reply's url in its output.
    out=$(gh api graphql \
      -f query='mutation($id:ID!,$body:String!){addPullRequestReviewThreadReply(input:{pullRequestReviewThreadId:$id,body:$body}){comment{url}} resolveReviewThread(input:{threadId:$id}){thread{isResolved}}}' \
      -f id="$id" -f body="$body")
    rc=$?
    if [ $rc -ne 0 ]; then
      case $out in
        *'"url":"'*) echo "gh-resolve-thread: reply posted on $id but not resolved; do not post it again, finish with: gh-resolve-thread $id" >&2; exit 1 ;;
        *) exit $rc ;;
      esac
    fi ;;
  reply-only)
    out=$(gh api graphql \
      -f query='mutation($id:ID!,$body:String!){addPullRequestReviewThreadReply(input:{pullRequestReviewThreadId:$id,body:$body}){comment{url}}}' \
      -f id="$id" -f body="$body") || exit $? ;;
esac

if [ "$mode" != resolve ]; then
  case $out in
    *'"url":"'*) ;;
    *) echo "gh-resolve-thread: reply on $id not posted:" >&2; printf '%s\n' "$out" >&2; exit 1 ;;
  esac
  [ "$mode" = reply-only ] && { echo "replied on $id"; exit 0; }
fi
case $out in
  *'"isResolved":true'*) echo "resolved $id"; exit 0 ;;
  *) echo "gh-resolve-thread: $id not resolved:" >&2; printf '%s\n' "$out" >&2; exit 1 ;;
esac
