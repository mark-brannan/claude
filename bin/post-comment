#!/usr/bin/env python3
# post-comment -- post a PR or issue comment whose body is a file, screened by
# the languette guards first, so one allow-list entry replaces the
# `gh pr|issue comment --body-file` calls that stop for a dialog or that the
# public-text guard refuses because it cannot read the file.
#
#   post-comment pr|issue <number> --body-file <path> [--repo owner/name]
#                [--marker <text>]
#
# The body file must lie in a scratchpad: ~/.local/state/claude-tmpdir/
# claude-<uid> or /tmp/claude-<uid> (each only when it is a real directory we
# own), or $RUNNER_TEMP in a GitHub Actions job. The path is resolved
# (symlinks followed) before that test, and refused in /proc, /dev, /sys or
# any .git, and when it is not a regular file. The roots come from the passwd
# entry, never $HOME, and there is no flag to add one. The body is UTF-8 and
# at most 65536 characters, GitHub's limit.
#
# Screening: the file is read once. A private copy of what was read goes to
# the languette plugin's own PreToolUse entry point (run.py) as the call
# `gh <kind> comment <n> [--repo R] --body-file <copy>`, with the plugin's
# options from pluginConfigs in ~/.claude/settings.json, so every guard that
# would judge that gh call judges this one (guard-private-terms, the secrets
# and signature guards). A deny, an ask or a rewrite of the call refuses the
# post with the guard's reason; no languette install, or a run.py that fails,
# refuses it too. The text posted is the text screened, sent on gh's stdin.
#
# --marker: edit in place. The newest comment on the PR or issue by the
# authenticated account whose body holds the marker is replaced; none, and a
# new comment is posted. The body must hold the marker, so the next edit finds
# it again.
#
# Exit: 0 posted (the comment's URL on stdout); 1 refused or gh failed,
# nothing posted; 2 bad arguments.
import argparse
import json
import os
import pwd
import re
import shlex
import stat
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True

LIMIT = 65536
TMP = "/tmp"
GH = "gh"
PLUGIN = "languette@languette"
DENIED_ROOTS = ("/proc", "/dev", "/sys")


def home():
    return os.path.realpath(pwd.getpwuid(os.getuid()).pw_dir)


def inside(path, root):
    return path == root or path.startswith(root.rstrip("/") + "/")


def own_dir(path):
    """path, resolved, if it is a real directory (not a symlink) we own."""
    try:
        st = os.lstat(path)
    except (OSError, ValueError):
        return None
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        return None
    return os.path.realpath(path)


def roots():
    uid = "claude-%d" % os.getuid()
    dirs = [os.path.join(home(), ".local", "state", "claude-tmpdir", uid), os.path.join(TMP, uid)]
    if os.environ.get("GITHUB_ACTIONS") == "true" and os.environ.get("RUNNER_TEMP"):
        dirs.append(os.environ["RUNNER_TEMP"])
    return [r for r in map(own_dir, dirs) if r]


def refusal(real):
    """Why the resolved path may not be a body file, or None."""
    if any(inside(real, d) for d in DENIED_ROOTS):
        return "is in /proc, /dev or /sys"
    if ".git" in real.casefold().split("/"):
        return "is in a .git"
    if not any(inside(real, r) for r in roots()):
        return "is outside the scratchpads (~/.local/state/claude-tmpdir/claude-<uid>, /tmp/claude-<uid>, $RUNNER_TEMP in CI)"
    return None


def read_body(path):
    """(text, real path) or raise ValueError with why."""
    real = os.path.realpath(path)
    why = refusal(real)
    if why:
        raise ValueError("%s %s" % (path, why))
    try:
        fd = os.open(real, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError as e:
        raise ValueError("%s cannot be read: %s" % (path, e.strerror or e))
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise ValueError("%s is not a regular file" % path)
        raw = f.read(LIMIT * 4 + 1)
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError:
        raise ValueError("%s is not UTF-8" % path)
    if len(text) > LIMIT:
        raise ValueError("%s is over GitHub's %d-character limit" % (path, LIMIT))
    if not text.strip():
        raise ValueError("%s is empty" % path)
    return text, real


def load_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def languette():
    """(plugin root, option env) of the installed languette, or raise ValueError."""
    claude = os.path.join(home(), ".claude")
    found = (load_json(os.path.join(claude, "plugins", "installed_plugins.json")) or {}).get("plugins", {})
    cwd = os.getcwd()

    def holds(p):
        return isinstance(p, str) and p and inside(cwd, p)
    entries = [i for i in found.get(PLUGIN) or [] if isinstance(i, dict)]
    scoped = [i for i in entries if i.get("scope") in ("project", "local") and holds(i.get("projectPath"))]
    rest = [i for i in entries if i.get("scope") not in ("project", "local")]
    pick = max(scoped, key=lambda i: len(i["projectPath"])) if scoped else (rest[0] if rest else None)
    root = pick.get("installPath") if pick else None
    if not isinstance(root, str) or not os.path.isfile(os.path.join(root, "languette", "run.py")):
        raise ValueError("the languette plugin is not installed here, so the body cannot be screened")
    settings = load_json(os.path.join(claude, "settings.json")) or {}
    opts = ((settings.get("pluginConfigs") or {}).get(PLUGIN) or {}).get("options") or {}
    env = {}
    for k, v in opts.items():
        if isinstance(k, str) and re.fullmatch(r"\w+", k) and v is not None:
            env["CLAUDE_PLUGIN_OPTION_" + k.upper()] = (
                "true" if v is True else "false" if v is False else v if isinstance(v, str) else json.dumps(v))
    return root, env


def screen(args, text, real):
    """None if the guards let the equivalent gh call through, else why not."""
    try:
        root, opt_env = languette()
    except ValueError as e:
        return str(e)
    try:
        fd, copy = tempfile.mkstemp(dir=os.path.dirname(real), prefix=".post-comment.", suffix=".md")
    except OSError as e:
        return "cannot write the copy the guards read beside %s: %s" % (real, e.strerror or e)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        cmd = [GH, args.kind, "comment", args.number]
        if args.repo:
            cmd += ["--repo", args.repo]
        if args.marker is not None:
            cmd.append("--edit-last")
        cmd += ["--body-file", copy]
        payload = {"hook_event_name": "PreToolUse", "tool_name": "Bash",
                   "tool_input": {"command": " ".join(shlex.quote(c) for c in cmd)},
                   "cwd": os.getcwd(),
                   "session_id": os.environ.get("CLAUDE_CODE_SESSION_ID") or "post-comment"}
        env = {k: v for k, v in os.environ.items() if not k.startswith("CLAUDE_PLUGIN_")}
        env.update(opt_env, CLAUDE_PLUGIN_ROOT=root)
        try:
            r = subprocess.run([sys.executable, "-I", os.path.join(root, "languette", "run.py")],
                               input=json.dumps(payload), capture_output=True, text=True, env=env, timeout=60)
        except (OSError, subprocess.TimeoutExpired) as e:
            return "the languette guards did not run (%s)" % e
    finally:
        os.unlink(copy)
    if r.returncode == 2:
        return r.stderr.strip() or "a languette guard blocked it"
    if r.returncode != 0:
        return "the languette guards failed (exit %d): %s" % (r.returncode, r.stderr.strip()[:500])
    if not r.stdout.strip():
        return None
    try:
        out = json.loads(r.stdout).get("hookSpecificOutput") or {}
    except (ValueError, AttributeError):
        return "the languette guards printed something that is not a decision"
    decision = out.get("permissionDecision")
    if decision in ("deny", "ask"):
        return out.get("permissionDecisionReason") or "a languette guard said %s" % decision
    if out.get("updatedInput") is not None:
        return "a languette guard would rewrite the call (a redaction), which a file body cannot take"
    return None


def gh(argv, stdin=None):
    return subprocess.run([GH] + argv, input=stdin, capture_output=True, text=True)


def repo_of(args):
    if args.repo:
        return args.repo
    r = gh(["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"])
    return r.stdout.strip() if r.returncode == 0 else None


def marked(repo, number, marker):
    """The id of the newest comment by the authenticated account holding marker, or
    None; raise ValueError when gh cannot say, so a failed lookup never posts twice."""
    me = gh(["api", "graphql", "-f", "query={viewer{login}}", "--jq", ".data.viewer.login"])
    login = me.stdout.strip()
    if me.returncode != 0 or not login:
        raise ValueError("cannot read the authenticated account: %s" % me.stderr.strip())
    r = gh(["api", "--paginate", "repos/%s/issues/%s/comments" % (repo, number),
            "--jq", ".[] | {id, login: .user.login, body} | @json"])
    if r.returncode != 0:
        raise ValueError("cannot list the comments: %s" % r.stderr.strip())
    hit = None
    for line in r.stdout.splitlines():
        try:
            c = json.loads(line)
        except ValueError:
            continue
        if c.get("login") in (login, login + "[bot]") and marker in (c.get("body") or ""):
            hit = c.get("id")
    return hit


def post(args, text):
    if args.marker is not None:
        repo = repo_of(args)
        if not repo:
            raise ValueError("cannot tell the repo; pass --repo")
        cid = marked(repo, args.number, args.marker)
        if cid:
            return gh(["api", "-X", "PATCH", "repos/%s/issues/comments/%s" % (repo, cid),
                       "--input", "-", "--jq", ".html_url"], json.dumps({"body": text}))
    cmd = [args.kind, "comment", args.number, "--body-file", "-"]
    if args.repo:
        cmd += ["--repo", args.repo]
    return gh(cmd, text)


def parse(argv):
    p = argparse.ArgumentParser(prog="post-comment", description="Post a screened PR or issue comment from a file.")
    p.add_argument("kind", choices=("pr", "issue"))
    p.add_argument("number")
    p.add_argument("--body-file", required=True)
    p.add_argument("--repo", "-R")
    p.add_argument("--marker")
    args = p.parse_args(argv)
    if not re.fullmatch(r"[1-9][0-9]{0,9}", args.number):
        p.error("number must be a PR or issue number")
    if args.repo is not None and not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", args.repo):
        p.error("--repo must be owner/name")
    if args.marker is not None and not args.marker.strip():
        p.error("--marker must not be empty")
    return args


def main(argv=None):
    args = parse(sys.argv[1:] if argv is None else argv)
    try:
        text, real = read_body(args.body_file)
    except ValueError as e:
        sys.stderr.write("post-comment: %s; nothing posted\n" % e)
        return 1
    if args.marker is not None and args.marker not in text:
        sys.stderr.write("post-comment: the body does not hold --marker, so a later edit could not find it; nothing posted\n")
        return 1
    why = screen(args, text, real)
    if why:
        sys.stderr.write("post-comment: refused; nothing posted\n%s\n" % why)
        return 1
    try:
        r = post(args, text)
    except ValueError as e:
        sys.stderr.write("post-comment: --marker: %s; nothing posted\n" % e)
        return 1
    if r.returncode != 0:
        sys.stderr.write("post-comment: gh failed (exit %d): %s\n" % (r.returncode, r.stderr.strip()))
        return 1
    sys.stdout.write(r.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
