{
  "enabledPlugins": {
    "discord@claude-plugins-official": false,
    "signalk-registry@sailingnaturali": false
  },
  "extraKnownMarketplaces": {
    "sailingnaturali": {
      "source": {
        "source": "github",
        "repo": "sailingnaturali/claude-skills"
      }
    }
  },
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "disableClaudeAiConnectors": true,
  "env": {
    "ENABLE_CLAUDEAI_MCP_SERVERS": "false"
  },
  "crossSessionInbound": "hold",
  "permissions": {
    "allow": [
      "Bash(git branch -d claude/*)",
      "Bash(git branch -D claude/*)",
      "mcp__Claude_Code_Remote__add_repo"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__Claude_Code_Remote__add_repo",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/guard-add-repo.sh\"; [ -f \"$h\" ] && bash \"$h\"; true"
          }
        ]
      },
      {
        "matcher": "mcp__.*__(send_later|create_trigger)",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/no-persistent-polling.sh\"; [ -f \"$h\" ] && bash \"$h\" || true"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/metrics-live.sh\"; [ -f \"$h\" ] && bash \"$h\" question 0 show 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/no-draft-pr.sh\"; [ -f \"$h\" ] && bash \"$h\" || true"
          }
        ]
      },
      {
        "matcher": "mcp__.*__subscribe_pr_activity",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/no-late-pr-subscribe.sh\"; [ -f \"$h\" ] && bash \"$h\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/metrics-live.sh\"; [ -f \"$h\" ] && bash \"$h\" stop 0 show 2>/dev/null || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/stop-continuity.sh\"; [ -f \"$h\" ] && bash \"$h\" 2>/dev/null || true",
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*__create_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/measure-git-events.sh\"; [ -f \"$h\" ] && bash \"$h\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/log-commit.sh\"; [ -f \"$h\" ] && bash \"$h\" 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/metrics-live.sh\"; [ -f \"$h\" ] && bash \"$h\" git 0 show 2>/dev/null || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/session-start-seed-refresh.sh\"; [ -f \"$h\" ] && bash \"$h\" || true",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/session-start-continuity.sh\"; [ -f \"$h\" ] && bash \"$h\" || true"
          },
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/connector-budget.sh\"; [ -f \"$h\" ] && bash \"$h\" || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$HOME/.claude/hooks/metrics-live.sh\"; [ -f \"$h\" ] && bash \"$h\" prompt 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "deniedMcpServers": [
    {
      "serverName": "Intuit_QuickBooks"
    },
    {
      "serverName": "Intuit_TurboTax"
    },
    {
      "serverName": "CourtListener"
    },
    {
      "serverName": "Courtroom5"
    },
    {
      "serverName": "Legal_Data_Hunter"
    },
    {
      "serverName": "LegalZoom"
    },
    {
      "serverName": "Gmail"
    },
    {
      "serverName": "Google_Drive"
    },
    {
      "serverName": "Google_Calendar"
    },
    {
      "serverName": "Evernote_MCP"
    },
    {
      "serverName": "Audible"
    },
    {
      "serverName": "Autodesk_Product_Help"
    },
    {
      "serverName": "DocuSeal"
    },
    {
      "serverName": "Docusign"
    },
    {
      "serverName": "Dropbox"
    },
    {
      "serverName": "Harvey"
    },
    {
      "serverName": "IFTTT"
    },
    {
      "serverName": "Lucid"
    },
    {
      "serverName": "Postman"
    },
    {
      "serverName": "PubMed"
    },
    {
      "serverName": "Scholar_Gateway"
    },
    {
      "serverName": "SignNow"
    },
    {
      "serverName": "Spotify"
    },
    {
      "serverName": "Superhuman_Docs"
    },
    {
      "serverName": "Taskrabbit_Booking_Assistance"
    },
    {
      "serverName": "Todoist"
    },
    {
      "serverName": "Trello"
    },
    {
      "serverName": "Zapier"
    }
  ],
  "statusLine": {
    "type": "command",
    "command": "h=\"$HOME/.claude/hooks/statusline-metrics.sh\"; [ -f \"$h\" ] && bash \"$h\" 2>/dev/null",
    "padding": 0
  }
}
